//> The phases of a GCD computation.
//>
//> `Idle` waits for a request; `Running(lhs, rhs)` holds the two numbers
//> still being reduced; `Done(result)` holds the finished answer.
union type GcdState {
    Idle()
    Running(lhs : Word[8], rhs : Word[8])
    Done(result : Word[8])
}

//> Computes the greatest common divisor of two 8-bit words,
//> one subtraction step per clock cycle.
pub mod Gcd {
    //> The clock.
    incoming clock : Clock

    //> Pulse high to request a GCD.
    //> Sampled whenever `ready` is high.
    incoming valid : Bit

    //> The first operand, sampled together with `valid`.
    incoming a : Word[8]

    //> The second operand, sampled together with `valid`.
    incoming b : Word[8]

    //> The phase of the computation.
    reg state : GcdState {
        initial it <= @Idle()
        it <= match it : GcdState {
            with @Idle() => mux(valid, @Running(a, b), it)
            with @Running(lhs, rhs) => if {
                when lhs == rhs => @Done(lhs)
                when lhs > rhs => @Running(lhs - rhs, rhs)
                else => @Running(lhs, rhs - lhs)
            }
            with @Done(_) => @Idle()
        }
    }

    //> High whenever a request would be accepted this cycle.
    outgoing ready : Bit {
        it := match state {
            with @Idle() => true
            with @Running(_, _) => false
            with @Done(_) => false
        }
    }

    //> The result, valid exactly when the computation has finished.
    outgoing out : Valid[Word[8]] {
        it := match state {
            with @Done(result) => @Valid(result)
            else => @Invalid()
        }
    }
}
