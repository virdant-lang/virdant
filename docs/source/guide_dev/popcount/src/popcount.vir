//! Population count: counting the number of set bits in a word.
//!
//! `Popcount4` splits a 4-bit word into two pairs, counts each pair
//! with `Popcount2`, and adds the two counts with the widening add.

//> Counts how many bits of a two-bit word are set, from 0 to 2.
//>
//> Turning each bit into a 1-bit word lets the widening add
//> do the counting for us.
mod Popcount2 {
    //> The two bits to count.
    incoming x : Word[2]

    //> How many bits of `x` are set.
    outgoing count : Word[2] dependson x {
        it := word(x[1]) +. word(x[0])
    }
}

//> Counts how many bits of `x` are set, from 0 to 4.
pub mod Popcount4 {
    //> The 4-bit word whose set bits are counted.
    incoming x : Word[4]

    // Count of the upper pair, bits 3 and 2.
    mod upper_pair of Popcount2 {
        it.x := word(x[3], x[2])
    }

    // Count of the lower pair, bits 1 and 0.
    mod lower_pair of Popcount2 {
        it.x := word(x[1], x[0])
    }

    //> How many bits of `x` are set.
    outgoing count : Word[3] dependson x {
        it := upper_pair.count +. lower_pair.count
    }
}
