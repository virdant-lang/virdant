socket Mem {
    outgoing addr : Word[16]
    incoming data : Word[8]
}

mod Core {
    forward socket mem of Mem
    // mem.addr := ...

    mem.addr := 0
    unused mem.data
}

mod Memory {
    reverse socket mem of Mem
    // mem.data := ...
    mem.data := 0
    unused mem.addr
}

pub mod Top {
    mod core of Core
    mod memsrv of Memory

    memsrv.mem :=: core.mem
}
