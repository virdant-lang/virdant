pub enum type AluOp {
    and = 1w3
    or  = 2
    xor = 3
    add = 4
    sub = 5
}

pub mod Alu {
    incoming a : Word[8]
    incoming b : Word[8]
    incoming op : AluOp
    outgoing r : Word[8] dependson a, b, op

    r := match op {
        with #and => a & b
        with #or  => a | b
        with #xor => a ^ b
        with #add => a + b
        with #sub => a - b
    }
}
