pub mod Mux3 {
    incoming a : Word[8] async
    incoming b : Word[8] async
    incoming c : Word[8] async

    incoming select_a : Bit async
    incoming select_b : Bit async
    incoming select_c : Bit async

    outgoing out : Word[8] async dependson a, b, c, select_a, select_b, select_c {
        if {
            when select_a {
                it := a
            }
            when select_b {
                it := b
            }
            when select_c {
                it := c
            }
            else {
                it := 0
            }
        }
    }
}
