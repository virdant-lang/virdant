# Start with a defined load_value so the time-0 snapshot has a
# decodable value (the sim random-initializes unwritten inputs).
poke load_value #Invalid()
poke shift_in false

# Load a nibble into the register.
poke load_value #Valid(13)
vcd trace.vcd
tick
poke load_value #Invalid()

# Now clock it out one bit at a time.
# Notice `shift_out` emits the nibble MSB-first: 1, 0, 1, 1 --
# no matter what wanders in through `shift_in` at the bottom.
poke shift_in false
tick

poke shift_in true
tick

poke shift_in false
tick

poke shift_in true
tick

tick

exit
