union type State {
    Idle()
    Running(x : Word[8], y : Word[8])
    Done(result : Word[8])
}

pub mod Gcd {
    incoming clock : Clock
    incoming reset : Bit
    incoming x : Word[8]
    incoming y : Word[8]
    incoming fire : Bit
    outgoing result : Valid[Word[8]]

    reg state : State

    if {
        when reset {
            state <= @Idle()
        }
        else match state {
            with @Idle() {
                state <= mux(fire, @Running(x, y), @Idle())
            }
            with @Running(x, y) if {
                when y == 0 {
                    state <= @Done(x)
                }
                when x == 0 {
                    state <= @Done(y)
                }
                when x < y {
                    state <= @Running(y - x, x)
                }
                else {
                    state <= @Running(x - y, y)
                }
            }
            with @Done(r) {
                state <= @Idle()
                result := @Valid(r)
            }
        }
    }
}
