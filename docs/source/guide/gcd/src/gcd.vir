union type GcdState {
    Idle()
    Running(x : Word[8], y : Word[8])
    Done(result : Word[8])
}

struct type GcdRequest {
    x : Word[8]
    y : Word[8]
}

pub mod Gcd {
    incoming clock : Clock

    server socket inp of Pipe[GcdRequest]
    client socket out of Pipe[Word[8]]

    reg state : GcdState {
        initial it <= @Idle()
    }

    match state {
        with @Idle() {
            match inp.data {
                with @Valid(request) {
                    state <= @Running(request->x, request->y)
                }
                with @Invalid() { }
            }
            inp.ready := true
            out.data := @Invalid()
        }
        with @Running(x, y) {
            if {
                when y == 0 {
                    state <= @Done(x)
                }
                when x == 0 {
                    state <= @Done(y)
                }
                when x < y {
                    state <= @Running(y - x, x)
                }
                else {
                    state <= @Running(x - y, y)
                }
            }
            inp.ready := false
            out.data := @Invalid()
        }
        with @Done(result) {
            if {
                when out.ready {
                    state <= @Idle()
                }
            }
            inp.ready := false
            out.data := @Valid(result)
        }
    }
}
