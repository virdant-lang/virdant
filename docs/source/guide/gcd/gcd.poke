vcd trace.vcd

// // Compute gcd(48, 18) = 6.
// // Pulse the request pipe for one cycle: the operands are loaded
// // and the state machine starts subtracting.
// poke inp.data @Valid(${x = 48w8, y = 18w8})
// tick
// poke inp.data @Invalid()
// tick 7

// Compute gcd(21, 14) = 7
// a new request reloads the operands straight from `Done`.
poke inp.data @Valid(${x = 21w8, y = 14w8})
tick
poke inp.data @Invalid()
tick 5

exit
