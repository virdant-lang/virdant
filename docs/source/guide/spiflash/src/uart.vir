union type UartState {
    Idle()
    Start()
    Data(data : Word[3])
    Stop()
}

pub mod UartSender {
    incoming clock : Clock

    reverse socket inp of Pipe[Word[8]] {
        it.ready := state == @Idle && baud_timer == 0
    }

    outgoing tx : Bit {
        it := match state {
            with @Idle() => true
            with @Start() => false
            with @Data(index) => buffer[dyn index]
            with @Stop() => true
        }
    }

    reg buffer : Word[8]

    reg state : UartState {
        initial it <= #Idle
    }

    wire baud_limit : Word[4] {
        it := 8
    }

    reg baud_timer : Word[4] {
        initial it <= 0

        it <= if {
            when it > 0 => it - 1
            else match state {
                with @Stop() => 0
                else => baud_limit
            }
        }
    }

    if {
        when baud_timer == 0 match state {
            with @Idle() {
                match inp.data {
                    with @Valid(data) {
                        buffer <= data
                        state  <= @Start()
                    }
                }
            }
            with @Start() {
                state  <= @Data(0)
            }
            with @Data(data) if {
                when data < 7 {
                    state  <= @Data(data + 1)
                }
                else {
                    state  <= @Stop()
                }
            }
            with @Stop() {
                state  <= @Idle()
            }
        }
    }
}

pub mod UartReceiver {
    incoming clock : Clock
    incoming rx    : Bit

    forward socket out of Pipe[Word[8]] {
        it.data := hold
    }

    reg buffer : Word[8]

    wire byte_done : Bit {
        it := state == @Stop && baud_timer == 0 && rx
    }

    reg hold : Valid[Word[8]] {
        initial it <= @Invalid()

        match it {
            with @Valid(dontcare) if {
                when out.ready if {
                    when byte_done {
                        it <= @Valid(buffer)
                    }
                    else {
                        it <= @Invalid()
                    }
                }
            }
            with @Invalid() if {
                when byte_done {
                    it <= @Valid(buffer)
                }
            }
        }
    }

    wire baud_limit : Word[4] {
        it := 8
    }

    wire half_period : Word[4] {
        it := 4
    }

    reg baud_timer : Word[4] {
        initial it <= 0

        it <= if {
            when it > 0 => it - 1
            else match state {
                with @Idle() if {
                    when rx => 0
                    else => half_period
                }
                with @Stop() => 0
                else => baud_limit
            }
        }
    }

    reg state : UartState {
        initial it <= #Idle
    }

    if {
        when baud_timer == 0 match state {
            with @Idle() if {
                when !rx {
                    state  <= @Start()
                }
            }
            with @Start() if {
                when rx {
                    state  <= @Idle()
                }
                else {
                    state  <= @Data(0)
                }
            }
            with @Data(index) {
                buffer <= word(rx, buffer[8..1])
                if {
                    when index < 7 {
                        state  <= @Data(index + 1)
                    }
                    else {
                        state  <= @Stop()
                    }
                }
            }
            with @Stop() {
                state  <= @Idle()
            }
        }
    }
}
