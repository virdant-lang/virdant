import spiflash
import uart
import virt

pub mod Top for virt::Virt {
    incoming clock : Clock

    outgoing spi_ck   : Bit
    outgoing spi_cs   : Bit
    outgoing spi_mosi : Bit
    incoming spi_miso : Bit

    outgoing tx : Bit

    mod flash of spiflash::SpiFlash {
        it.clock    := clock
        spi_ck      := it.spi.clock
        spi_cs      := it.spi.cs
        spi_mosi    := it.spi.mosi
        it.spi.miso := spi_miso
    }
    mod sender of uart::UartSender {
        it.clock    := clock
        it.inp      :=: flash.out
        tx          := it.tx
    }

    wire null_pending : Bit {
        it := match flash.out.data {
            with @Valid(byte) => byte == 0w8
            with @Invalid() => false
        }
    }

    outgoing exit : Valid[Word[8]] {
        it := if {
            when sender.inp.ready && null_pending => @Valid(0)
            else => @Invalid()
        }
    }
}
