top shifter::ShiftLeft
vcd trace.vcd

# Hold `value` at 1 the whole time and just vary `amount`.
# Amounts are written in binary, one stage per bit:
# the k-th bit "requests" a shift by 2^k.

poke value 0x01
poke amount 0b000
advance
assert result == 0x01

poke amount 0b001
advance
assert result == 0x02

poke amount 0b011
advance
assert result == 0x08

poke amount 0b101
advance
assert result == 0x20

poke amount 0b111
advance
assert result == 0x80

exit
