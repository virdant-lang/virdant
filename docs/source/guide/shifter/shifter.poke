poke direction #LeftLogical
poke value 0x01
poke amount 0x07
assert result == 0x80

poke value 0xab
poke amount 0x04
assert result == 0xb0

poke value 0xab
poke amount 0x00
assert result == 0xab

poke direction #RightLogical
poke value 0x80
poke amount 0x07
assert result == 0x01

poke value 0xab
poke amount 0x04
assert result == 0x0a

poke direction #RightArithmetic
poke value 0x80
poke amount 0x07
assert result == 0xff

poke value 0xab
poke amount 0x04
assert result == 0xfa

poke value 0x7f
poke amount 0x04
assert result == 0x07
