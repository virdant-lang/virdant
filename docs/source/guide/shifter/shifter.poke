poke direction #ShiftLeftLogical
poke value 0x00000001
poke amount 0x0000001f
assert result == 0x80000000

poke value 0x0000abcd
poke amount 0x00000008
assert result == 0x00abcd00

poke value 0xdeadbeef
poke amount 0x00000000
assert result == 0xdeadbeef

poke direction #ShiftRightLogical
poke value 0x80000000
poke amount 0x0000001f
assert result == 0x00000001

poke value 0xdeadbeef
poke amount 0x00000004
assert result == 0x0deadbee

poke direction #ShiftRightArithmetic
poke value 0x80000000
poke amount 0x0000001f
assert result == 0xffffffff

poke value 0xdeadbeef
poke amount 0x00000004
assert result == 0xfdeadbee

poke value 0x7fffffff
poke amount 0x00000004
assert result == 0x07ffffff
