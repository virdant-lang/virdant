pub enum type ShiftDirection {
    LeftLogical
    RightLogical
    RightArithmetic
}

pub mod Shifter {
    incoming direction : ShiftDirection
    incoming value     : Word[8]
    incoming amount    : Word[3]

    mod left of ShiftLeft {
        it.value  := value
        it.amount := amount
    }

    mod right of ShiftRightLogical {
        it.value  := value
        it.amount := amount
    }

    mod signed_right of ShiftRightArithmetic {
        it.value  := value
        it.amount := amount
    }

    outgoing result : Word[8]
        dependson direction, value, amount {
        it := match direction {
            with #LeftLogical => left.result
            with #RightLogical => right.result
            with #RightArithmetic => signed_right.result
        }
    }
}

mod ShiftLeft {
    incoming value  : Word[8]
    incoming amount : Word[3]

    wire left_2 : Word[8] {
        it := mux(amount[2], word(value[4..0], 0w4), value)
    }

    wire left_2_1 : Word[8] {
        it := mux(amount[1], word(left_2[6..0], 0w2), left_2)
    }

    wire left_2_1_0 : Word[8] {
        it := mux(amount[0], word(left_2_1[7..0], 0w1), left_2_1)
    }

    outgoing result : Word[8] dependson value, amount {
        it := left_2_1_0
    }
}

mod ShiftRightLogical {
    incoming value  : Word[8]
    incoming amount : Word[3]

    wire right_2 : Word[8] {
        it := mux(amount[2], zext(value[8..4]), value)
    }

    wire right_2_1 : Word[8] {
        it := mux(amount[1], zext(right_2[8..2]), right_2)
    }

    wire right_2_1_0 : Word[8] {
        it := mux(amount[0], zext(right_2_1[8..1]), right_2_1)
    }

    outgoing result : Word[8] dependson value, amount {
        it := right_2_1_0
    }
}

mod ShiftRightArithmetic {
    incoming value  : Word[8]
    incoming amount : Word[3]

    wire signed_right_2 : Word[8] {
        it := mux(amount[2], sext(value[8..4]), value)
    }

    wire signed_right_2_1 : Word[8] {
        it := mux(amount[1], sext(signed_right_2[8..2]), signed_right_2)
    }

    wire signed_right_2_1_0 : Word[8] {
        it := mux(amount[0], sext(signed_right_2_1[8..1]), signed_right_2_1)
    }

    outgoing result : Word[8] dependson value, amount {
        it := signed_right_2_1_0
    }
}
