pub mod Mux4 {
    incoming a : Word[8]
    incoming b : Word[8]
    incoming c : Word[8]
    incoming d : Word[8]

    incoming select : Word[2]

    outgoing out : Word[8] dependson a, b, c, d, select {
        it := match select {
            with 0 => a
            with 1 => b
            with 2 => c
            with 3 => d
        }
    }
}
