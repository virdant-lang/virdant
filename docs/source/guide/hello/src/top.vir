import virt

pub mod Top for virt::Virt {
    incoming clock : Clock

    @image_inline("Hello, world!\n\r\0")
    memory mem[64] : Word[8]

    reg index : Word[6] {
        initial it <= 0
        it <= it + 1
    }

    wire char : Word[8] {
        it := mem[dyn index]
    }

    outgoing debug : Valid[Word[8]] {
        it := @Valid(char)
    }

    outgoing exit : Valid[Word[8]] {
        it := if {
            when char == 0 => @Valid(0)
            else => @Invalid()
        }
    }
}
