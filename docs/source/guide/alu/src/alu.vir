import shifter

pub enum type Funct3 {
    Add     = 0b000w3
    Sll     = 0b001
    Slt     = 0b010
    Sltu    = 0b011
    Xor     = 0b100
    SrlSra  = 0b101
    Or      = 0b110
    And     = 0b111
}

pub mod Alu {
    incoming funct3    : Funct3
    incoming funct7    : Word[7]
    incoming operand_a : Word[32]
    incoming operand_b : Word[32]

    mod shifter of Shifter {
        it.direction := match funct3 {
            with #Sll => #ShiftLeftLogical
            with #SrlSra if {
                when funct7[5] => #ShiftRightArithmetic
                else => #ShiftRightLogical
            }
            else => dontcare
        }
        it.value  := operand_a
        it.amount := operand_b[5..0]
    }

    wire signs_differ : Bit {
        it := operand_a[31] ^ operand_b[31]
    }

    outgoing result : Word[32]
        dependson funct3, funct7, operand_a, operand_b {
        it := match funct3 {
            with #And => operand_a & operand_b
            with #Or => operand_a | operand_b
            with #Xor => operand_a ^ operand_b
            with #Add => if {
                when funct7[5] => operand_a - operand_b
                else => operand_a + operand_b
            }
            with #Slt if {
                when signs_differ => zext(operand_a[31])
                else => zext(operand_a < operand_b)
            }
            with #Sltu => zext(operand_a < operand_b)
            with #SrlSra => shifter.result
            with #Sll => shifter.result
        }
    }
}
