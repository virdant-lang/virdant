vcd trace.vcd

# Add: 12 + 5 = 17
poke funct3 #Add
poke funct7 0b0000000
poke operand_a 0x0c
poke operand_b 0x05
assert result == 0x11

advance 1

# Sll: 3 << 4 = 48
poke funct3 #Sll
poke funct7 0b0000000
poke operand_a 0x03
poke operand_b 0x04
assert result == 0x30

advance 1

# Slt (signed): 3 is less than 5
poke funct3 #Slt
poke operand_a 0x03
poke operand_b 0x05
assert result == 0x01

advance 1

# Slt (signed): 5 is not less than 3
poke operand_a 0x05
poke operand_b 0x03
assert result == 0x00

advance 1
