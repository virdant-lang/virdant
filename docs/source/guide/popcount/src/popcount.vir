pub mod PopCount2 {
    incoming x : Word[2]

    outgoing count : Word[2] dependson x {
        it := match x {
            with 0b00 => 0
            with 0b01 => 1
            with 0b10 => 1
            with 0b11 => 2
        }
    }
}

pub mod PopCount4 {
    incoming x : Word[4]

    mod lower of PopCount2 {
        it.x := x[2..0]
    }

    mod upper of PopCount2 {
        it.x := x[4.. 2]
    }

    outgoing count : Word[3] dependson x {
        it := lower.count +. upper.count
    }
}

pub mod PopCount8 {
    incoming x : Word[8]

    mod lower of PopCount4 {
        it.x := x[4..0]
    }

    mod upper of PopCount4 {
        it.x := x[8..4]
    }

    outgoing count : Word[4] dependson x {
        it := upper.count +. lower.count
    }
}
