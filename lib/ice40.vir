// SiliconBlue I/O cells.

//> The iCE40 I/O cell.
//> Set the pin's behaviour (registered, DDR, open-drain, pull-ups) through
//> the `PIN_TYPE` parameter, which Virdant cannot set yet.
//>
//> `PACKAGE_PIN` is the physical pad: drive it with the top-level incoming
//> port constrained to that pin, and sample it through `D_IN_0`/`D_IN_1`.
//> Mark the instance's `PACKAGE_PIN` `unused` to silence the write-only
//> warning.  Plain output pins need no `SB_IO`: drive an ordinary outgoing
//> port.
@cell("SB_IO")
ext mod SbIo {
    //> Physical pad connection.
    incoming PACKAGE_PIN       : Bit
    //> Latches the input register value when low (bypasses `INPUT_CLK`).
    incoming LATCH_INPUT_VALUE : Bit
    //> Clock enable shared by the input and output registers.
    incoming CLOCK_ENABLE      : Bit
    //> Clock for the input register.
    incoming INPUT_CLK         : Clock
    //> Clock for the output register.
    incoming OUTPUT_CLK        : Clock
    //> Tristate control for the pad driver (active high enables the driver).
    incoming OUTPUT_ENABLE     : Bit
    //> Output data (or DDR rising-edge data).
    incoming D_OUT_0           : Bit
    //> DDR falling-edge output data (unused in SDR modes).
    incoming D_OUT_1           : Bit
    //> Input data (or DDR rising-edge data).
    outgoing D_IN_0            : Bit
    //> DDR falling-edge input data (unused in SDR modes).
    outgoing D_IN_1            : Bit
}

//> The iCE40 I/O cell feeding a global network, for pads used as clocks.
//> `PACKAGE_PIN` is the physical pad: drive it with the top-level incoming
//> clock port constrained to that pin, and read the buffered clock from
//> `GLOBAL_BUFFER_OUTPUT`.
@cell("SB_GB_IO")
ext mod SbGbIo {
    //> Physical pad connection.
    incoming PACKAGE_PIN          : Bit
    //> Buffered clock distributed onto the global network.
    outgoing GLOBAL_BUFFER_OUTPUT : Clock
    //> Latches the input register value when low (bypasses `INPUT_CLK`).
    incoming LATCH_INPUT_VALUE    : Bit
    //> Clock enable shared by the input and output registers.
    incoming CLOCK_ENABLE         : Bit
    //> Clock for the input register.
    incoming INPUT_CLK            : Clock
    //> Clock for the output register.
    incoming OUTPUT_CLK           : Clock
    //> Tristate control for the pad driver (active high enables the driver).
    incoming OUTPUT_ENABLE        : Bit
    //> Output data (or DDR rising-edge data).
    incoming D_OUT_0              : Bit
    //> DDR falling-edge output data (unused in SDR modes).
    incoming D_OUT_1              : Bit
    //> Input data (or DDR rising-edge data).
    outgoing D_IN_0               : Bit
    //> DDR falling-edge input data (unused in SDR modes).
    outgoing D_IN_1               : Bit
}

//> Routes any signal onto one of the iCE40's global networks.
//> Most often used to distribute a clock.  Its ports are typed `Clock`, so
//> a plain `Bit` signal cannot be routed through it.
@cell("SB_GB")
ext mod SbGb {
    //> Signal to route onto the global network.
    incoming USER_SIGNAL_TO_GLOBAL_BUFFER : Clock
    //> Buffered signal distributed onto the global network.
    outgoing GLOBAL_BUFFER_OUTPUT         : Clock
}

// SiliconBlue memory cells.

//> The iCE40 4 Kbit block RAM.
//> True dual-port: the read and write ports have separate clocks.
//> Yosys infers `SB_RAM40_4K` from ordinary memories; instantiate this only
//> when you need a block RAM you can name directly.
@cell("SB_RAM40_4K")
ext mod SbRam40_4k {
    //> Read data.
    outgoing RDATA : Word[16]
    //> Read port clock.
    incoming RCLK  : Clock
    //> Read port clock enable.
    incoming RCLKE : Bit
    //> Read enable.
    incoming RE    : Bit
    //> Read address.
    incoming RADDR : Word[11]
    //> Write port clock.
    incoming WCLK  : Clock
    //> Write port clock enable.
    incoming WCLKE : Bit
    //> Write enable.
    incoming WE    : Bit
    //> Write address.
    incoming WADDR : Word[11]
    //> Per-bit write mask (set bits are masked out of the write).
    incoming MASK  : Word[16]
    //> Write data.
    incoming WDATA : Word[16]
}

//> The iCE40 4 Kbit block RAM with an inverted (falling-edge) read clock.
@cell("SB_RAM40_4KNR")
ext mod SbRam40_4knr {
    //> Read data.
    outgoing RDATA  : Word[16]
    //> Read port clock (inverted; samples on the falling edge).
    incoming RCLKN  : Clock
    //> Read port clock enable.
    incoming RCLKE  : Bit
    //> Read enable.
    incoming RE     : Bit
    //> Read address.
    incoming RADDR  : Word[11]
    //> Write port clock.
    incoming WCLK   : Clock
    //> Write port clock enable.
    incoming WCLKE  : Bit
    //> Write enable.
    incoming WE     : Bit
    //> Write address.
    incoming WADDR  : Word[11]
    //> Per-bit write mask (set bits are masked out of the write).
    incoming MASK   : Word[16]
    //> Write data.
    incoming WDATA  : Word[16]
}

//> The iCE40 4 Kbit block RAM with an inverted (falling-edge) write clock.
@cell("SB_RAM40_4KNW")
ext mod SbRam40_4knw {
    //> Read data.
    outgoing RDATA  : Word[16]
    //> Read port clock.
    incoming RCLK   : Clock
    //> Read port clock enable.
    incoming RCLKE  : Bit
    //> Read enable.
    incoming RE     : Bit
    //> Read address.
    incoming RADDR  : Word[11]
    //> Write port clock (inverted; samples on the falling edge).
    incoming WCLKN  : Clock
    //> Write port clock enable.
    incoming WCLKE  : Bit
    //> Write enable.
    incoming WE     : Bit
    //> Write address.
    incoming WADDR  : Word[11]
    //> Per-bit write mask (set bits are masked out of the write).
    incoming MASK   : Word[16]
    //> Write data.
    incoming WDATA  : Word[16]
}

//> The iCE40 4 Kbit block RAM with inverted (falling-edge) clocks on
//> both ports.
@cell("SB_RAM40_4KNRNW")
ext mod SbRam40_4knrnw {
    //> Read data.
    outgoing RDATA  : Word[16]
    //> Read port clock (inverted; samples on the falling edge).
    incoming RCLKN  : Clock
    //> Read port clock enable.
    incoming RCLKE  : Bit
    //> Read enable.
    incoming RE     : Bit
    //> Read address.
    incoming RADDR  : Word[11]
    //> Write port clock (inverted; samples on the falling edge).
    incoming WCLKN  : Clock
    //> Write port clock enable.
    incoming WCLKE  : Bit
    //> Write enable.
    incoming WE     : Bit
    //> Write address.
    incoming WADDR  : Word[11]
    //> Per-bit write mask (set bits are masked out of the write).
    incoming MASK   : Word[16]
    //> Write data.
    incoming WDATA  : Word[16]
}

//> The iCE40 UltraPlus 256 Kbit single-port RAM.
//> Hold `STANDBY`, `SLEEP`, and `POWEROFF` low for normal operation.
@cell("SB_SPRAM256KA")
ext mod SbSpram256ka {
    //> Memory address.
    incoming ADDRESS     : Word[14]
    //> Write data.
    incoming DATAIN      : Word[16]
    //> Per-nibble write enable mask.
    incoming MASKWREN    : Word[4]
    //> Write enable.
    incoming WREN        : Bit
    //> Chip select; must be high to read or write.
    incoming CHIPSELECT  : Bit
    //> Memory clock.
    incoming CLOCK       : Clock
    //> Standby mode control; hold low for normal operation.
    incoming STANDBY     : Bit
    //> Sleep mode control; hold low for normal operation.
    incoming SLEEP       : Bit
    //> Power-off control; hold low for normal operation.
    incoming POWEROFF    : Bit
    //> Read data.
    outgoing DATAOUT     : Word[16]
}

// SiliconBlue PLL cells.

//> The iCE40 PLL, taking its reference clock from a design signal.
//> Configure the output frequency through the `DIVR`, `DIVF`, `DIVQ`, and
//> related parameters, which Virdant cannot set yet.
//> Tie `SDI` and `SCLK` low to leave the dynamic reconfiguration interface
//> idle, and drive `BYPASS` low and `RESETB` high for normal operation.
@cell("SB_PLL40_CORE")
ext mod SbPll40Core {
    //> Reference clock input from design logic.
    incoming REFERENCECLK    : Clock
    //> PLL output routed to fabric (core) resources.
    outgoing PLLOUTCORE      : Clock
    //> PLL output routed onto the global network.
    outgoing PLLOUTGLOBAL    : Clock
    //> External feedback input, used when the feedback path is routed
    //> off-chip.
    incoming EXTFEEDBACK     : Bit
    //> Dynamic delay adjustment for the output clock.
    incoming DYNAMICDELAY    : Word[8]
    //> High when the PLL has achieved lock.
    outgoing LOCK            : Bit
    //> Bypasses the PLL, passing the reference clock straight through.
    incoming BYPASS          : Bit
    //> Active-low reset; hold high for normal operation.
    incoming RESETB          : Bit
    //> Latches the dynamic reconfiguration inputs.
    incoming LATCHINPUTVALUE : Bit
    //> Dynamic reconfiguration serial data out.
    outgoing SDO             : Bit
    //> Dynamic reconfiguration serial data in.
    incoming SDI             : Bit
    //> Dynamic reconfiguration serial clock.
    incoming SCLK            : Bit
}

//> The iCE40 PLL, taking its reference clock directly from a package pin.
//> Drive `PACKAGEPIN` with the `Clock` port constrained to that pin.
//> Configure the output frequency through the `DIVR`, `DIVF`, `DIVQ`, and
//> related parameters, which Virdant cannot set yet.
//> Tie `SDI` and `SCLK` low to leave the dynamic reconfiguration interface
//> idle, and drive `BYPASS` low and `RESETB` high for normal operation.
@cell("SB_PLL40_PAD")
ext mod SbPll40Pad {
    //> Reference clock input from a package pin.
    incoming PACKAGEPIN      : Clock
    //> PLL output routed to fabric (core) resources.
    outgoing PLLOUTCORE      : Clock
    //> PLL output routed onto the global network.
    outgoing PLLOUTGLOBAL    : Clock
    //> External feedback input, used when the feedback path is routed
    //> off-chip.
    incoming EXTFEEDBACK     : Bit
    //> Dynamic delay adjustment for the output clock.
    incoming DYNAMICDELAY    : Word[8]
    //> High when the PLL has achieved lock.
    outgoing LOCK            : Bit
    //> Bypasses the PLL, passing the reference clock straight through.
    incoming BYPASS          : Bit
    //> Active-low reset; hold high for normal operation.
    incoming RESETB          : Bit
    //> Latches the dynamic reconfiguration inputs.
    incoming LATCHINPUTVALUE : Bit
    //> Dynamic reconfiguration serial data out.
    outgoing SDO             : Bit
    //> Dynamic reconfiguration serial data in.
    incoming SDI             : Bit
    //> Dynamic reconfiguration serial clock.
    incoming SCLK            : Bit
}

//> The iCE40 dual-output PLL, taking its reference clock from a package pin.
//> Configure the output frequencies through the `DIVR`, `DIVF`, `DIVQ`, and
//> related parameters, which Virdant cannot set yet.
//> Tie `SDI` and `SCLK` low to leave the dynamic reconfiguration interface
//> idle, and drive `BYPASS` low and `RESETB` high for normal operation.
@cell("SB_PLL40_2_PAD")
ext mod SbPll40_2Pad {
    //> Reference clock input from a package pin.
    incoming PACKAGEPIN      : Clock
    //> First PLL output routed to fabric (core) resources.
    outgoing PLLOUTCOREA     : Clock
    //> First PLL output routed onto the global network.
    outgoing PLLOUTGLOBALA   : Clock
    //> Second PLL output routed to fabric (core) resources.
    outgoing PLLOUTCOREB     : Clock
    //> Second PLL output routed onto the global network.
    outgoing PLLOUTGLOBALB   : Clock
    //> External feedback input, used when the feedback path is routed
    //> off-chip.
    incoming EXTFEEDBACK     : Bit
    //> Dynamic delay adjustment for the output clock.
    incoming DYNAMICDELAY    : Word[8]
    //> High when the PLL has achieved lock.
    outgoing LOCK            : Bit
    //> Bypasses the PLL, passing the reference clock straight through.
    incoming BYPASS          : Bit
    //> Active-low reset; hold high for normal operation.
    incoming RESETB          : Bit
    //> Latches the dynamic reconfiguration inputs.
    incoming LATCHINPUTVALUE : Bit
    //> Dynamic reconfiguration serial data out.
    outgoing SDO             : Bit
    //> Dynamic reconfiguration serial data in.
    incoming SDI             : Bit
    //> Dynamic reconfiguration serial clock.
    incoming SCLK            : Bit
}

//> The iCE40 dual-output PLL, taking its reference clock from a design
//> signal.  Configure the output frequencies through the `DIVR`, `DIVF`,
//> `DIVQ`, and related parameters, which Virdant cannot set yet.
//> Tie `SDI` and `SCLK` low to leave the dynamic reconfiguration interface
//> idle, and drive `BYPASS` low and `RESETB` high for normal operation.
@cell("SB_PLL40_2F_CORE")
ext mod SbPll40_2fCore {
    //> Reference clock input from design logic.
    incoming REFERENCECLK    : Clock
    //> First PLL output routed to fabric (core) resources.
    outgoing PLLOUTCOREA     : Clock
    //> First PLL output routed onto the global network.
    outgoing PLLOUTGLOBALA   : Clock
    //> Second PLL output routed to fabric (core) resources.
    outgoing PLLOUTCOREB     : Clock
    //> Second PLL output routed onto the global network.
    outgoing PLLOUTGLOBALB   : Clock
    //> External feedback input, used when the feedback path is routed
    //> off-chip.
    incoming EXTFEEDBACK     : Bit
    //> Dynamic delay adjustment for the output clock.
    incoming DYNAMICDELAY    : Word[8]
    //> High when the PLL has achieved lock.
    outgoing LOCK            : Bit
    //> Bypasses the PLL, passing the reference clock straight through.
    incoming BYPASS          : Bit
    //> Active-low reset; hold high for normal operation.
    incoming RESETB          : Bit
    //> Latches the dynamic reconfiguration inputs.
    incoming LATCHINPUTVALUE : Bit
    //> Dynamic reconfiguration serial data out.
    outgoing SDO             : Bit
    //> Dynamic reconfiguration serial data in.
    incoming SDI             : Bit
    //> Dynamic reconfiguration serial clock.
    incoming SCLK            : Bit
}

//> The iCE40 dual-output PLL with a feedback path and a reference clock
//> from a package pin.  Configure the output frequencies through the
//> `DIVR`, `DIVF`, `DIVQ`, and related parameters, which Virdant cannot
//> set yet.
//> Tie `SDI` and `SCLK` low to leave the dynamic reconfiguration interface
//> idle, and drive `BYPASS` low and `RESETB` high for normal operation.
@cell("SB_PLL40_2F_PAD")
ext mod SbPll40_2fPad {
    //> Reference clock input from a package pin.
    incoming PACKAGEPIN      : Clock
    //> First PLL output routed to fabric (core) resources.
    outgoing PLLOUTCOREA     : Clock
    //> First PLL output routed onto the global network.
    outgoing PLLOUTGLOBALA   : Clock
    //> Second PLL output routed to fabric (core) resources.
    outgoing PLLOUTCOREB     : Clock
    //> Second PLL output routed onto the global network.
    outgoing PLLOUTGLOBALB   : Clock
    //> External feedback input, routed back from one of the PLL outputs for
    //> feedback-divider configurations.
    incoming EXTFEEDBACK     : Bit
    //> Dynamic delay adjustment for the output clock.
    incoming DYNAMICDELAY    : Word[8]
    //> High when the PLL has achieved lock.
    outgoing LOCK            : Bit
    //> Bypasses the PLL, passing the reference clock straight through.
    incoming BYPASS          : Bit
    //> Active-low reset; hold high for normal operation.
    incoming RESETB          : Bit
    //> Latches the dynamic reconfiguration inputs.
    incoming LATCHINPUTVALUE : Bit
    //> Dynamic reconfiguration serial data out.
    outgoing SDO             : Bit
    //> Dynamic reconfiguration serial data in.
    incoming SDI             : Bit
    //> Dynamic reconfiguration serial clock.
    incoming SCLK            : Bit
}

// SiliconBlue oscillator cells (UltraPlus only).

//> The iCE40 UltraPlus high-frequency (10-146 MHz) ring oscillator.
@cell("SB_HFOSC")
ext mod SbHfosc {
    //> Frequency trim input bit 0 (fixed trim value; typically unused).
    incoming TRIM0   : Bit
    //> Frequency trim input bit 1 (fixed trim value; typically unused).
    incoming TRIM1   : Bit
    //> Frequency trim input bit 2 (fixed trim value; typically unused).
    incoming TRIM2   : Bit
    //> Frequency trim input bit 3 (fixed trim value; typically unused).
    incoming TRIM3   : Bit
    //> Frequency trim input bit 4 (fixed trim value; typically unused).
    incoming TRIM4   : Bit
    //> Frequency trim input bit 5 (fixed trim value; typically unused).
    incoming TRIM5   : Bit
    //> Frequency trim input bit 6 (fixed trim value; typically unused).
    incoming TRIM6   : Bit
    //> Frequency trim input bit 7 (fixed trim value; typically unused).
    incoming TRIM7   : Bit
    //> Frequency trim input bit 8 (fixed trim value; typically unused).
    incoming TRIM8   : Bit
    //> Frequency trim input bit 9 (fixed trim value; typically unused).
    incoming TRIM9   : Bit
    //> Power-up enable for the oscillator.
    incoming CLKHFPU : Bit
    //> Output enable for the oscillator clock.
    incoming CLKHFEN : Bit
    //> Oscillator output clock (10-146 MHz).
    outgoing CLKHF   : Clock
}

//> The iCE40 UltraPlus low-frequency (about 10 kHz) ring oscillator.
@cell("SB_LFOSC")
ext mod SbLfosc {
    //> Power-up enable for the oscillator.
    incoming CLKLFPU : Bit
    //> Output enable for the oscillator clock.
    incoming CLKLFEN : Bit
    //> Oscillator output clock (about 10 kHz).
    outgoing CLKLF   : Clock
}

// SiliconBlue LED driver cells.

//> Constant-current RGB LED driver with three PWM inputs.
//> Set the per-channel currents through the `RGB*_CURRENT` parameters,
//> which Virdant cannot set yet.
@cell("SB_RGBA_DRV")
ext mod SbRgbaDrv {
    //> Enables the constant-current source.
    incoming CURREN   : Bit
    //> Enables the RGB LED driver outputs.
    incoming RGBLEDEN : Bit
    //> PWM input for channel 0.
    incoming RGB0PWM  : Bit
    //> PWM input for channel 1.
    incoming RGB1PWM  : Bit
    //> PWM input for channel 2.
    incoming RGB2PWM  : Bit
    //> Channel 0 driver output.
    outgoing RGB0     : Bit
    //> Channel 1 driver output.
    outgoing RGB1     : Bit
    //> Channel 2 driver output.
    outgoing RGB2     : Bit
}

//> Configurable RGB LED driver with an internal current source.
//> Set the per-channel currents through the `RGB*_CURRENT` parameters,
//> which Virdant cannot set yet.
@cell("SB_RGB_DRV")
ext mod SbRgbDrv {
    //> Enables the RGB LED driver outputs.
    incoming RGBLEDEN : Bit
    //> PWM input for channel 0.
    incoming RGB0PWM  : Bit
    //> PWM input for channel 1.
    incoming RGB1PWM  : Bit
    //> PWM input for channel 2.
    incoming RGB2PWM  : Bit
    //> Power-up enable for the internal current source.
    incoming RGBPU    : Bit
    //> Channel 0 driver output.
    outgoing RGB0     : Bit
    //> Channel 1 driver output.
    outgoing RGB1     : Bit
    //> Channel 2 driver output.
    outgoing RGB2     : Bit
}

//> Constant-current driver for a single external LED.
@cell("SB_LED_DRV_CUR")
ext mod SbLedDrvCur {
    //> Enables the constant-current driver.
    incoming EN    : Bit
    //> Current-source output driving the external LED.
    outgoing LEDPU : Bit
}

//> The iCE40 UltraPlus LED driver interface, a register file controlling
//> the three hard PWM channels.  `LEDDCLK` is its interface clock.
@cell("SB_LEDDA_IP")
ext mod SbLeddaIp {
    //> Chip select for the register-file interface.
    incoming LEDDCS    : Bit
    //> Register-file interface clock.
    incoming LEDDCLK   : Clock
    //> Register-file write data bit 7.
    incoming LEDDDAT7  : Bit
    //> Register-file write data bit 6.
    incoming LEDDDAT6  : Bit
    //> Register-file write data bit 5.
    incoming LEDDDAT5  : Bit
    //> Register-file write data bit 4.
    incoming LEDDDAT4  : Bit
    //> Register-file write data bit 3.
    incoming LEDDDAT3  : Bit
    //> Register-file write data bit 2.
    incoming LEDDDAT2  : Bit
    //> Register-file write data bit 1.
    incoming LEDDDAT1  : Bit
    //> Register-file write data bit 0.
    incoming LEDDDAT0  : Bit
    //> Register-file address bit 3.
    incoming LEDDADDR3 : Bit
    //> Register-file address bit 2.
    incoming LEDDADDR2 : Bit
    //> Register-file address bit 1.
    incoming LEDDADDR1 : Bit
    //> Register-file address bit 0.
    incoming LEDDADDR0 : Bit
    //> Data enable for the register-file interface.
    incoming LEDDDEN   : Bit
    //> Execute strobe for the register-file interface.
    incoming LEDDEXE   : Bit
    //> Resets the LED driver.
    incoming LEDDRST   : Bit
    //> Hard PWM output for channel 0.
    outgoing PWMOUT0   : Bit
    //> Hard PWM output for channel 1.
    outgoing PWMOUT1   : Bit
    //> Hard PWM output for channel 2.
    outgoing PWMOUT2   : Bit
    //> High while the LED driver is active.
    outgoing LEDDON    : Bit
}

// SiliconBlue hardened I2C and SPI cells (UltraPlus only).

//> The iCE40 UltraPlus hardened I2C master and slave.
//> The register-file interface is bit-serial: `SBADRI7`..`SBADRI0` carry
//> the address, `SBDATI7`..`SBDATI0` the write data, and `SBDATO7`..
//> `SBDATO0` the read data.
@cell("SB_I2C")
ext mod SbI2c {
    //> Register-file bus clock.
    incoming SBCLKI  : Clock
    //> Register-file bus read/write select (high = read).
    incoming SBRWI   : Bit
    //> Register-file bus strobe.
    incoming SBSTBI  : Bit
    //> Register-file address bit 7.
    incoming SBADRI7 : Bit
    //> Register-file address bit 6.
    incoming SBADRI6 : Bit
    //> Register-file address bit 5.
    incoming SBADRI5 : Bit
    //> Register-file address bit 4.
    incoming SBADRI4 : Bit
    //> Register-file address bit 3.
    incoming SBADRI3 : Bit
    //> Register-file address bit 2.
    incoming SBADRI2 : Bit
    //> Register-file address bit 1.
    incoming SBADRI1 : Bit
    //> Register-file address bit 0.
    incoming SBADRI0 : Bit
    //> Register-file write data bit 7.
    incoming SBDATI7 : Bit
    //> Register-file write data bit 6.
    incoming SBDATI6 : Bit
    //> Register-file write data bit 5.
    incoming SBDATI5 : Bit
    //> Register-file write data bit 4.
    incoming SBDATI4 : Bit
    //> Register-file write data bit 3.
    incoming SBDATI3 : Bit
    //> Register-file write data bit 2.
    incoming SBDATI2 : Bit
    //> Register-file write data bit 1.
    incoming SBDATI1 : Bit
    //> Register-file write data bit 0.
    incoming SBDATI0 : Bit
    //> I2C clock line input.
    incoming SCLI    : Bit
    //> I2C data line input.
    incoming SDAI    : Bit
    //> Register-file read data bit 7.
    outgoing SBDATO7 : Bit
    //> Register-file read data bit 6.
    outgoing SBDATO6 : Bit
    //> Register-file read data bit 5.
    outgoing SBDATO5 : Bit
    //> Register-file read data bit 4.
    outgoing SBDATO4 : Bit
    //> Register-file read data bit 3.
    outgoing SBDATO3 : Bit
    //> Register-file read data bit 2.
    outgoing SBDATO2 : Bit
    //> Register-file read data bit 1.
    outgoing SBDATO1 : Bit
    //> Register-file read data bit 0.
    outgoing SBDATO0 : Bit
    //> Register-file bus acknowledge.
    outgoing SBACKO  : Bit
    //> Interrupt request.
    outgoing I2CIRQ  : Bit
    //> Wake-up request.
    outgoing I2CWKUP : Bit
    //> I2C clock line output.
    outgoing SCLO    : Bit
    //> Output enable for the I2C clock line (for open-drain driving).
    outgoing SCLOE   : Bit
    //> I2C data line output.
    outgoing SDAO    : Bit
    //> Output enable for the I2C data line (for open-drain driving).
    outgoing SDAOE   : Bit
}

//> The iCE40 UltraPlus hardened SPI master and slave.
//> The register-file interface is bit-serial: `SBADRI7`..`SBADRI0` carry
//> the address, `SBDATI7`..`SBDATI0` the write data, and `SBDATO7`..
//> `SBDATO0` the read data.
@cell("SB_SPI")
ext mod SbSpi {
    //> Register-file bus clock.
    incoming SBCLKI   : Clock
    //> Register-file bus read/write select (high = read).
    incoming SBRWI    : Bit
    //> Register-file bus strobe.
    incoming SBSTBI   : Bit
    //> Register-file address bit 7.
    incoming SBADRI7  : Bit
    //> Register-file address bit 6.
    incoming SBADRI6  : Bit
    //> Register-file address bit 5.
    incoming SBADRI5  : Bit
    //> Register-file address bit 4.
    incoming SBADRI4  : Bit
    //> Register-file address bit 3.
    incoming SBADRI3  : Bit
    //> Register-file address bit 2.
    incoming SBADRI2  : Bit
    //> Register-file address bit 1.
    incoming SBADRI1  : Bit
    //> Register-file address bit 0.
    incoming SBADRI0  : Bit
    //> Register-file write data bit 7.
    incoming SBDATI7  : Bit
    //> Register-file write data bit 6.
    incoming SBDATI6  : Bit
    //> Register-file write data bit 5.
    incoming SBDATI5  : Bit
    //> Register-file write data bit 4.
    incoming SBDATI4  : Bit
    //> Register-file write data bit 3.
    incoming SBDATI3  : Bit
    //> Register-file write data bit 2.
    incoming SBDATI2  : Bit
    //> Register-file write data bit 1.
    incoming SBDATI1  : Bit
    //> Register-file write data bit 0.
    incoming SBDATI0  : Bit
    //> SPI controller-mode data input (from device).
    incoming MI       : Bit
    //> SPI device-mode data input (from controller).
    incoming SI       : Bit
    //> SPI device-mode clock input.
    incoming SCKI     : Bit
    //> SPI device-mode chip select input (active low).
    incoming SCSNI    : Bit
    //> Register-file read data bit 7.
    outgoing SBDATO7  : Bit
    //> Register-file read data bit 6.
    outgoing SBDATO6  : Bit
    //> Register-file read data bit 5.
    outgoing SBDATO5  : Bit
    //> Register-file read data bit 4.
    outgoing SBDATO4  : Bit
    //> Register-file read data bit 3.
    outgoing SBDATO3  : Bit
    //> Register-file read data bit 2.
    outgoing SBDATO2  : Bit
    //> Register-file read data bit 1.
    outgoing SBDATO1  : Bit
    //> Register-file read data bit 0.
    outgoing SBDATO0  : Bit
    //> Register-file bus acknowledge.
    outgoing SBACKO   : Bit
    //> Interrupt request.
    outgoing SPIIRQ   : Bit
    //> Wake-up request.
    outgoing SPIWKUP  : Bit
    //> SPI device-mode data output.
    outgoing SO       : Bit
    //> Output enable for `SO`.
    outgoing SOE      : Bit
    //> SPI controller-mode data output.
    outgoing MO       : Bit
    //> Output enable for `MO`.
    outgoing MOE      : Bit
    //> SPI controller-mode clock output.
    outgoing SCKO     : Bit
    //> Output enable for `SCKO`.
    outgoing SCKOE    : Bit
    //> SPI controller-mode chip select output 3 (active low).
    outgoing MCSNO3   : Bit
    //> SPI controller-mode chip select output 2 (active low).
    outgoing MCSNO2   : Bit
    //> SPI controller-mode chip select output 1 (active low).
    outgoing MCSNO1   : Bit
    //> SPI controller-mode chip select output 0 (active low).
    outgoing MCSNO0   : Bit
    //> Output enable for `MCSNO3`.
    outgoing MCSNOE3  : Bit
    //> Output enable for `MCSNO2`.
    outgoing MCSNOE2  : Bit
    //> Output enable for `MCSNO1`.
    outgoing MCSNOE1  : Bit
    //> Output enable for `MCSNO0`.
    outgoing MCSNOE0  : Bit
}

// SiliconBlue configuration and arithmetic cells.

//> Warm-boot configuration: reboots into one of the four configuration
//> slots selected by `S1` and `S0`, or re-runs the current slot's boot
//> sequence when `BOOT` is pulsed.
@cell("SB_WARMBOOT")
ext mod SbWarmboot {
    //> Pulse to reboot into the slot selected by `S1` and `S0`.
    incoming BOOT : Bit
    //> Configuration slot select bit 1.
    incoming S1   : Bit
    //> Configuration slot select bit 0.
    incoming S0   : Bit
}

//> The iCE40 UltraPlus hardened 16x16 multiplier-accumulator.
//> Configure its pipeline registers, add/subtract modes, and output
//> selection through the many `*_REG` and `*_SELECT` parameters, which
//> Virdant cannot set yet.
@cell("SB_MAC16")
ext mod SbMac16 {
    //> Multiplier-accumulator clock.
    incoming CLK         : Clock
    //> Clock enable.
    incoming CE          : Bit
    //> Accumulator addend input.
    incoming C           : Word[16]
    //> Multiplicand input.
    incoming A           : Word[16]
    //> Multiplier input.
    incoming B           : Word[16]
    //> Pre-adder input, added to or subtracted from `A`.
    incoming D           : Word[16]
    //> Holds the `A` input register.
    incoming AHOLD       : Bit
    //> Holds the `B` input register.
    incoming BHOLD       : Bit
    //> Holds the `C` input register.
    incoming CHOLD       : Bit
    //> Holds the `D` input register.
    incoming DHOLD       : Bit
    //> Resets the top input registers.
    incoming IRSTTOP     : Bit
    //> Resets the bottom input registers.
    incoming IRSTBOT     : Bit
    //> Resets the top output/accumulator register.
    incoming ORSTTOP     : Bit
    //> Resets the bottom output/accumulator register.
    incoming ORSTBOT     : Bit
    //> Loads the top accumulator from `C` instead of accumulating.
    incoming OLOADTOP    : Bit
    //> Loads the bottom accumulator from `C` instead of accumulating.
    incoming OLOADBOT    : Bit
    //> Selects add/subtract for the top half (high selects subtract).
    incoming ADDSUBTOP   : Bit
    //> Selects add/subtract for the bottom half (high selects subtract).
    incoming ADDSUBBOT   : Bit
    //> Holds the top output/accumulator register.
    incoming OHOLDTOP    : Bit
    //> Holds the bottom output/accumulator register.
    incoming OHOLDBOT    : Bit
    //> Carry-in to the adder.
    incoming CI          : Bit
    //> Carry-in to the accumulator.
    incoming ACCUMCI     : Bit
    //> Sign-extension input, for cascading multiple `SB_MAC16` cells.
    incoming SIGNEXTIN   : Bit
    //> 32-bit multiply-accumulate result.
    outgoing O           : Word[32]
    //> Carry-out from the adder.
    outgoing CO          : Bit
    //> Carry-out from the accumulator.
    outgoing ACCUMCO     : Bit
    //> Sign-extension output, for cascading multiple `SB_MAC16` cells.
    outgoing SIGNEXTOUT  : Bit
}
