//! Platform definitions for the Lattice iCE40 family.
//!
//! Also declares the iCE40's hard cells as `@cell` ext mods.  Port names
//! match the primitives yosys expects, so instantiating these modules
//! produces the corresponding hard cell in the netlist.
//!
//! Virdant cannot set Verilog cell parameters yet, so instantiations use
//! each cell's default parameters.  Yosys infers logic cells and block
//! RAMs automatically, which is usually what you want.

//> iCESugar board.
//> Lattice iCE40-UP5K, SG48 package, programmed over USB.
@fpga("ice40")
@part("up5k-sg48")
platform IceSugar {
    //> Primary 12 MHz clock on pin 35.
    @period_ns("83.33")
    @pin(35)
    incoming clock : Clock

    //> Red channel of the RGB LED (active low).
    @pin(39) outgoing led_red   : Bit
    //> Blue channel of the RGB LED (active low).
    @pin(40) outgoing led_blue  : Bit
    //> Green channel of the RGB LED (active low).
    @pin(41) outgoing led_green : Bit

    //> User switch.
    @pin(18) incoming switch0 : Bit

    //> UART receive data from the host (USB CDC).
    @pin(4) incoming  uart_rx : Bit
    //> UART transmit data to the host (USB CDC).
    @pin(6) outgoing  uart_tx : Bit

    //> SPI flash chip select (active low).
    @pin(46) outgoing flash_cs   : Bit
    //> SPI flash clock.
    @pin(48) outgoing flash_clk  : Bit
    //> SPI flash controller-out data.
    @pin(45) outgoing flash_mosi : Bit
    //> SPI flash controller-in data.
    @pin(47) incoming flash_miso : Bit
}

//> Fomu board (PVT).
//> Lattice iCE40-UP5K, UWG30 (WLCSP-30) package, programmed over USB.  Fomu fits
//> in a USB port and implements USB itself in a softcore, so the bitstream must
//> drive the USB pins (or hold them low to disconnect, as the workshop blink
//> example does).  Pin numbers are UWG30 ball names, matching the upstream
//> `fomu-pvt.pcf`.
@fpga("ice40")
@part("up5k-uwg30")
platform Fomu {
    //> Primary 48 MHz clock on ball F4.
    @period_ns("20.833")
    @pin("F4")
    incoming clock : Clock

    //> RGB LED (active low).  The physical colour order on the PVT is
    //> red = B5, green = A5, blue = C5.
    //>
    //> Red channel of the RGB LED.
    @pin("B5") outgoing led_red   : Bit
    //> Green channel of the RGB LED.
    @pin("A5") outgoing led_green : Bit
    //> Blue channel of the RGB LED.
    @pin("C5") outgoing led_blue  : Bit

    //> Four capacitive touch buttons (active low).
    //>
    //> Capacitive touch button 1.
    @pin("E4") incoming touch1 : Bit
    //> Capacitive touch button 2.
    @pin("D5") incoming touch2 : Bit
    //> Capacitive touch button 3.
    @pin("E5") incoming touch3 : Bit
    //> Capacitive touch button 4.
    @pin("F5") incoming touch4 : Bit

    //> USB (implemented in a softcore; hold low to disconnect).
    //>
    //> USB D+ signal.
    @pin("A1") outgoing usb_dp    : Bit
    //> USB D- signal.
    @pin("A2") outgoing usb_dn    : Bit
    //> USB D+ pull-up enable; hold low to disconnect from the host.
    @pin("A4") outgoing usb_dp_pu : Bit

    //> SPI flash chip select (active low).
    @pin("C1") outgoing flash_cs   : Bit
    //> SPI flash clock.
    @pin("D1") outgoing flash_clk  : Bit
    //> SPI flash controller-out data.
    @pin("F1") outgoing flash_mosi : Bit
    //> SPI flash controller-in data.
    @pin("E1") incoming flash_miso : Bit
}

//> iCEstick board.
//> Lattice iCE40HX-1K, TQ144 package, programmed over USB (FTDI).
@fpga("ice40")
@part("hx1k-tq144")
platform IceStick {
    //> Primary 12 MHz clock on pin 21.
    @period_ns("83.33")
    @pin(21)
    incoming clock : Clock

    //> User LEDs (D1-D5).
    //>
    //> User LED D1.
    @pin(99) outgoing led1 : Bit
    //> User LED D2.
    @pin(98) outgoing led2 : Bit
    //> User LED D3.
    @pin(97) outgoing led3 : Bit
    //> User LED D4.
    @pin(96) outgoing led4 : Bit
    //> User LED D5.
    @pin(95) outgoing led5 : Bit

    //> UART receive data from the host (FTDI USB).
    @pin(9) incoming  uart_rx : Bit
    //> UART transmit data to the host (FTDI USB).
    @pin(8) outgoing  uart_tx : Bit

    //> SPI flash chip select (active low).
    @pin(71) outgoing flash_cs   : Bit
    //> SPI flash clock.
    @pin(70) outgoing flash_clk  : Bit
    //> SPI flash controller-out data.
    @pin(67) outgoing flash_mosi : Bit
    //> SPI flash controller-in data.
    @pin(68) incoming flash_miso : Bit
}

// SiliconBlue logic cells.

//> The iCE40 4-input lookup table.
//> Yosys infers `SB_LUT4` cells from ordinary logic; instantiate this only
//> when you need a LUT you can name directly.
@cell("SB_LUT4")
ext mod SbLut4 {
    //> Lookup table output.
    outgoing O  : Bit
    //> Lookup table input 0.
    incoming I0 : Bit
    //> Lookup table input 1.
    incoming I1 : Bit
    //> Lookup table input 2.
    incoming I2 : Bit
    //> Lookup table input 3.
    incoming I3 : Bit
}

//> The iCE40 fast carry-chain cell, computing `CO = majority(I0, I1, CI)`.
//> Yosys infers `SB_CARRY` cells from adders; instantiate this only when you
//> need a carry cell you can name directly.
@cell("SB_CARRY")
ext mod SbCarry {
    //> Carry output: `majority(I0, I1, CI)`.
    outgoing CO : Bit
    //> Carry-chain input 0.
    incoming I0 : Bit
    //> Carry-chain input 1.
    incoming I1 : Bit
    //> Carry-in from the previous stage.
    incoming CI : Bit
}

//> D flip-flop sampling on the positive clock edge.
@cell("SB_DFF")
ext mod SbDff {
    //> Registered output.
    outgoing Q : Bit
    //> Clock input (positive edge).
    incoming C : Clock
    //> Data input.
    incoming D : Bit
}

//> D flip-flop sampling on the positive clock edge, holding when `E` is low.
@cell("SB_DFFE")
ext mod SbDffe {
    //> Registered output.
    outgoing Q : Bit
    //> Clock input (positive edge).
    incoming C : Clock
    //> Clock enable (active high); holds state when low.
    incoming E : Bit
    //> Data input.
    incoming D : Bit
}

//> D flip-flop sampling on the positive clock edge with a synchronous reset.
@cell("SB_DFFSR")
ext mod SbDffsr {
    //> Registered output.
    outgoing Q : Bit
    //> Clock input (positive edge).
    incoming C : Clock
    //> Synchronous reset (active high).
    incoming R : Bit
    //> Data input.
    incoming D : Bit
}

//> D flip-flop sampling on the positive clock edge with an asynchronous reset.
@cell("SB_DFFR")
ext mod SbDffr {
    //> Registered output.
    outgoing Q : Bit
    //> Clock input (positive edge).
    incoming C : Clock
    //> Asynchronous reset (active high).
    incoming R : Bit
    //> Data input.
    incoming D : Bit
}

//> D flip-flop sampling on the positive clock edge with a synchronous set.
@cell("SB_DFFSS")
ext mod SbDffss {
    //> Registered output.
    outgoing Q : Bit
    //> Clock input (positive edge).
    incoming C : Clock
    //> Synchronous set (active high).
    incoming S : Bit
    //> Data input.
    incoming D : Bit
}

//> D flip-flop sampling on the positive clock edge with an asynchronous set.
@cell("SB_DFFS")
ext mod SbDffs {
    //> Registered output.
    outgoing Q : Bit
    //> Clock input (positive edge).
    incoming C : Clock
    //> Asynchronous set (active high).
    incoming S : Bit
    //> Data input.
    incoming D : Bit
}

//> D flip-flop sampling on the positive clock edge with a clock enable
//> and a synchronous reset.
@cell("SB_DFFESR")
ext mod SbDffesr {
    //> Registered output.
    outgoing Q : Bit
    //> Clock input (positive edge).
    incoming C : Clock
    //> Clock enable (active high); holds state when low.
    incoming E : Bit
    //> Synchronous reset (active high).
    incoming R : Bit
    //> Data input.
    incoming D : Bit
}

//> D flip-flop sampling on the positive clock edge with a clock enable
//> and an asynchronous reset.
@cell("SB_DFFER")
ext mod SbDffer {
    //> Registered output.
