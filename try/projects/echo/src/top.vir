import virt
import uart

pub mod Top for virt::Virt {
    incoming clock : Clock

    outgoing tx : Bit
    incoming rx : Bit

    mod rx_sync of Sync {
        it.clock := clock
        it.inp   := rx
    }

    mod receiver of uart::UartReceiver {
        it.clock := clock
        it.rx    := rx_sync.out
    }

    mod sender of uart::UartSender {
        it.clock := clock
        tx       := it.tx
    }

    sender.inp :=: receiver.out
}
