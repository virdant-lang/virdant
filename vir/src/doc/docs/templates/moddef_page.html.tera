{% extends "base.html.tera" %}
{% block title %}mod {{ name }}{% endblock %}
{% block breadcrumbs %}
<a href="{{ style_href }}index.html">Project</a>
<span class="sep">/</span>
<a href="index.html">{{ package_name }}</a>
<span class="sep">/</span>
<span class="current">{{ name }}</span>
{% endblock %}
{% block content %}
<h1>mod {{ name }}</h1>

{% if doc_body %}
<pre class="doc">{{ doc_body }}</pre>
{% endif %}

{% if ports or sockets %}
<h2>Ports</h2>
{% if ports %}
<div class="table-wrapper">
<table>
  <thead>
    <tr>
      <th>Direction</th>
      <th>Name</th>
      <th>Type</th>
      <th>Dependson</th>
    </tr>
  </thead>
  <tbody>
    {% for port in ports %}
    <tr>
      <td>
        {% if port.direction == "incoming" %}
          <span class="port-direction port-direction-incoming">incoming</span>
        {% else %}
          <span class="port-direction port-direction-outgoing">outgoing</span>
        {% endif %}
      </td>
      <td>
        <code>{{ port.name }}</code>
        {% if port.doc_body %}
          <div class="port-doc">{{ port.doc_body }}</div>
        {% endif %}
      </td>
      <td><code>{{ port.type_str }}</code></td>
      <td>
        {% if port.dependson %}
          <span class="dependson-chips">
            {%- for dep in port.dependson -%}
              <code class="dependson-chip">{{ dep }}</code>
            {%- endfor -%}
          </span>
        {% elif port.direction == "outgoing" %}
          <span class="dependson-empty">&mdash;</span>
        {% endif %}
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
{% endif %}
{% if sockets %}
<h3>Sockets</h3>
<div class="table-wrapper">
<table>
  <thead>
    <tr>
      <th>Role</th>
      <th>Name</th>
      <th>Type</th>
    </tr>
  </thead>
  <tbody>
    {% for sock in sockets %}
    <tr>
      <td><code>{{ sock.role }}</code></td>
      <td><code>{{ sock.name }}</code></td>
      <td>
        {% if sock.href %}
          <a href="{{ sock.href }}"><code>{{ sock.target }}</code></a>
        {% else %}
          <code>{{ sock.target }}</code>
        {% endif %}{% if sock.args %}<code>{{ sock.args }}</code>{% endif %}
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
{% endif %}
{% endif %}

{% if submodules %}
<h2>Submodules</h2>
<div class="table-wrapper">
<table>
  <thead>
    <tr>
      <th>Instance</th>
      <th>Module</th>
    </tr>
  </thead>
  <tbody>
    {% for sub in submodules %}
    <tr>
      <td><code>{{ sub.instance }}</code></td>
      <td>
        {% if sub.href %}
          <a href="{{ sub.href }}"><code>{{ sub.target }}</code></a>
        {% else %}
          <code>{{ sub.target }}</code>
        {% endif %}
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
{% endif %}

{% endblock %}
