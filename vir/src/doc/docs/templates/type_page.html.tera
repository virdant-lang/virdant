{% extends "base.html.tera" %}
{% block title %}{{ kind_label }} {{ name }}{% endblock %}
{% block breadcrumbs %}
<a href="{{ style_href }}index.html">Project</a>
<span class="sep">/</span>
<a href="index.html">{{ package_name }}</a>
<span class="sep">/</span>
<span class="current">{{ name }}</span>
{% endblock %}
{% block content %}
<h1>{% if is_pub %}<span class="pub-badge">pub</span> {% endif %}<span class="kind kind-{{ kind_label }}">{{ kind_label }}</span> <span class="item-name">{{ name }}</span></h1>

{% if doc_body %}
<pre class="doc">{{ doc_body }}</pre>
{% endif %}

{% if slots %}
<p class="slot-toc">
  {% for slot in slots %}{% if not loop.first %} &middot; {% endif %}<a href="#slot-{{ slot.name }}">{{ slot.name }}</a>{% endfor %}
</p>
<h2>Slots</h2>
<dl class="slots">
  {% for slot in slots %}
  <dt id="slot-{{ slot.name }}">
    <span class="kind kind-{{ slot.kind_label }}">{{ slot.kind_label }}</span>
    <code>{{ slot.spelling }}</code>
  </dt>
  {% if slot.doc_body %}
  <dd><pre class="doc">{{ slot.doc_body }}</pre></dd>
  {% endif %}
  {% if slot.params %}
  <dd>
    <div class="table-wrapper">
    <table class="slot-params">
      <thead>
        <tr><th>Param</th><th>Type</th><th>Description</th></tr>
      </thead>
      <tbody>
        {% for param in slot.params %}
        <tr>
          <td><code>{{ param.name }}</code></td>
          <td><code>{{ param.type_str }}</code></td>
          <td>{{ param.doc_body }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
  </dd>
  {% endif %}
  {% endfor %}
</dl>
{% endif %}

<h2>Definition</h2>
<div class="definition-wrapper">
<button class="copy-btn" onclick="copyDefinition(this)">&#x1F4CB;</button>
<pre class="definition">{{ definition_text }}</pre>
</div>
{% endblock %}
{% block scripts %}
<script>
function copyDefinition(btn) {
  var pre = btn.parentNode.querySelector('pre');
  navigator.clipboard.writeText(pre.textContent).then(function() {
    btn.textContent = '\u2713';
    btn.classList.add('copied');
    setTimeout(function() {
      btn.textContent = '\uD83D\uDCCB';
      btn.classList.remove('copied');
    }, 1500);
  });
}
</script>
{% endblock %}
