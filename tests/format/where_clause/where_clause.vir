socket Chan {
    outgoing data : Bit
    incoming ready : Bit dependson data
}

socket Two {
    outgoing data : Bit
    outgoing tag : Bit
    incoming ready : Bit
}

mod Messy {
    forward socket out of Chan
    where it.data dependson inp.data
    {
    it.data := inp.data
    }
    forward socket pair of Two
        where it.data dependson inp.data
    where it.tag dependson inp.data
    {
    it.data := inp.data
    it.tag := inp.data
    }
    reverse socket inp of Chan
    {
        it.ready := out.ready
    }
        where it.ready dependson out.ready
}
