// Clock classes and definitions (CLOCKCHECKING.md, *Clock classes*).
//
// A driver to a Clock-typed target must have a driving expression
// that is a plain reference to a clock.  A conditional whose guards
// and clock drivers do not all denote one clock class mixes domains
// (`DomainMismatch`); a driver whose driving expression is not a
// plain clock reference — a computed clock (a `mux` over clocks) — is
// an error (`ConditionalClockDriver`), and its operands conflict.
// (A guarded driver of a plain clock reference under a single-class
// conditional is legal but warns; see tests/warnings/guarded_clock_driver.)
// An outgoing clock port that aliases an incoming clock must declare
// its provenance with `dependson`.  Internal clock sources count: a
// module registering two oscillator instances is multi-clock.  Nets on
// distinct clock classes cannot be connected.

pub mod GuardedClock {
    incoming clk_a : Clock
    incoming clk_b : Clock
    incoming sel : Bit on clk_a

    wire muxed_clk : Clock

    // CHECK: Domain mismatch: cannot combine clocked by `clk_a` with clocked by `clk_b`
    if {
        when sel {
            muxed_clk := clk_a
        }
        else {
            muxed_clk := clk_b
        }
    }

    unused muxed_clk
}

pub mod ConstantGuardClock {
    incoming clk_a : Clock
    incoming clk_b : Clock

    wire muxed_clk : Clock

    // CHECK: Domain mismatch: cannot combine clocked by `clk_a` with clocked by `clk_b`
    if {
        when true {
            muxed_clk := clk_a
        }
        else {
            muxed_clk := clk_b
        }
    }

    unused muxed_clk
}

pub mod ComputedClock {
    incoming clk_a : Clock
    incoming clk_b : Clock

    wire muxed_clk : Clock {
        // CHECK: `muxed_clk` is a clock and may only be driven by a reference to a clock: clocks are defined, not assigned
        // CHECK: Domain mismatch: cannot combine clocked by `clk_a` with clocked by `clk_b`
        it := mux(true, clk_a, clk_b)
    }

    unused muxed_clk
}

pub mod UndeclaredProvenance {
    incoming clk_in : Clock

    outgoing clk_out : Clock {
        // CHECK: outgoing clock `clk_out` is driven from `clk_in`; declare `dependson clk_in`
        it := clk_in
    }

}

pub mod Osc {
    outgoing clkout : Clock
}

pub mod TwoInternalClocks {
    incoming clk : Clock
    unused clk

    mod osc0 of Osc
    mod osc1 of Osc
    unused osc0.clkout
    unused osc1.clkout

    // CHECK: Missing `on` or `async` clause for data: the module has multiple clocks
    wire data : Word[4] {
        it := 0w4
    }

    unused data
}

pub mod CrossedNets {
    incoming clk_a : Clock
    incoming clk_b : Clock

    wire net_a : Clock
    wire net_b : Clock
    net_a := clk_a
    net_b := clk_b

    // CHECK: Domain mismatch: cannot combine clocked by `clk_a` with clocked by `clk_b`
    net_a :=: net_b
}

