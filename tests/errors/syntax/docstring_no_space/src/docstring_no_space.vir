// InvalidDocstring: a doccomment with text after it but no space after
// the `//>` or `//!` marker is an error.

//!>Bar
// CHECK: Doccomment must be followed by a space

pub mod Foo {
    //>Baz
    // CHECK: Doccomment must be followed by a space
    incoming inp : Bit
    outgoing out : Bit dependson inp
    out := inp
}

// CHECK: Expected docstring line or code in same column, got comment

// Even in malformed doccomment soup, where parser error recovery swallows
// the DocComment tokens, each bad line is still flagged.
//>Soup1
//!>Soup2
// CHECK: Doccomment must be followed by a space
// CHECK: Docstring block must be followed by a token in the same column
// CHECK: Doccomment must be followed by a space
// CHECK: Docstring block mixes //! and //>
// CHECK: Unexpected token: "//!>Soup2"

