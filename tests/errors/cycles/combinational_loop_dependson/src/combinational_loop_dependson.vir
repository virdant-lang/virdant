// Cycles in the `dependson` relation.
//
// `dependson` declares *potential* combinational dependencies.  The
// cycle check runs over the potentiality graph: local drivers, local
// declarations, socket obligations, and the declarations of submodule
// instances.  A cycle is an error even when no actual comb path
// exists today, because a designer must be free to make any declared
// dependency actual without breaking clients.

// A two-module cycle composed from the submodule declarations and the
// parent's glue drivers.
//
// CHECK: Cycle in the `dependson` relation
mod Loop2 {
    mod loop_a of LoopA
    mod loop_b of LoopB

    loop_a.inp := loop_b.out
    loop_b.inp := loop_a.out
}

mod LoopA {
    incoming inp : Bit
    outgoing out : Bit dependson inp {
        it := inp
    }
}

mod LoopB {
    incoming inp : Bit
    outgoing out : Bit dependson inp {
        it := w
    }
    wire w : Bit {
        it := inp
    }
}

// A three-module cycle: the declarations chain through two instances
// and close on the parent's glue driver.
//
// CHECK: Cycle in the `dependson` relation
mod Loop3 {
    mod a of LoopA
    mod b of LoopB
    mod c of LoopC

    a.inp := c.out
    b.inp := a.out
    c.inp := b.out
}

mod LoopC {
    incoming inp : Bit
    outgoing out : Bit dependson inp {
        it := inp
    }
}

// A socket-link cycle: both sides of the socket declare same-cycle
// response (`cosi req dependson ack` for the client, `soci ack
// dependson req` for the server), which composes into a cycle at the
// module containing both instances.
//
// CHECK: Cycle in the `dependson` relation
socket PingPong {
    cosi req : Bit dependson ack
    soci ack : Bit dependson req
}

mod SocketLoop {
    client socket c of PingPong
    server socket s of PingPong

    // The link alone drives every channel; the cycle comes purely
    // from the two `dependson` lists in `PingPong`.
    c :=: s

    unused c.ack
    unused s.req
}

// CHECK: Check failed
