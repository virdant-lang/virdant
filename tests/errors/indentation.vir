// Every line containing at least one token must begin with a number of
// spaces which is a multiple of 4 (0 is okay). Blank lines and lines
// with only comments are exempt.

// CHECK: Line must be indented by a multiple of 4 spaces
// CHECK: Line must be indented by a multiple of 4 spaces
// CHECK-NOT: Unexpected token

mod HalfAdder {
  incoming a : Bit
   incoming b : Bit

    outgoing sum : Bit

  // comment-only lines are exempt at any indentation
 // even one space is fine for comments

    sum := a ^^ b
}