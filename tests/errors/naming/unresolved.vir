// Tests for UnresolvedType, UnresolvedComponent (in a driver), and
// Unknown component (in an expression).

// A port whose type annotation names a type that does not exist.
mod BadPortType {
    // CHECK: Unresolved type NoSuchType
    incoming inp : NoSuchType
    outgoing out : Bit
    out := true
}

// A driver statement that names a component that does not exist in this module.
mod BadDriverTarget {
    outgoing out : Bit
    out := true
    // CHECK: Unresolved component ghost
    ghost := true
}

// An expression that references a name that is not a declared component.
mod BadExprRef {
    outgoing out : Bit
    // CHECK: Unknown component doesnt_exist
    out := doesnt_exist
}

// Builtin types (Bit, Word[n], Clock) resolve fine — no UnresolvedType.
mod GoodTypes {
    incoming clk  : Clock
    incoming data : Word[8]
    incoming flag : Bit
    outgoing out  : Bit
    // CHECK-NOT: Unresolved type
    out := flag
}

enum type Val {
    zero = 0w1
    one = 1
}

mod UnresolvedComponent {
    // CHECK: Unresolved component a
    a <= 0

    // CHECK: Unresolved component b
    b := 0

    // CHECK: Unresolved component c
    match #zero : Val {
        case #zero {
            c := 0
        }
        case #one {
            c := 1
        }
    }
}

mod FooMod {}

mod UnresolvedModDefs {
    // CHECK-NOT: Unknown component
    mod foo of FooMod

    // CHECK: Unresolved item Bar
    mod bar of Bar
}


mod HalfAdder {
    incoming a : Bit
    incoming b : Bit

    outgoing sum : Bit
    outgoing carry_out : Bit

    // sum is true when one of a and b is true (but not both)
    sum := a ^^ b

    // carry is true when a and b are both true
    carry_out := a && b
}

mod FullAdder {
    incoming a : Bit
    incoming b : Bit
    incoming carry_in : Bit

    outgoing sum : Bit {
        sum := ha1.sum
    }

    outgoing carry_out : Bit {
        it := ha0.carry_out || ha1.carry_out
    }


    mod ha0 of HalfAdder {
        it.a := a
        it.b := b
        // CHECK: Unknown component it.carry
        carry1 := it.carry
    }

    mod ha1 of HalfAdder {
        it.a := ha0.sum
        it.b := carry_in
        carry2 := it.carry
    }
}

mod Cpu {
    incoming clock : Clock
    incoming reset : Reset
}

mod UnknownSubcomponent {
    incoming clock : Clock
    incoming reset : Reset

    mod cpu of Cpu {
        it.clock := clock
        it.reset := reset

        // CHECK: Unknown component it.mem
        it.mem :=: mem.wb
    }
}

mod Top {
    // CHECK: Unresolved type Foo
    incoming foo : Foo
    outgoing out : Word[8]
    out := foo->bar
}
// CHECK: Check failed
