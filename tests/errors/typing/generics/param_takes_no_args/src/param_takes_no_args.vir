// A generic parameter applied to type arguments: parameters take no
// type arguments.

pub struct type Box[T : Type] {
    value : T[Bit]
}

pub mod Top {
    incoming inp : Box[Bit]
    outgoing out : Bit dependson inp
    out := inp->value
}

