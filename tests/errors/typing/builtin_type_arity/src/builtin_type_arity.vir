pub mod WordNoWidth {
    // CHECK: Word type requires a width parameter
    wire w0 : Word
    w0 := 0
    unused w0

    // CHECK: Type Bit takes no parameters
    wire w1 : Bit[8]
    w1 := 0
    unused w1

    // CHECK: Type Clock takes no parameters
    wire w2 : Clock[8]
    w2 := 0
    unused w2

    // CHECK: Type Reset takes no parameters
    wire w3 : Reset[2]
    w3 := 0
    unused w3
}

