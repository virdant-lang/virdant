// Tests for EnumPartiallySpecified.
// When no enumerant specifies a value, the enum type is one-hot encoded
// by default. Mixing enumerants with explicit values and enumerants
// without is ambiguous and reported as an Error.

enum type Color {
    // CHECK: Enum type Color specifies values for some but not all enumerants. Either give every enumerant a value, or none (which defaults to one-hot encoding).
    Red
    Green = 1
    Blue
}

// All values specified: no EnumPartiallySpecified for Explicit.
enum type Explicit {
    Low  = 0w2
    High = 3w2
}

// No values specified: one-hot default, no EnumPartiallySpecified for Implicit.
enum type Implicit {
    A
    B
    C
}

// CHECK: Check failed