// A mod with a `for` clause implements a platform, which only top
// modules do: every such mod must be `pub`.

platform Buttons {
    incoming clk_in : Bit
    outgoing led : Bit default true
}

// CHECK: Top module pub_for_notpub::Top must be `pub`
mod Top for Buttons {
    incoming clk_in : Bit
    outgoing led : Bit

    unused clk_in
    led := false
}

// CHECK: Check failed
