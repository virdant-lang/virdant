mod OverlapIdent {
    incoming b : Bit
    outgoing out : Bit dependson b
    // CHECK: Overlapping match arm: x
    out := match b {
        with true  => false
        with x => true
    }
}

mod OverlapDontcare {
    incoming b : Bit
    outgoing out : Bit dependson b
    // CHECK: Overlapping match arm
    out := match b {
        with true  => false
        with dontcare => true
    }
}


// MatchCoverage: duplicated `with true` arm on a Bit subject.

mod OverlapBit {
    incoming b : Bit
    outgoing out : Bit dependson b
    // CHECK: Overlapping match arm: true
    out := match b {
        with true  => false
        with false => true
        with true  => true
    }
}


// MatchCoverage: duplicated @Foo arm in a union match.

union type MyUnion {
    Foo()
    Bar(x : Bit)
}

mod OverlapUnion {
    wire u : MyUnion
    u := @Foo()

    wire out : Bit
    unused out
    // CHECK: Overlapping match arm: @Foo
    out := match u {
        with @Foo() => true
        with @Bar(x) => x
        with @Foo() => false
    }
}


// MatchCoverage: duplicated word-literal arm.

mod OverlapWord {
    incoming x : Word[2]
    outgoing out : Bit dependson x
    // CHECK: Overlapping match arm: 0
    out := match x {
        with 0 => true
        with 1 => false
        with 2 => true
        with 3 => false
        with 0 => false
    }
}

