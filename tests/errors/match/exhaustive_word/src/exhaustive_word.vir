// MatchCoverage: Word[8] subject with only a few literals and no `else`.

mod WordNeedsElse {
    incoming x : Word[8]
    outgoing out : Bit dependson x
    // CHECK: Non-exhaustive match
    out := match x {
        with 0 => true
        with 1 => false
        with 2 => true
    }
}

