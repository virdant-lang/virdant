// Regression: arm patterns in a statement-level match must agree with the
// subject type.  Before this was caught, `with 0 => { ... }` on an enum
// subject was silently ignored by both the typing pass and the
// match-coverage analysis.

enum type State {
    On  = 1w2
    Off = 2w2
}

union type MyUnion {
    Foo()
}

mod WordPatOnEnum {
    incoming clock : Clock
    reg r : Bit
    unused r
    match #Off : State {
        with #On  { r <= true }
        with #Off { r <= false }
        // CHECK: which is not a Word type
        with 0    { r <= false }
    }
}

mod EnumPatOnWord {
    incoming clock : Clock
    incoming x    : Word[2]
    reg r : Bit
    unused r
    match x {
        with 0 { r <= true }
        with 1 { r <= false }
        with 2 { r <= true }
        with 3 { r <= false }
        // CHECK: PatEnumerant expects an enum type
        with #On { r <= false }
    }
}

mod CtorPatOnWord {
    incoming clock : Clock
    incoming x    : Word[2]
    reg r : Bit
    unused r
    match x {
        with 0 { r <= true }
        with 1 { r <= false }
        with 2 { r <= true }
        with 3 { r <= false }
        // CHECK: Unresolved constructor Foo
        with @Foo() { r <= false }
    }
}

mod BitPatOnEnum {
    incoming clock : Clock
    reg r : Bit
    unused r
    match #Off : State {
        with #On  { r <= true }
        with #Off { r <= false }
        // CHECK: Wrong type
        with true { r <= false }
    }
}

// CHECK: Check failed
