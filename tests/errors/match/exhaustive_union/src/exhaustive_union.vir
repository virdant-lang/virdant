// MatchCoverage: union subject with one constructor omitted.

union type MyUnion {
    Foo()
    Bar(x : Bit)
}

pub mod MissingUnionCtor {
    wire u : MyUnion
    u := @Foo()

    wire out : Bit
    unused out
    // CHECK: not covered: @Bar
    out := match u {
        with @Foo() => true
    }
}

// CHECK: FAILED with
// CHECK: 1 ERROR
// CHECK-NOT: WARNING
// CHECK: Check failed
