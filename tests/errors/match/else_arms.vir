// MatchCoverage: `else` arm followed by another `case`.

mod ElseNotLast {
    incoming x : Word[8]
    outgoing out : Bit
    // CHECK: else arm must be the last arm of the match
    out := match x {
        case 0 => true
        else   => false
        case 1 => true
    }
}


// MatchCoverage: two `else` arms in the same match.

mod MultipleElse {
    incoming x : Word[8]
    outgoing out : Bit
    // CHECK: Multiple else arms in match
    out := match x {
        case 0 => true
        else   => false
        else   => true
    }
}


// MatchCoverage: enum subject with every enumerant covered plus `else`.

enum type Color {
    Red   = 0w2
    Green = 1
    Blue  = 2
}

mod RedundantElse {
    wire c : Color
    c := #Red

    wire out : Bit
    unused out
    // CHECK: Redundant else arm
    out := match c {
        case #Red   => true
        case #Green => false
        case #Blue  => true
        else        => false
    }
}

// CHECK: Check failed
