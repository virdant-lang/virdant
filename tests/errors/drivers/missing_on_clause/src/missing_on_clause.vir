// The `on` clause is optional on `reg` declarations when the module
// declares *exactly one* incoming clock port — a declared
// `incoming ... : Clock`, or an inward socket channel typed `Clock`
// (it is as if the user had written `on <the_one_clock>`).  With zero
// or more than one incoming clock ports, an explicit `on` clause is
// still required.

// Exactly one Clock-typed component: the `on` clause is optional.
pub mod OneClock {
    incoming clock : Clock

    reg data_buf : Word[8]

    unused data_buf
    data_buf <= 0
}

// Zero Clock-typed components: `on` is still required.
pub mod NoClocks {
    reg data_buf : Word[8]

    unused data_buf
    data_buf <= 0
}

// More than one Clock-typed component: ambiguous, `on` is still required.
pub mod TwoClocks {
    incoming clk_a : Clock
    incoming clk_b : Clock

    unused clk_a
    unused clk_b
    reg data_buf : Word[8]

    unused data_buf
    data_buf <= 0
}

// Two incoming clock ports — a declared `incoming` clock plus an
// inward socket channel typed `Clock` — are ambiguous, `on` is still
// required.
socket ClkBus {
    outgoing clk : Clock
}

pub mod PortAndSocket {
    incoming clock : Clock
    server socket link of ClkBus {
        unused it.clk
    }

    reg data_buf : Word[8]

    unused clock
    unused data_buf
    data_buf <= 0
}

// A declared `incoming` clock and a Clock-typed *outgoing* channel (a
// clock the module drives outward, not one it receives) are still only
// one incoming clock port, so the `on` clause is optional.
pub mod PortAndOutwardSocket {
    incoming clock : Clock
    client socket link of ClkBus {
        it.clk := clock
    }

    reg data_buf : Word[8]

    unused data_buf
    data_buf <= 0
}

// Two inward socket channels typed `Clock` are two incoming clock
// ports, just like two declared `incoming` clocks: ambiguous, `on` is
// still required.
pub mod TwoSocketClocks {
    server socket bus_a of ClkBus
    server socket bus_b of ClkBus

    reg data_buf : Word[8]

    unused bus_a.clk
    unused bus_b.clk
    unused data_buf
    data_buf <= 0
}

// A submodule's Clock-typed *output* carries a clock through the
// module but does not clock it: the module still has zero incoming
// clock ports, and `on` is still required.
mod ClockSrc {
    outgoing clock_out : Clock {
        it := asclock(true)
    }
}

pub mod OnlySubmoduleClock {
    mod src of ClockSrc
    unused src.clock_out

    reg data_buf : Word[8]

    unused data_buf
    data_buf <= 0
}

