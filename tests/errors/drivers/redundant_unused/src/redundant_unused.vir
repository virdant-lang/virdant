// RedundantUnused: a component is marked `unused` two or more times.

// A top-level incoming port marked unused twice.
mod DupUnusedTop {
    incoming clock : Clock
    outgoing out : Bit

    unused clock
    // CHECK: Redundant `unused`: clock
    unused clock

    out := true
}

// A submodule port marked unused twice inside an it block.
mod DupUnusedIt {
    outgoing sum : Bit

    mod ha of HalfAdder {
        it.a := false
        it.b := false
        unused it.carry_out
        // CHECK: Redundant `unused`: ha.carry_out
        unused it.carry_out
    }

    sum := ha.sum
}

// Same path marked unused at top level then again.
mod DupUnusedMixed {
    outgoing sum : Bit

    mod ha of HalfAdder {
        it.a := false
        it.b := false
    }

    unused ha.carry_out
    // CHECK: Redundant `unused`: ha.carry_out
    unused ha.carry_out

    sum := ha.sum
}

// A reg it-block's `unused it` and a top-level `unused r` name the
// same component: the second is redundant.
mod DupUnusedRegItBlock {
    incoming clock : Clock
    incoming inp : Bit
    outgoing out : Bit

    reg r : Bit {
        unused it
        it <= inp
    }

    // CHECK: Redundant `unused`: r
    unused r

    out := true
}

// Same aliasing, reversed order: the top-level `unused r` comes first,
// so the it-block's `unused it` is the redundant one.
mod DupUnusedRegItBlockReversed {
    incoming clock : Clock
    incoming inp : Bit
    outgoing out : Bit

    unused r

    // CHECK: Redundant `unused`: r
    reg r : Bit {
        unused it
        it <= inp
    }

    out := true
}

// A wire's it-block aliases the same way.
mod DupUnusedWireItBlock {
    outgoing out : Bit

    wire w : Bit {
        unused it
        it := true
    }

    // CHECK: Redundant `unused`: w
    unused w

    out := true
}

// A whole submodule: `unused it` inside the mod block and `unused ha`
// at top level are the same path.
mod DupUnusedWholeSubmod {
    outgoing out : Bit

    mod ha of HalfAdder {
        it.a := false
        it.b := false
        unused it
    }

    // CHECK: Redundant `unused`: ha
    unused ha

    out := true
}

// Only a single unused per path -- no redundant diagnostic.
mod SingleUnused {
    incoming clock : Clock
    outgoing out : Bit

    unused clock
    // CHECK-NOT: Redundant `unused`

    out := true
}

// Unused on two *different* paths -- no redundant diagnostic.
mod TwoDifferentPaths {
    incoming clock : Clock
    incoming reset : Bit
    outgoing out : Bit

    unused clock
    unused reset
    // CHECK-NOT: Redundant `unused`

    out := true
}

mod HalfAdder {
    incoming a : Bit
    incoming b : Bit
    outgoing sum : Bit dependson a, b
    outgoing carry_out : Bit dependson a, b

    sum := a ^ b
    carry_out := a & b
}

// CHECK: Check failed
