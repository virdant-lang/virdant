// A socketdef channel's `dependson` entries must be channels of the
// same socketdef with the opposite direction word: `cosi` channels
// may only depend on `soci` channels, and vice versa.

// CHECK: Bad `dependson` entry `ready2`: a `cosi` channel may only `dependson` channels of the opposite direction word
// CHECK: Bad `dependson` entry `nowhere`: is not a channel of the same socket; a `soci` channel may only `dependson` channels of the opposite direction word
socket Link {
    cosi data : Bit dependson ready, ready2
    cosi ready2 : Bit
    soci ready : Bit dependson data, nowhere
}

pub mod Top {
    incoming inp : Bit
    outgoing ok : Bit
    ok := true
    unused inp
}
