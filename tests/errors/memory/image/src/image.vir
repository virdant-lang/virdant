// Image rules: the file must be no longer than the declared depth.
// An image memory may also declare a write site: the image words are
// its initial contents, and writes commit on the clock edge.
// A missing image file is not a compile error — it is a build-time
// check, so an unreadable file compiles here (see
// tests/check/memory/image).

mod TooLong {
    incoming clock : Clock
    incoming addr : Word[2]
    outgoing read_data : Word[8] dependson addr {
        it := rom[dyn addr]
    }

    // The file holds six words; the depth is four.
    @image_hex("words_too_long.hex")
    memory rom[4] : Word[8]
}

// CHECK: memory image words_too_long.hex holds more words than the declared depth 4
// CHECK: Check failed
