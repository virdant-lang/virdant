// Write-site rules (MEMORY_PLAN §3.3, §3.4): exactly one write site
// per memory, sibling `when` clauses whose guards are not exclusive
// may not both write the memory, indexed drivers write memories only,
// and a write outside a clocked context is an error when the memory's
// clock is unresolved.

pub mod Overlapping {
    incoming clock : Clock
    incoming write_enable : Bit
    incoming flush : Bit
    incoming addr : Word[4]
    incoming flush_addr : Word[4]
    incoming write_data : Word[8]

    memory mem[16] : Word[8] {
        if {
            when write_enable {
                it[dyn addr] <= write_data
            }
            // A second `when` is not exclusive with the first: both
            // may fire in one cycle and collide.
            when flush {
                it[dyn flush_addr] <= 0w8
            }
        }
    }

    // mem is written but never read; the unused mark silences the
    // incidental UnusedSource warning so the filecheck stays focused
    // on the write-site rules.
    unused mem
}

pub mod TwoSites {
    incoming clock : Clock
    incoming addr : Word[4]
    incoming write_data : Word[8]

    memory mem[16] : Word[8]

    mem[dyn addr] <= write_data
    mem[dyn addr] <= write_data

    // mem is written but never read; see Overlapping.
    unused mem
}

pub mod NotAMemory {
    incoming clock : Clock
    incoming addr : Word[4]
    incoming write_data : Word[8]

    // An indexed driver targets a memory component only.
    some_wire[dyn addr] <= write_data

    wire some_wire : Word[8] {
        it := write_data
    }

    // clock and some_wire are never read; the unused marks silence
    // the incidental UnusedSource warnings so the filecheck stays
    // focused on the IndexedDriverNotMemory rule.
    unused clock
    unused some_wire
}

pub mod OutsideClockedContext {
    incoming clk_a : Clock
    incoming clk_b : Clock
    incoming addr : Word[4] on clk_a
    incoming write_data : Word[8] on clk_a

    // Two clocks and no explicit `on` clause: no implicit clocked
    // context exists, so this write site has no clock.
    memory mem[16] : Word[8]

    mem[dyn addr] <= write_data

    // Two clocks means no implicit clock, so clk_a and clk_b are
    // never read, and the rejected write site leaves mem without a
    // driver. The unused marks silence the incidental UnusedSource
    // warnings so the filecheck stays focused on the
    // MemoryWriteOutsideOnRegion rule.
    unused clk_b
    unused mem
}

