// The element type must be `Word[n]` with `n` a power of two
// (MEMORY_PLAN §4.2).

mod NotPow2Width {
    incoming clock : Clock
    incoming addr : Word[4]
    incoming write_data : Word[12]
    outgoing read_data : Word[12]

    // 12 is not a power of two.
    memory mem[16] : Word[12] {
        it[dyn addr] <= write_data
        read_data := it[dyn addr]
    }
}

mod NotAWord {
    incoming clock : Clock
    incoming addr : Word[4]
    incoming write_data : Bit
    outgoing read_data : Bit

    // `Bit` is not a Word type.
    memory mem[16] : Bit {
        it[dyn addr] <= write_data
        read_data := it[dyn addr]
    }
}

// An unresolved element type must not cascade into "Missing
// annotation" noise on the reads: the real error is the unresolved
// type at the declaration.
mod ElemUnresolved {
    incoming clock : Clock
    incoming addr : Word[3]

    memory mem[8] : Nonsense

    outgoing const_read : Bit {
        it := mem[0]
    }
    outgoing dyn_read : Bit dependson addr {
        it := mem[dyn addr]
    }
}

// CHECK: memory element type must be `Word[n]` with n a power of 2, found Word[12]
// CHECK: memory element type must be `Word[n]` with n a power of 2, found Bit
// CHECK: Unresolved type Nonsense
// CHECK-NOT: Missing annotation
// CHECK: Check failed
