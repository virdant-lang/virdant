// `initial` statements are not supported on memories in v1
// (MEMORY_PLAN §6): contents come from `@image`/`@image_hex`.

mod InitialOnMemory {
    incoming clock : Clock

    memory mem[16] : Word[8] {
        initial it <= 0w8
    }
}

// CHECK: `initial` is not supported on memory mem
// CHECK: Check failed
