// Guard: type arguments on socket/mod instantiation are parsed but not
// yet implemented, and fail loudly at the guard, pointing at the
// argument list.  The socket and mod defs themselves are not generic.

socket Pipe {
    cosi data : Word[8]
    soci ready : Bit
}

mod Keep {
    incoming d : Word[8]
    wire w : Bit
    w := true
    unused d
}

export mod Top {
    incoming a : Word[8]
    outgoing out : Bit
    out := false
    client socket inp of Pipe[Word[8]] {
        it.data := a
    }
    mod f of Keep[Word[8]] {
        it.d := a
    }
}

