// Guard: generic mod defs are parsed but not yet implemented.
// Instantiating one (even bare) fails loudly at the guard, pointing at
// the parameter list of the declaration.

mod Keep[T : Type] {
    incoming d : T
    wire w : Bit
    w := true
    unused d
}

export mod Top {
    outgoing out : Bit
    out := false
    mod f of Keep {
        it.d := ?
    }
}

