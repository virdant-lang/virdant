// A struct literal poked into a port must arrive with its fields in
// declaration order: `addr` is `Word[5]` and `data` is `Word[32]`, so
// a field-order swap (first field packed at the MSB end) is visible as
// garbage on both sides of the round trip.
//
// Write 42 into register 3, then read it back through the memory.
poke write @Valid(${ addr = 3w5, data = 42w32 })
tick
poke write @Invalid()

poke addr 3w5
advance
assert data == 42

// Round-trip the value back out through a peek: the display and the
// design must agree on the field order.
poke write @Valid(${ addr = 7w5, data = 4294967295w32 })
tick
poke write @Invalid()
poke addr 7w5
advance
assert data == 4294967295
exit
