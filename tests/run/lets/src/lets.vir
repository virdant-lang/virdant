// A `kind = "run"` test exercising the `let` statement feature, with
// corner cases: untyped and typed bindings, multi-binding lists where
// later bindings see earlier ones, nested lets, `let` as the body of
// `if`/`match` arms, `let` with `if`/`match` bodies, and shadowing
// in sibling arms.  Then the simulator exits with code 0.

import virt

pub mod LetTest for virt::Virt {
    outgoing exit : Valid[Word[8]]
    //> Primary clock.
    incoming clock : Clock

    wire a : Bit
    let x = 0w0 {
        a := x == 0
    }

    wire b : Bit
    let x = 1w2,
        y = 2w2 {
            b := x + y == 3
    }

    wire c : Bit
    let x = 1 : Word[2],
        y = 2w2 {
            c := x + y == 3
    }

    wire d : Bit {
        match @Valid(0) : Valid[Word[8]] {
            with @Invalid() {
                it := false
            }
            with @Valid(value) let x = 10w8 {
                it := x == 10
            }
        }
    }

    wire e : Bit {
        match @Valid(2) : Valid[Word[8]] {
            with @Invalid() {
                it := false
            }
            with @Valid(value) let value = 3w8 {
                it := value == 3
            }
        }
    }

    wire f : Bit {
        match @Valid(5) : Valid[Word[8]] {
            with @Invalid() {
                it := false
            }
            with @Valid(a) let b = a {
                it := a == 5
            }
        }
    }

    // Expression-position `let` with an `if` body and multiple
    // bindings.

    // Expression-position `let` with a `match` body: the binding is
    // used inside the match's arms.

    // Nested expression-position `let`s: the inner binding shadows the
    // outer one, so the body sees `!a` (false), and the `else` arm is
    // taken.  Without shadowing, `p` would be `a` (true) and the
    // `when` arm would win instead.
    wire i : Bit {
        it := let p = a if {
            when true => let p = !a if {
                when p => false
                else => true
            }
            else => false
        }
    }

    // A later binding of an expression-position `let` referring to an
    // earlier one.

    // making sure that the test doesn't pass if success
    // passes due to a bug below
    wire success_wire : Bit {
        it := a && b && c && d && e && f && i
    }

    let success = a && b && c && d && e && f && i if {
        when success && success_wire {
            exit := @Valid(0)
        }
        else {
            exit := @Invalid()
        }
    }
}
