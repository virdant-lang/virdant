// Self-checking `kind = "run"` test for a union `match` with an
// `else` arm: the `case` arms list two of the three union variants
// and the `else` arm catches the unlisted third variant.  A register
// cycles through all three variants every three cycles; a
// statement-level `match` drives the result and one flag per routing
// (`case` vs `else`), while an expression-level `match` recomputes the
// expected result independently.  The test asserts that each of the
// three variants was routed to the correct arm, that the `case` and
// `else` routings never fire together, and that the statement-level
// and expression-level results agree, then exits with code 0.

import virt

//> Variants cycled through by the harness.  Only `Add` and `Xor`
//> are listed as `case` arms; `Sub` must be caught by `else`.
union type Op {
    Add(x : Word[4], y : Word[4])
    Xor(x : Word[4], y : Word[4])
    Sub(x : Word[4], y : Word[4])
}

pub mod MatchUnionElseTest for virt::Virt {
    //> Primary clock.
    incoming clock : Clock

    //> Cycles `@Add(3, 5)` -> `@Xor(3, 5)` -> `@Sub(3, 5)` and back,
    //> so every variant is visited repeatedly.
    reg state : Op on clock {
        initial it <= @Add(3w4, 5w4)
        it <= match it {
            case @Add(x, y) => @Xor(x, y)
            case @Xor(x, y) => @Sub(x, y)
            else => @Add(3w4, 5w4)
        }
    }

    wire result : Word[4]
    wire via_case : Bit
    wire via_else : Bit
    match state {
        case @Add(x, y) {
            result := x + y
            via_case := true
            via_else := false
        }
        case @Xor(x, y) {
            result := x ^ y
            via_case := true
            via_else := false
        }
        else {
            result := 0
            via_case := false
            via_else := true
        }
    }

    //> Independent recomputation of what `result` should be, using an
    //> expression-level `match` whose `else` agrees with the
    //> statement-level `else`.
    wire expected : Word[4] {
        it := match state {
            case @Add(x, y) => x + y
            case @Xor(x, y) => x ^ y
            else => 0
        }
    }

    //> Which state is current, so each arm can be tracked separately.
    wire on_add : Bit {
        it := match state {
            case @Add(x, y) => true
            else => false
        }
    }

    wire on_mul : Bit {
        it := match state {
            case @Xor(x, y) => true
            else => false
        }
    }

    wire on_sub : Bit {
        it := match state {
            case @Sub(x, y) => true
            else => false
        }
    }

    //> Sticky record of which arms fired: bit 0 for the `@Add` case,
    //> bit 1 for the `@Xor` case, bit 2 for the `else` arm.
    reg seen : Word[3] on clock {
        initial it <= 0w3
        it <= match state {
            case @Add(x, y) => seen | 1w3
            case @Xor(x, y) => seen | 2w3
            else => seen | 4w3
        }
    }

    //> All three arms exercised: both listed `case`s and `else`.
    wire done : Bit {
        it := seen == 7w3
    }

    //> The statement-level routing and the independent expected value
    //> must agree every cycle, and exactly one of `via_case` /
    //> `via_else` must be high.
    wire ok : Bit {
        it := result == expected && via_case != via_else
    }

    //> Latches a mismatch the moment one occurs.
    reg failed : Bit on clock {
        initial it <= false
        it <= failed || !ok
    }

    //> `@Valid(0)` once every arm has been exercised and no mismatch
    //> was ever observed; `@Valid(1)` on any mismatch; `@Invalid()`
    //> while still waiting.
    outgoing exit : Valid[Word[8]] {
        it := when {
            case failed => @Valid(1)
            case done => @Valid(0)
            else => @Invalid()
        }
    }
}
