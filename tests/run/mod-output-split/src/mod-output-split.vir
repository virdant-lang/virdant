//! Self-checking `kind = "run"` test for a child output consumed by
//! both a parent output and a parent register.
//!
//! A `Source` module registers its input and presents it on `out`.
//! `Splitter` forwards that same child output combinationally to its
//! outgoing `out_port` and also captures it into `reg captured`.  The
//! harness asserts that once the child value has settled after a
//! change, both consumers agree with each other and with the expected
//! value, and that when the value changes, the register lags the
//! output by exactly one cycle.  The simulator exits with code 0 only
//! if every check passed.

import virt

//> Registered buffer: `out` follows `inp`, delayed by one cycle.
mod Source {
    //> Primary clock.
    incoming clock : Clock

    //> Value to be presented on `out` from the next cycle on.
    incoming inp : Word[4]

    //> Previously captured value of `inp`.
    outgoing out : Word[4]

    reg data : Word[4] on clock {
        initial it <= 0
        it <= inp
    }

    out := data
}

//> Splits a child output into two parent consumers: the parent output
//> `out_port` reads the child output directly, while the parent
//> register `captured` samples the same child output on every clock
//> edge.
mod Splitter {
    //> Primary clock.
    incoming clock : Clock

    //> Value fed to the child.
    incoming inp : Word[4]

    //> Parent output consuming the child output directly.
    outgoing out_port : Word[4] {
        it := source.out
    }

    //> Instance whose output feeds both consumers under test.
    mod source of Source {
        it.clock := clock
        it.inp := inp
    }

    //> Parent register consuming the same child output.
    reg captured : Word[4] on clock {
        initial it <= 0
        it <= source.out
    }

    //> Read-only view of `captured` so the harness can observe the
    //> register consumer.
    outgoing captured_view : Word[4] {
        it := captured
    }
}

pub mod ModOutputSplitTest for virt::Virt {
    //> Primary clock.
    incoming clock : Clock

    //> `@Valid(0)` after every check passed; `@Valid(1)` if any check
    //> failed.  While `@Invalid()`, the simulator keeps running.
    outgoing exit : Valid[Word[8]] {
        it := when {
            case finished => @Valid(mux(all_ok, 0, 1))
            else => @Invalid()
        }
    }

    //> Instance under test: its child output feeds both a parent
    //> output and a parent register.
    mod splitter of Splitter {
        it.clock := clock
        it.inp := inp
    }

    //> Test schedule.
    reg tick : Word[4] on clock {
        initial it <= 0
        it <= it + 1
    }

    //> Rises after the last check (tick 8) has been folded in.
    reg finished : Bit on clock {
        initial it <= false
        when {
            case tick == 9 {
                it <= true
            }
        }
    }

    //> Running AND of every check.  Power-on true; each check folds
    //> its verdict in on the cycle after it is active.
    reg all_ok : Bit on clock {
        initial it <= true
        it <= it && check_agree_0 && check_lag_0 && check_agree_1
    }

    //> Input pattern: the value fed to `splitter` is 3 on cycle 0,
    //> changes to 7 on the edge after tick 0, and to 12 on the edge
    //> after tick 4.
    wire inp : Word[4] {
        it := when {
            case tick < 1 => 3
            case tick < 5 => 7
            else => 12
        }
    }

    //> Tick 3: the value has been 7 since tick 2, so the parent output
    //> and the parent register must both read 7.
    wire check_agree_0 : Bit {
        it := tick != 3 ||
            (splitter.out_port == splitter.captured_view
                && splitter.out_port == 7)
    }

    //> Tick 6: the child output just moved from 7 to 12, so the parent
    //> output already reads 12 while the parent register still holds
    //> the previous value 7.
    wire check_lag_0 : Bit {
        it := tick != 6 ||
            (splitter.out_port == 12 && splitter.captured_view == 7)
    }

    //> Tick 8: the value has been 12 for two cycles, so both consumers
    //> must agree on 12.
    wire check_agree_1 : Bit {
        it := tick != 8 ||
            (splitter.out_port == splitter.captured_view
                && splitter.out_port == 12)
    }
}
