//! Self-checking `kind = "run"` test for a 2-bit binary to 4-bit
//! one-hot decoder implemented with `match`.
//!
//! A `Decoder` unit converts each 2-bit code to its one-hot encoding
//! while the harness top walks all 4 codes, one per cycle.  Each
//! result is compared against a golden value and every check is ANDed
//! into a running `all_ok`; the simulator exits with code 0 only if
//! all 4 codes passed, and 1 otherwise.

import virt

//> 2-bit binary to 4-bit one-hot decoder.
//>
//> Assert `code` with the binary value; `onehot` then shows exactly
//> one bit set, at the position given by `code`.
mod Decoder {
    //> Binary code to decode.
    incoming code : Word[2]

    //> One-hot encoding of `code`: bit `code` set, all others clear.
    outgoing onehot : Word[4]

    match code {
        case 0 {
            onehot := 0b0001w4
        }
        case 1 {
            onehot := 0b0010w4
        }
        case 2 {
            onehot := 0b0100w4
        }
        case 3 {
            onehot := 0b1000w4
        }
    }
}

pub mod Top for virt::Virt {
    //> Primary clock.
    incoming clock : Clock

    //> `@Valid(0)` after all 4 codes checked out; `@Valid(1)` if any
    //> check failed.  While `@Invalid()`, the simulator keeps running.
    outgoing exit : Valid[Word[8]] {
        it := when {
            case finished => @Valid(mux(all_ok, 0, 1))
            else => @Invalid()
        }
    }

    mod decoder of Decoder {
        it.code := code
    }

    //> Code under test this cycle, walking 0 through 3.
    wire code : Word[2] {
        it := index[2..0]
    }

    //> Golden one-hot value for `code`, selected by a `match` on the
    //> code.  The 4 cases exactly cover `Word[2]`, so the match is
    //> exhaustive.
    wire expected : Word[4]

    match code {
        case 0 {
            expected := 0b0001w4
        }
        case 1 {
            expected := 0b0010w4
        }
        case 2 {
            expected := 0b0100w4
        }
        case 3 {
            expected := 0b1000w4
        }
    }

    //> Index of the code under test, cycling 0 through 3.
    reg index : Word[2] on clock {
        initial it <= 0
        it <= index + 1
    }

    //> Running AND of every check so far.  Power-on true; each check
    //> folds its verdict in on the cycle its code is on the inputs.
    reg all_ok : Bit on clock {
        initial it <= true
        it <= it && decoder.onehot == expected
    }

    //> Number of codes checked so far, 0 through 4.  Holds at 4 so
    //> that `finished` stays high.
    reg checked : Word[3] on clock {
        initial it <= 0
        when {
            case checked != 4 {
                it <= checked + 1
            }
        }
    }

    //> Rises once all 4 codes have been checked, so that the exit code
    //> sees the final `all_ok`.
    wire finished : Bit {
        it := checked == 4
    }
}
