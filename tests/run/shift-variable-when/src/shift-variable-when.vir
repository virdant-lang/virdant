// Self-checking `kind = "run"` test for variable-distance shifts of a
// `Word[8]` written with `when` expressions.
//
//! A `VariableShift` unit shifts an 8-bit word left or right by a
//! variable amount (0 through 3) using a `when` expression over the
//! amount and `word()`/bit slices (Virdant has no `<<`/`>>`
//! operators).  A harness top runs a sequencer that cycles the shift
//! amount 0, 1, 2, 3 and alternates between two stimulus words, so
//! every (vector, amount) pair is checked.  Each result is compared
//! against a golden value and every check is ANDed into a running
//! `all_ok`; the simulator exits with code 0 only if all 8 checks
//! passed, and 1 otherwise.

import virt

//> Shifts the operand left and right by a variable amount (0
//> through 3) using a `when` expression, `word()`, and bit slices.
mod VariableShift {
    //> Value to shift.
    incoming x : Word[8]

    //> Shift amount, 0 through 3.
    incoming s : Word[2]

    //> `x` shifted left by `s`: drop the top `s` bits (shifted out
    //> and lost) and append `s` zero bits at the bottom.
    outgoing left : Word[8] {
        it := when {
            case s == 0 => x
            case s == 1 => word(x[8..1], 0w1)
            case s == 2 => word(x[8..2], 0w2)
            else => word(x[8..3], 0w3)
        }
    }

    //> `x` shifted right by `s`: prepend `s` zero bits at the top and
    //> drop the bottom `s` bits (shifted out and lost).
    outgoing right : Word[8] {
        it := when {
            case s == 0 => x
            case s == 1 => word(0w1, x[8..1])
            case s == 2 => word(0w2, x[8..2])
            else => word(0w3, x[8..3])
        }
    }
}

pub mod ShiftVarWhenTest for virt::Virt {
    //> Primary clock.
    incoming clock : Clock

    //> `@Valid(0)` after the last check passed; `@Valid(1)` if any
    //> check failed.  While `@Invalid()`, the simulator keeps
    //> running.
    outgoing exit : Valid[Word[8]] {
        it := when {
            case finished => @Valid(mux(all_ok, 0, 1))
            else => @Invalid()
        }
    }

    mod shifter of VariableShift {
        it.x := vec_x
        it.s := amount
    }

    //> Shift amount under test: the sequencer cycles it 0, 1, 2, 3,
    //> wrapping back to 0.
    reg amount : Word[2] on clock {
        initial it <= 0
        it <= when {
            case it == 3 => 0
            else => it + 1
        }
    }

    //> Which stimulus word is under test: flips after each full sweep
    //> of the four amounts, so both vectors see every amount.
    reg vec : Bit on clock {
        initial it <= false
        when {
            case amount == 3 {
                it <= !it
            }
        }
    }

    //> Running AND of every check so far.  Power-on true; each cycle
    //> folds in the verdicts for the current (vector, amount) pair.
    reg all_ok : Bit on clock {
        initial it <= true
        it <= it && shifter.left == expected_left && shifter.right == expected_right
    }

    //> Rises one cycle after the last (vector, amount) pair is
    //> checked, so that the exit code sees the final `all_ok`.
    reg finished : Bit on clock {
        initial it <= false
        when {
            case vec && amount == 3 {
                it <= true
            }
        }
    }

    //> The stimulus word under test, selected by `vec`.
    wire vec_x : Word[8] {
        it := mux(vec, 0xa5, 0xb2)
    }

    wire expected_left : Word[8]
    wire expected_right : Word[8]

    // Test-vector table: the golden `expected_left` / `expected_right`
    // results, keyed by `word(vec, amount)`.  The 8 cases exactly
    // cover `Word[3]`, so the match is exhaustive.
    wire key : Word[3] {
        it := word(vec, amount)
    }

    match key {
        // vec 0 (0xb2), amount 0.
        case 0 {
            expected_left := 0xb2
            expected_right := 0xb2
        }
        // vec 0 (0xb2), amount 1.
        case 1 {
            expected_left := 0x64
            expected_right := 0x59
        }
        // vec 0 (0xb2), amount 2.
        case 2 {
            expected_left := 0xc8
            expected_right := 0x2c
        }
        // vec 0 (0xb2), amount 3.
        case 3 {
            expected_left := 0x90
            expected_right := 0x16
        }
        // vec 1 (0xa5), amount 0.
        case 4 {
            expected_left := 0xa5
            expected_right := 0xa5
        }
        // vec 1 (0xa5), amount 1.
        case 5 {
            expected_left := 0x4a
            expected_right := 0x52
        }
        // vec 1 (0xa5), amount 2.
        case 6 {
            expected_left := 0x94
            expected_right := 0x29
        }
        // vec 1 (0xa5), amount 3.
        case 7 {
            expected_left := 0x28
            expected_right := 0x14
        }
    }
}
