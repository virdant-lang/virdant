// Self-checking `kind = "run"` test for the min/max pattern: two
// outputs (`lo` and `hi`) driven together by a statement-level `when`
// on the comparison of the operands.
//
//! A `MinMax` unit computes the minimum and maximum of `x` and `y`
//! combinationally.  A harness top drives it through a table of 13
//! vectors: both orders of asymmetric pairs, equal operands (including
//! 0 vs 0, 5 vs 5, and 255 vs 255), extremes at 0 and 255, and
//! adjacent values.  Both outputs are compared against golden values
//! and every check is ANDed into a running `all_ok`; the simulator
//! exits with code 0 only if all 13 vectors passed, and 1 otherwise.

import virt

//> Minimum and maximum of the operands, computed with a
//> statement-level `when` that drives both outputs under the same
//> condition.
mod MinMax {
    //> First operand.
    incoming x : Word[8]

    //> Second operand.
    incoming y : Word[8]

    //> Minimum of `x` and `y`: with equal operands, either order
    //> gives the same value.
    outgoing lo : Word[8] dependson x, y

    //> Maximum of `x` and `y`.
    outgoing hi : Word[8] dependson x, y

    if {
        when x <= y {
            lo := x
            hi := y
        }
        else {
            lo := y
            hi := x
        }
    }
}

pub mod MinMaxTest for virt::Virt {
    //> Primary clock.
    incoming clock : Clock

    //> `@Valid(0)` after the last vector checked out; `@Valid(1)` if
    //> any check failed.  While `@Invalid()`, the simulator keeps
    //> running.
    outgoing exit : Valid[Word[8]] {
        it := if {
            when finished => @Valid(mux(all_ok, 0, 1))
            else => @Invalid()
        }
    }

    mod mm of MinMax {
        it.x := vec_x
        it.y := vec_y
    }

    //> Index of the vector under test, 0 through 12.
    reg index : Word[4] on clock {
        initial it <= 0
        if {
            when !finished {
                it <= it + 1
            }
        }
    }

    //> Running AND of every check so far.  Power-on true; each cycle
    //> folds in the verdict for both outputs of the current vector.
    reg all_ok : Bit on clock {
        initial it <= true
        it <= it && mm.lo == expected_lo && mm.hi == expected_hi
    }

    //> Rises one cycle after the last vector is checked, so that the
    //> exit code sees the final `all_ok`.
    reg finished : Bit on clock {
        initial it <= false
        if {
            when index == 12 {
                it <= true
            }
        }
    }

    wire vec_x : Word[8]
    wire vec_y : Word[8]

    //> Test-vector table: `vec_x`, `vec_y`, and the golden `expected_lo`
    //> and `expected_hi` outputs, selected by `index`.  Indexes 13
    //> through 15 are unused; the `else` arm parks the operands where
    //> the check is harmless.
    wire expected_lo : Word[8]
    wire expected_hi : Word[8]

    match index {
        // Both orders of an asymmetric pair.
        with 0 {
            vec_x := 10
            vec_y := 3
            expected_lo := 3
            expected_hi := 10
        }
        with 1 {
            vec_x := 3
            vec_y := 10
            expected_lo := 3
            expected_hi := 10
        }
        // Equal operands: both outputs must equal the operand.
        with 2 {
            vec_x := 5
            vec_y := 5
            expected_lo := 5
            expected_hi := 5
        }
        with 3 {
            vec_x := 0
            vec_y := 0
            expected_lo := 0
            expected_hi := 0
        }
        with 4 {
            vec_x := 255
            vec_y := 255
            expected_lo := 255
            expected_hi := 255
        }
        // Extremes at 0 and 255, both orders.
        with 5 {
            vec_x := 0
            vec_y := 255
            expected_lo := 0
            expected_hi := 255
        }
        with 6 {
            vec_x := 255
            vec_y := 0
            expected_lo := 0
            expected_hi := 255
        }
        // Assorted asymmetric pairs, both orders.
        with 7 {
            vec_x := 200
            vec_y := 100
            expected_lo := 100
            expected_hi := 200
        }
        with 8 {
            vec_x := 100
            vec_y := 200
            expected_lo := 100
            expected_hi := 200
        }
        // Adjacent values.
        with 9 {
            vec_x := 128
            vec_y := 127
            expected_lo := 127
            expected_hi := 128
        }
        with 10 {
            vec_x := 1
            vec_y := 0
            expected_lo := 0
            expected_hi := 1
        }
        with 11 {
            vec_x := 255
            vec_y := 254
            expected_lo := 254
            expected_hi := 255
        }
        with 12 {
            vec_x := 42
            vec_y := 42
            expected_lo := 42
            expected_hi := 42
        }
        else {
            vec_x := 0
            vec_y := 0
            expected_lo := 0
            expected_hi := 0
        }
    }
}
