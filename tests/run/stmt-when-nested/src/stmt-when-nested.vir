//! Self-checking `kind = "run"` test for nested statement-level
//! control flow: a `when` inside a `when` inside a `match`, three deep.
//!
//! A `WhenNest` unit drives one output from a statement-level `match`
//! whose arm contains a statement-level `when`, one of whose arms
//! contains another statement-level `when`.  The harness walks four
//! vectors, one per path through the nesting, compares the output
//! against golden values, ANDs every verdict into a running `all_ok`,
//! and exits with code 0 only if all 4 paths passed, and 1 otherwise.

import virt

//> Statement-level `match` with a statement-level `when` inside an
//> arm, and a statement-level `when` inside that `when`: three levels
//> of nesting.  Every path through the nesting drives `r` with a
//> distinct code, so each path can be asserted separately:
//>
//> `op == 0`, `a` high, `b` high : inner `case b` arm : `r = 1`
//> `op == 0`, `a` high, `b` low  : inner `else` arm    : `r = 2`
//> `op == 0`, `a` low            : middle `else` arm   : `r = 3`
//> `op == 1`                     : outer `match` else  : `r = 4`
mod WhenNest {
    //> Outer `match` selector: 0 enters the nested `when`s, 1 takes
    //> the `match` `else` arm and ignores `a` and `b` entirely.
    incoming op : Word[1]

    //> Middle `when` condition: its arm contains the inner `when`.
    incoming a : Bit

    //> Inner `when` condition, nested inside the `case a` arm.
    incoming b : Bit

    //> Code identifying the path taken through the nesting: 1, 2, 3,
    //> or 4 as listed above.
    outgoing r : Word[3]

    match op {
        case 0 {
            when {
                case a {
                    when {
                        case b {
                            r := 1
                        }
                        else {
                            r := 2
                        }
                    }
                }
                else {
                    r := 3
                }
            }
        }
        else {
            r := 4
        }
    }
}

pub mod StmtWhenNestedTest for virt::Virt {
    //> Primary clock.
    incoming clock : Clock

    //> `@Valid(0)` after all 4 paths checked out; `@Valid(1)` if any
    //> check failed.  While `@Invalid()`, the simulator keeps running.
    outgoing exit : Valid[Word[8]] {
        it := when {
            case finished => @Valid(mux(all_ok, 0, 1))
            else => @Invalid()
        }
    }

    mod dut of WhenNest {
        it.op := op
        it.a := a
        it.b := b
    }

    //> Warm-up cycle counter: counts 0, 1, 2, 3 and then saturates.
    //> Checks only start once warm-up is over, so simulator start-up
    //> randomness on the first clock edge cannot leak into a verdict.
    reg warm : Word[2] on clock {
        initial it <= 0
        when {
            case it != 3 {
                it <= it + 1
            }
        }
    }

    //> Index of the vector under test, 0 through 3.  Advances only
    //> while checks are running, so vector 0 stays on the inputs
    //> during warm-up.
    reg index : Word[2] on clock {
        initial it <= 0
        when {
            case checking {
                it <= it + 1
            }
        }
    }

    //> Number of paths checked so far, 0 through 4.  Holds at 4 so
    //> that `finished` stays high.
    reg checked : Word[3] on clock {
        initial it <= 0
        when {
            case checking {
                it <= it + 1
            }
        }
    }

    //> Running AND of every check so far.  Power-on true; each check
    //> folds its verdict in on the cycle its vector is on the inputs.
    reg all_ok : Bit on clock {
        initial it <= true
        when {
            case checking {
                it <= it && dut.r == expected_r
            }
        }
    }

    //> High on every cycle where a path check is due: from the first
    //> cycle after warm-up through the fourth check.
    wire checking : Bit {
        it := warm == 3 && !finished
    }

    //> Rises once all 4 paths have been checked, so that the exit
    //> code sees the final `all_ok`.
    wire finished : Bit {
        it := checked == 4
    }

    //> Vector under test: outer `match` selector.
    wire op : Word[1]

    //> Vector under test: middle `when` condition.
    wire a : Bit

    //> Vector under test: inner `when` condition.
    wire b : Bit

    //> Golden path code for the vector under test.
    wire expected_r : Word[3]

    match index {
        case 0 {
            op := 0
            a := true
            b := true
            expected_r := 1
        }
        case 1 {
            op := 0
            a := true
            b := false
            expected_r := 2
        }
        case 2 {
            op := 0
            a := false
            b := true
            expected_r := 3
        }
        case 3 {
            op := 1
            a := true
            b := true
            expected_r := 4
        }
    }
}
