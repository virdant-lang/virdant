//! Self-checking `kind = "run"` test for a load-enable register.
//!
//! A `LoadEnable` register is written through the statement form
//! `when { case wr_en { it <= d } }`: the register loads `d` on the
//! clock edge when `wr_en` is high and holds its value when `wr_en`
//! is low.  A harness top walks a table of 16 stimulus steps -- idle
//! warm-up cycles, back-to-back loads, holds with deliberately
//! conflicting `d` values, a load of zero -- and checks `q` against a
//! golden value one cycle after every step from the first load on.
//! Each verdict is folded into a running `all_ok`; the simulator exits
//! with code 0 only if all 14 checks passed, and 1 otherwise.

import virt

//> Load-enable register: loads `d` while `wr_en` is high, holds
//> otherwise.
mod LoadEnable {
    //> Primary clock.
    incoming clock : Clock

    //> Write enable: when high, `d` is loaded on the next clock edge.
    incoming wr_en : Bit

    //> Data loaded on the next clock edge while `wr_en` is high;
    //> ignored while `wr_en` is low.
    incoming d : Word[8]

    //> Current register value.
    outgoing q : Word[8]

    reg value : Word[8] on clock {
        initial it <= 0
        when {
            case wr_en {
                it <= d
            }
        }
    }

    q := value
}

pub mod RegEnabledWriteTest for virt::Virt {
    //> Primary clock.
    incoming clock : Clock

    //> `@Valid(0)` after the last step checked out; `@Valid(1)` if
    //> any check failed.  While `@Invalid()`, the simulator keeps
    //> running.
    outgoing exit : Valid[Word[8]] {
        it := when {
            case finished => @Valid(mux(all_ok, 0, 1))
            else => @Invalid()
        }
    }

    mod dut of LoadEnable {
        it.clock := clock
        it.wr_en := wr_en
        it.d := d
    }

    //> Warm-up cycle counter: counts 0, 1, 2, 3 and then saturates.
    //> Checks only start once warm-up is over (and after the first
    //> load has re-established a known register value), so simulator
    //> start-up randomness cannot leak into a verdict.
    reg warm : Word[2] on clock {
        initial it <= 0
        when {
            case warm != 3 {
                it <= warm + 1
            }
        }
    }

    //> Index of the stimulus step currently being applied; free-runs
    //> through 0..15 and wraps.
    reg index : Word[4] on clock {
        initial it <= 0
        it <= it + 1
    }

    //> Lags `index` by one cycle: at any cycle after the first it
    //> holds the step applied the cycle before, selecting the golden
    //> `q` to check against.
    reg check_index : Word[4] on clock {
        initial it <= 0
        it <= index
    }

    //> Rises at the end of the final check (step 15), freezing the
    //> fold and validating `exit` on the next cycle.
    reg finished : Bit on clock {
        initial it <= false
        when {
            case checking && check_index == 15 {
                it <= true
            }
        }
    }

    //> Running AND of every check so far.  Power-on true; each check
    //> folds its verdict in on the cycle after its step is applied.
    reg all_ok : Bit on clock {
        initial it <= true
        when {
            case checking {
                it <= it && dut.q == expected
            }
        }
    }

    //> High on every cycle where a check is due: from the cycle after
    //> warm-up (the first post-load check) through the final check of
    //> step 15.
    wire checking : Bit {
        it := warm == 3 && !finished
    }

    wire wr_en : Bit
    wire d : Word[8]

    // Stimulus table: the write enable and data for each of the 16
    // steps, selected by `index`.  The 16 cases exactly cover
    // `Word[4]`, so the match is exhaustive.
    match index {
        // Idle warm-up cycles before any stimulus.
        case 0 {
            wr_en := false
            d := 0x00
        }
        case 1 {
            wr_en := false
            d := 0x00
        }
        // First load: re-establishes a known value whatever the
        // register happened to hold during warm-up.
        case 2 {
            wr_en := true
            d := 0xA5
        }
        // Back-to-back load: each edge loads the new data.
        case 3 {
            wr_en := true
            d := 0x5A
        }
        // Holds with conflicting data: `d` must be ignored while
        // `wr_en` is low.
        case 4 {
            wr_en := false
            d := 0xFF
        }
        case 5 {
            wr_en := false
            d := 0x01
        }
        case 6 {
            wr_en := true
            d := 0x3C
        }
        case 7 {
            wr_en := false
            d := 0xC3
        }
        // Loading zero is distinct from holding.
        case 8 {
            wr_en := true
            d := 0x00
        }
        case 9 {
            wr_en := false
            d := 0xFF
        }
        case 10 {
            wr_en := true
            d := 0x81
        }
        case 11 {
            wr_en := false
            d := 0x7E
        }
        case 12 {
            wr_en := false
            d := 0x00
        }
        case 13 {
            wr_en := true
            d := 0x42
        }
        case 14 {
            wr_en := false
            d := 0xBD
        }
        case 15 {
            wr_en := false
            d := 0x99
        }
    }

    wire expected : Word[8]

    // Golden values: `expected[i]` is the `q` the register must show
    // on the cycle after step `i` is applied.  Exhaustive over
    // `Word[4]`; cases 0 and 1 are warm-up holds and are never
    // checked (see `warm`).
    match check_index {
        case 0 {
            expected := 0x00
        }
        case 1 {
            expected := 0x00
        }
        case 2 {
            expected := 0xA5
        }
        case 3 {
            expected := 0x5A
        }
        case 4 {
            expected := 0x5A
        }
        case 5 {
            expected := 0x5A
        }
        case 6 {
            expected := 0x3C
        }
        case 7 {
            expected := 0x3C
        }
        case 8 {
            expected := 0x00
        }
        case 9 {
            expected := 0x00
        }
        case 10 {
            expected := 0x81
        }
        case 11 {
            expected := 0x81
        }
        case 12 {
            expected := 0x81
        }
        case 13 {
            expected := 0x42
        }
        case 14 {
            expected := 0x42
        }
        case 15 {
            expected := 0x42
        }
    }
}
