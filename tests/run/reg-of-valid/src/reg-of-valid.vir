//! Self-checking `kind = "run"` test for a register of `Valid[Word[8]]`.
//!
//! A `RegOfValid` unit holds `reg v : Valid[Word[8]]`: it is written
//! `@Valid(d)` while `en` is high, forced to `@Invalid()` while `clr`
//! is high, and holds its value otherwise.  A harness top walks a
//! table of 16 stimulus steps -- idle warm-up cycles, a clearing
//! write, `Valid` loads, holds, an `Invalid` write with conflicting
//! data, a zero payload (distinct from `Invalid`), and back-to-back
//! reloads -- and checks `q` against a golden `Valid[Word[8]]` one
//! cycle after every step from the warm-up flush on.  Each verdict is
//! folded into a running `all_ok`; the simulator exits with code 0
//! only if all 13 checks passed, and 1 otherwise.

import virt

//> Register of `Valid[Word[8]]`: loads `@Valid(d)` while `en` is
//> high, drops to `@Invalid()` while `clr` is high, and holds its
//> previous value (either variant, payload included) otherwise.
mod RegOfValid {
    //> Primary clock.
    incoming clock : Clock

    //> Load enable: when high, `v` is written `@Valid(d)` on the next
    //> clock edge.
    incoming en : Bit

    //> Invalidate: when high, `v` is written `@Invalid()` on the next
    //> clock edge.
    incoming clr : Bit

    //> Payload captured on the next clock edge while `en` is high;
    //> ignored otherwise.
    incoming d : Word[8]

    //> Current register value, `Valid` or `Invalid` with payload.
    outgoing q : Valid[Word[8]]

    reg v : Valid[Word[8]] on clock {
        initial it <= @Invalid()
        when {
            case en {
                it <= @Valid(d)
            }
            case clr {
                it <= @Invalid()
            }
        }
    }

    q := v
}

pub mod RegOfValidTest for virt::Virt {
    //> Primary clock.
    incoming clock : Clock

    //> `@Valid(0)` after the last step checked out; `@Valid(1)` if
    //> any check failed.  While `@Invalid()`, the simulator keeps
    //> running.
    outgoing exit : Valid[Word[8]] {
        it := when {
            case finished => @Valid(mux(all_ok, 0, 1))
            else => @Invalid()
        }
    }

    mod dut of RegOfValid {
        it.clock := clock
        it.en := en
        it.clr := clr
        it.d := d
    }

    //> Warm-up cycle counter: counts 0, 1, 2, 3 and then saturates.
    //> Checks only start once warm-up is over (and after the flush
    //> clearing write has re-established a known register value), so
    //> simulator start-up randomness cannot leak into a verdict.
    reg warm : Word[2] on clock {
        initial it <= 0
        when {
            case warm != 3 {
                it <= warm + 1
            }
        }
    }

    //> Index of the stimulus step currently being applied; free-runs
    //> through 0..15 and wraps.
    reg index : Word[4] on clock {
        initial it <= 0
        it <= it + 1
    }

    //> Lags `index` by one cycle: at any cycle after the first it
    //> holds the step applied the cycle before, selecting the golden
    //> `q` to check against.
    reg check_index : Word[4] on clock {
        initial it <= 0
        it <= index
    }

    //> Rises at the end of the final check (step 15), freezing the
    //> fold and validating `exit` on the next cycle.
    reg finished : Bit on clock {
        initial it <= false
        when {
            case checking && check_index == 15 {
                it <= true
            }
        }
    }

    //> Running AND of every check so far.  Power-on true; each check
    //> folds its verdict in on the cycle after its step is applied.
    reg all_ok : Bit on clock {
        initial it <= true
        when {
            case checking {
                it <= it && step_ok
            }
        }
    }

    //> High on every cycle where a check is due: from the cycle after
    //> warm-up (the first post-flush check) through the final check
    //> of step 15.
    wire checking : Bit {
        it := warm == 3 && !finished
    }

    wire en : Bit
    wire clr : Bit
    wire d : Word[8]

    // Stimulus table: the load enable, invalidate, and payload for
    // each of the 16 steps, selected by `index`.  The 16 cases
    // exactly cover `Word[4]`, so the match is exhaustive.
    match index {
        // Idle warm-up cycles before any stimulus.
        case 0 {
            en := false
            clr := false
            d := 0x00
        }
        case 1 {
            en := false
            clr := false
            d := 0x00
        }
        // Flush write: forces `@Invalid()` whatever the register
        // happened to hold during warm-up.
        case 2 {
            en := false
            clr := true
            d := 0x00
        }
        // First `Valid` load: the payload must come through.
        case 3 {
            en := true
            clr := false
            d := 0xA5
        }
        // Hold with neither enable: the value and payload are kept.
        case 4 {
            en := false
            clr := false
            d := 0xFF
        }
        // Force `@Invalid()` again: a transition back to `Invalid`.
        case 5 {
            en := false
            clr := true
            d := 0x5A
        }
        // Hold while `Invalid`: it stays `Invalid`.
        case 6 {
            en := false
            clr := false
            d := 0xC3
        }
        // Back-to-back `Valid` loads: each edge captures the new
        // payload.
        case 7 {
            en := true
            clr := false
            d := 0x3C
        }
        case 8 {
            en := true
            clr := false
            d := 0x5A
        }
        // Hold after back-to-back loads.
        case 9 {
            en := false
            clr := false
            d := 0xFF
        }
        // A zero payload is a `Valid` carrying `0x00`, distinct from
        // `@Invalid()`.
        case 10 {
            en := true
            clr := false
            d := 0x00
        }
        case 11 {
            en := false
            clr := false
            d := 0x01
        }
        // Conflicting inputs on an idle cycle must be ignored: `en`
        // low and `clr` low beats `d`.
        case 12 {
            en := false
            clr := true
            d := 0x7E
        }
        case 13 {
            en := false
            clr := false
            d := 0xBD
        }
        // Final `Valid` load.
        case 14 {
            en := true
            clr := false
            d := 0xFF
        }
        case 15 {
            en := false
            clr := false
            d := 0x99
        }
    }

    wire expected : Valid[Word[8]]

    // Golden values: `expected[i]` is the `q` the register must show
    // on the cycle after step `i` is applied.  Exhaustive over
    // `Word[4]`; cases 0 and 1 are warm-up holds and are never
    // checked (see `warm`).
    match check_index {
        case 0 {
            expected := @Invalid()
        }
        case 1 {
            expected := @Invalid()
        }
        case 2 {
            expected := @Invalid()
        }
        case 3 {
            expected := @Valid(0xA5)
        }
        case 4 {
            expected := @Valid(0xA5)
        }
        case 5 {
            expected := @Invalid()
        }
        case 6 {
            expected := @Invalid()
        }
        case 7 {
            expected := @Valid(0x3C)
        }
        case 8 {
            expected := @Valid(0x5A)
        }
        case 9 {
            expected := @Valid(0x5A)
        }
        case 10 {
            expected := @Valid(0x00)
        }
        case 11 {
            expected := @Valid(0x00)
        }
        case 12 {
            expected := @Invalid()
        }
        case 13 {
            expected := @Invalid()
        }
        case 14 {
            expected := @Valid(0xFF)
        }
        case 15 {
            expected := @Valid(0xFF)
        }
    }

    //> Verdict for the current check: `dut.q` must be the same
    //> variant as `expected`, and when both are `@Valid`, carry the
    //> same payload.
    wire step_ok : Bit {
        it := match dut.q {
            case @Valid(q_d) =>
                match expected {
                    case @Valid(e_d) => q_d == e_d
                    else => false
                }
            case @Invalid() =>
                match expected {
                    case @Invalid() => true
                    else => false
                }
        }
    }
}
