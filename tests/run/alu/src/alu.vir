//! Self-checking `kind = "run"` test for a tiny ALU.
//!
//! An `Alu` unit applies the operation selected by an `AluOp` enum
//! opcode to two `Word[8]` operands via `match`.  A harness top drives
//! it through a table of 16 vectors: wraparound adds and subtracts,
//! self-cancelling operands, zero operands, and bitwise patterns, two
//! cycles per vector (load, then check).  Each result is compared
//! against a golden value and every check is ANDed into a running
//! `all_ok`; the simulator exits with code 0 only if all 16 vectors
//! passed, and 1 otherwise.

import virt

//> Operation code selecting what the ALU does with `a` and `b`.
enum type AluOp {
    Add = 0w3
    Sub = 1w3
    And = 2w3
    Or  = 3w3
    Xor = 4w3
}

//> Tiny ALU: `opcode` selects the operation applied to `a` and `b`.
mod Alu {
    //> First operand.
    incoming a : Word[8]

    //> Second operand.
    incoming b : Word[8]

    //> Selects add, sub, and, or, or xor.
    incoming opcode : AluOp

    //> Result of the operation selected by `opcode`.
    outgoing result : Word[8] {
        it := match opcode {
            case #Add => a + b
            case #Sub => a - b
            case #And => a & b
            case #Or  => a | b
            case #Xor => a ^ b
        }
    }
}

pub mod AluTest for virt::Virt {
    //> Primary clock.
    incoming clock : Clock

    //> `@Valid(0)` after the last vector checked out; `@Valid(1)` if
    //> any check failed.  While `@Invalid()`, the simulator keeps
    //> running.
    outgoing exit : Valid[Word[8]] {
        it := when {
            case finished => @Valid(mux(all_ok, 0, 1))
            else => @Invalid()
        }
    }

    mod alu of Alu {
        it.a := va
        it.b := vb
        it.opcode := vop
    }

    //> High while the loaded vector is being checked.
    reg busy : Bit on clock {
        initial it <= false
        when {
            case finished {
                it <= false
            }
            else {
                it <= !it
            }
        }
    }

    //> Index of the vector under test, 0 through 15.  The 16 cases
    //> exactly cover `Word[4]`, so the vector table is exhaustive.
    reg index : Word[4] on clock {
        initial it <= 0
        when {
            case busy {
                it <= it + 1
            }
        }
    }

    //> First operand of the loaded vector.
    reg va : Word[8] on clock {
        initial it <= 0
        when {
            case loading {
                it <= table_a
            }
        }
    }

    //> Second operand of the loaded vector.
    reg vb : Word[8] on clock {
        initial it <= 0
        when {
            case loading {
                it <= table_b
            }
        }
    }

    //> Opcode of the loaded vector, driven into a register so that the
    //> enum flows through a reg before reaching the ALU.
    reg vop : AluOp on clock {
        initial it <= #Add
        when {
            case loading {
                it <= table_op
            }
        }
    }

    //> Golden result of the loaded vector.
    reg vexp : Word[8] on clock {
        initial it <= 0
        when {
            case loading {
                it <= table_expected
            }
        }
    }

    //> Running AND of every check so far.  Power-on true; each check
    //> folds its verdict in on the cycle the vector is checked.
    reg all_ok : Bit on clock {
        initial it <= true
        when {
            case busy {
                it <= it && alu.result == vexp
            }
        }
    }

    //> Rises one cycle after the last vector is checked, so that the
    //> exit code sees the final `all_ok`.
    reg finished : Bit on clock {
        initial it <= false
        when {
            case busy && index == 15 {
                it <= true
            }
        }
    }

    //> High on the cycle the next vector is loaded.
    wire loading : Bit {
        it := !busy
    }

    wire table_a : Word[8]
    wire table_b : Word[8]

    //> Test-vector table: `table_a`, `table_b`, the opcode
    //> `table_op`, and the golden `table_expected` result, selected by
    //> `index`.
    wire table_op : AluOp
    wire table_expected : Word[8]

    match index {
        // Addition, including modular wraparound.
        case 0 {
            table_a := 10
            table_b := 20
            table_op := #Add
            table_expected := 30
        }
        case 1 {
            table_a := 200
            table_b := 100
            table_op := #Add
            table_expected := 44
        }
        case 2 {
            table_a := 0
            table_b := 0
            table_op := #Add
            table_expected := 0
        }
        case 3 {
            table_a := 255
            table_b := 1
            table_op := #Add
            table_expected := 0
        }
        // Subtraction, including modular wraparound.
        case 4 {
            table_a := 50
            table_b := 30
            table_op := #Sub
            table_expected := 20
        }
        case 5 {
            table_a := 30
            table_b := 50
            table_op := #Sub
            table_expected := 236
        }
        case 6 {
            table_a := 7
            table_b := 7
            table_op := #Sub
            table_expected := 0
        }
        case 7 {
            table_a := 255
            table_b := 255
            table_op := #Sub
            table_expected := 0
        }
        // Bitwise AND, including a zero operand.
        case 8 {
            table_a := 0xF0
            table_b := 0x3C
            table_op := #And
            table_expected := 0x30
        }
        case 9 {
            table_a := 0xAA
            table_b := 0xFF
            table_op := #And
            table_expected := 0xAA
        }
        case 10 {
            table_a := 0
            table_b := 0xFF
            table_op := #And
            table_expected := 0
        }
        // Bitwise OR, including complementary and zero operands.
        case 11 {
            table_a := 0xF0
            table_b := 0x0F
            table_op := #Or
            table_expected := 0xFF
        }
        case 12 {
            table_a := 0xAA
            table_b := 0x55
            table_op := #Or
            table_expected := 0xFF
        }
        case 13 {
            table_a := 0
            table_b := 0
            table_op := #Or
            table_expected := 0
        }
        // Bitwise XOR, including self-cancelling operands.
        case 14 {
            table_a := 0xFF
            table_b := 0xFF
            table_op := #Xor
            table_expected := 0
        }
        case 15 {
            table_a := 0xAA
            table_b := 0x0F
            table_op := #Xor
            table_expected := 0xA5
        }
    }
}
