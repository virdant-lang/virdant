//! Self-checking `kind = "run"` test for slicing a struct's word
//! field: `p->addr[4..2]`.
//!
//! A `Point` struct is built with the canonical struct literal
//! (`${}`).  NOTE: the `vir run` interpreter currently panics while
//! lowering struct literals (`virdant/src/sim/expr.rs`: "expected
//! expression node, got \"Assign\""), and field-wise struct drivers
//! (`it.addr := ...`) are not supported by the checker ("Unresolved
//! component"), so there is no way to build a struct value in a run
//! test today.  The test is left in place in literal form so it
//! passes once the interpreter is fixed.
//!
//! The slice of the projected `addr` field is a `Word[2]` holding
//! bits 3 and 2 of `addr` -- the top slice index is exclusive.  The
//! fixed vector `0b00011000` separates the sliced bits (`1`, `0`)
//! from the retained bit 4 (`1`) and the neighboring field
//! (`data` = `0xff`), so the golden value `0b10` differs from what an
//! inclusive-top or bit-reversed reading -- or a slice of the wrong
//! field -- would produce.  Every check is ANDed into a running
//! `all_ok`; the simulator exits with code 0 only if all checks
//! passed, and 1 otherwise.

import virt

//> The struct type whose `addr` word field is sliced.
struct type Point {
    addr : Word[8]
    data : Word[8]
}

pub mod StructFieldSliceTest for virt::Virt {
    //> Primary clock.
    incoming clock : Clock

    //> `@Valid(0)` if every check passed; `@Valid(1)` if any check
    //> failed.  While `@Invalid()`, the simulator keeps running.
    outgoing exit : Valid[Word[8]] {
        it := if {
            when finished => @Valid(mux(all_ok, 0, 1))
            else => @Invalid()
        }
    }

    //> The struct value under test, built with the canonical struct
    //> literal (which the `vir run` interpreter currently cannot
    //> lower).  `addr` is `0b00011000`: bits 4 and 3 set, bit 2 clear.
    reg p : Point on clock {
        initial it <= ${
            addr = 0b00011000,
            data = 0xff,
        }
        it <= ${
            addr = 0b00011000,
            data = 0xff,
        }
    }

    //> The slice under test: `Word[2]`, bits 3..2 of `p->addr`
    //> (Verilog `addr[3:2]`).
    wire sliced : Word[2] {
        it := p->addr[4..2]
    }

    //> Golden value: bits 3..2 of `0b00011000` reassembled by hand.
    wire check_golden : Bit {
        it := sliced == 0b10
    }

    //> Per-bit identity: slice bit `i` must be the corresponding bit
    //> of `p->addr`, in order, with no reversal.
    wire check_perbit : Bit {
        it := sliced == word(p->addr[3], p->addr[2])
    }

    //> The slice must not have picked up the retained bit 4: an
    //> inclusive-top reading (Verilog `addr[4:2]`) would give the top
    //> two bits `0b11`, not `0b10`.
    wire check_not_retained : Bit {
        it := sliced != word(p->addr[4], p->addr[3])
    }

    //> The projections the slice rides on must be intact: the whole
    //> `addr` field is still `0b00011000`, and the neighboring field
    //> was not touched (so the slice cannot have come from `data`).
    wire check_fields : Bit {
        it := p->addr == 0b00011000 && p->data == 0xff
    }

    //> Running AND of every check so far.  Power-on true; each cycle
    //> folds in the verdicts.
    reg all_ok : Bit on clock {
        initial it <= true
        it <= it && check_golden && check_perbit && check_not_retained && check_fields
    }

    //> Cycle counter used to time the exit.
    reg count : Word[2] on clock {
        initial it <= 0
        it <= it + 1
    }

    //> Rises one cycle after the last cycle is checked, so that the
    //> exit code sees the final `all_ok`.
    reg finished : Bit on clock {
        initial it <= false
        if {
            when count == 2 {
                it <= true
            }
        }
    }
}
