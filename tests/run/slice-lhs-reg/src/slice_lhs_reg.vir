//! Self-checking `kind = "run"` test for partial register assignment
//! via a slice (slice read on the right-hand side of a register
//! driver).
//!
//! The register under test is an eight-bit `reg` whose driver writes
//! only one nibble per cycle: it holds the old opposite nibble
//! (`it[4..0]` or `it[8..4]`) on the right-hand side and reassembles
//! the full word with `word()`.  The harness walks a table of 10
//! stimulus steps -- two baseline writes that establish a known
//! 0xa5 register value (shielding any flaky first-edge simulator
//! state), then eight alternating high- and low-nibble merges -- and
//! checks the merged value one cycle after every merge step: the
//! written nibble must be updated and the unwritten nibble must be
//! preserved.  Each verdict is folded into a running `all_ok`; the
//! simulator exits with code 0 only if all 8 checks passed, and 1
//! otherwise.

import virt

//> Eight-bit register updated one nibble at a time.
//>
//> On the next clock edge, `nibble` replaces the high nibble
//> (`it[8..4]`) when `write_high` is high, or the low nibble
//> (`it[4..0]`) when low.  The other nibble is held by reading it
//> back on the right-hand side and reassembling with `word()`.
//> `hold` freezes the register.
mod NibbleReg {
    //> Primary clock.
    incoming clock : Clock

    //> When high, `nibble` replaces the high nibble; when low, the
    //> low nibble.
    incoming write_high : Bit

    //> New value for the selected nibble.
    incoming nibble : Word[4]

    //> When high, the register keeps its current value.
    incoming hold : Bit

    //> Current register value.
    outgoing value : Word[8]

    reg data : Word[8] on clock {
        initial it <= 0b10100101
        if {
            when hold {
                it <= it
            }
            when write_high {
                it <= word(nibble, it[4..0])
            }
            else {
                it <= word(it[8..4], nibble)
            }
        }
    }

    value := data
}

pub mod SliceLhsRegTest for virt::Virt {
    //> Primary clock.
    incoming clock : Clock

    //> `@Valid(0)` after the last step checked out; `@Valid(1)` if any
    //> check failed.  While `@Invalid()`, the simulator keeps running.
    outgoing exit : Valid[Word[8]] {
        it := if {
            when finished => @Valid(mux(all_ok, 0, 1))
            else => @Invalid()
        }
    }

    mod dut of NibbleReg {
        it.clock := clock
        it.write_high := write_high
        it.nibble := nibble
        it.hold := !active
    }

    // Warm-up cycle counter: counts 0, 1, 2, 3 and then saturates.
    // During warm-up `dut` is held, so any flaky first-edge simulator
    // state is flushed before stimulus begins.
    reg warm : Word[2] on clock {
        initial it <= 0
        if {
            when warm != 3 {
                it <= warm + 1
            }
        }
    }

    wire active : Bit {
        it := warm == 3
    }

    // Index of the stimulus step currently being applied; 0..9, then
    // sticks at 9.  Steps 0 and 1 write both nibbles in turn to
    // establish the 0xa5 baseline; steps 2..9 are the nibble merges
    // under test.
    reg index : Word[4] on clock {
        initial it <= 0
        if {
            when active && index != 9 {
                it <= it + 1
            }
        }
    }

    // Lags `index` by one cycle: on any cycle after the first
    // stimulus cycle it names the step whose result is now visible on
    // `dut.value`, selecting the golden merged value to check against.
    reg check_index : Word[4] on clock {
        initial it <= 0
        if {
            when active {
                it <= index
            }
        }
    }

    // Rises at the end of the final check (step 9), freezing the fold
    // and validating `exit` on the next cycle.
    reg finished : Bit on clock {
        initial it <= false
        if {
            when checking && check_index == 9 {
                it <= true
            }
        }
    }

    // Running AND of every check so far.  Power-on true; each check
    // folds its verdict in on the cycle after its step is applied.
    reg all_ok : Bit on clock {
        initial it <= true
        if {
            when checking {
                it <= it && dut.value == expected
            }
        }
    }

    // High on every cycle where a merge-step check is due: from the
    // cycle after the baseline writes (step 2) through the final
    // check of step 9.  The `check_index >= 2` guard keeps the two
    // baseline steps (which overwrite a possibly random initial
    // register value) out of the verdict.
    wire checking : Bit {
        it := active && check_index >= 2 && !finished
    }

    wire write_high : Bit
    wire nibble : Word[4]

    // Stimulus table: which nibble to write and what to write into
    // it.  Steps 0 and 1 write both nibbles in turn to establish the
    // known baseline 0xa5; steps 2..9 alternate high- and low-nibble
    // merges.
    match index {
        with 0 {
            write_high := true
            nibble := 0xA
        }
        with 1 {
            write_high := false
            nibble := 0x5
        }
        with 2 {
            write_high := true
            nibble := 0x3
        }
        with 3 {
            write_high := true
            nibble := 0xC
        }
        with 4 {
            write_high := false
            nibble := 0x9
        }
        with 5 {
            write_high := false
            nibble := 0x6
        }
        with 6 {
            write_high := true
            nibble := 0xF
        }
        with 7 {
            write_high := false
            nibble := 0x0
        }
        with 8 {
            write_high := true
            nibble := 0x0
        }
        with 9 {
            write_high := false
            nibble := 0x5
        }
        else {
            write_high := true
            nibble := 0x0
        }
    }

    wire expected : Word[8]

    // Golden merged values: `expected[i]` is `dut.value` on the cycle
    // after merge step `i`.  The unchecked indices (baseline steps
    // 0..1) are never read because `checking` requires
    // `check_index >= 2`.
    match check_index {
        with 0 {
            expected := 0
        }
        with 1 {
            expected := 0
        }
        with 2 {
            expected := 0x35
        }
        with 3 {
            expected := 0xC5
        }
        with 4 {
            expected := 0xC9
        }
        with 5 {
            expected := 0xC6
        }
        with 6 {
            expected := 0xF6
        }
        with 7 {
            expected := 0xF0
        }
        with 8 {
            expected := 0x00
        }
        with 9 {
            expected := 0x05
        }
        else {
            expected := 0
        }
    }
}
