// A `kind = "run"` test for the interaction between a register's
// `initial` value and its clocked driver: `initial it <= 5` with
// driver `it <= it + 1`.
//
// The race: after reset release, is the first value observed from the
// register the `initial` 5, or already the incremented 6?  The
// documented behavior (see docs/source/reference/statements.rst, "The
// Initial Statement": the `initial` value is what the register holds
// when the design starts up, and the `<=` driver takes over at clock
// edges) is that the register holds 5 from power-on until the first
// clock edge, and each edge then applies the driver once.  This test
// asserts that model consistently: a capture register sampling `race`
// at the first clock edge (which, like any register driver, sees the
// pre-edge value) observes 5, and later edges observe 6, 7, 8.  An
// implementation where the first edge's increment beat the `initial`
// value (first observation 6, 7, 8, 9) fails here.

import virt

pub mod Top for virt::Virt {
    //> Primary clock.
    incoming clock : Clock

    //> Register under test: powers on at 5 and increments once per
    //> clock edge.
    reg race : Word[8] on clock {
        initial it <= 5
        it <= it + 1
    }

    //> Counts settled clock edges, freezing at 4 once all four
    //> captures are done.
    reg stage : Word[3] on clock {
        initial it <= 0
        if {
            when stage < 4 {
                it <= stage + 1
            }
        }
    }

    //> Capture registers: each samples `race` on the clock edge that
    //> ends the cycle its `stage` guard selects.  A register driver
    //> sees the pre-edge value, so the captures read the observed
    //> sequence 5, 6, 7, 8 under the documented initial-vs-driver
    //> ordering.
    reg snap0 : Word[8] on clock {
        initial it <= 0
        if {
            when stage == 0 {
                it <= race
            }
        }
    }

    reg snap1 : Word[8] on clock {
        initial it <= 0
        if {
            when stage == 1 {
                it <= race
            }
        }
    }

    reg snap2 : Word[8] on clock {
        initial it <= 0
        if {
            when stage == 2 {
                it <= race
            }
        }
    }

    reg snap3 : Word[8] on clock {
        initial it <= 0
        if {
            when stage == 3 {
                it <= race
            }
        }
    }

    //> Verdict: all four captures match the documented sequence
    //> 5, 6, 7, 8.
    wire ok : Bit {
        it := snap0 == 5 && snap1 == 6 && snap2 == 7 && snap3 == 8
    }

    //> `@Valid(0)` once the four captures are in and match the
    //> documented ordering; `@Valid(1)` if the first observed value
    //> was not the `initial` 5.  While `@Invalid()`, the simulator
    //> keeps running.
    outgoing exit : Valid[Word[8]] {
        it := if {
            when stage == 4 => @Valid(mux(ok, 0, 1))
            else => @Invalid()
        }
    }
}
