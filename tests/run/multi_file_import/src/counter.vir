//! The `counter` package for the `multi-file-import` test: a
//! free-running 4-bit counter that wraps to 0 when it reaches `limit`.
//!
//! This module lives in its own `.vir` file (package `counter`) and is
//! imported by `multi_file_import.vir`, which instantiates it by its
//! qualified name `counter::Counter`.

//> Free-running 4-bit counter: counts 0, 1, ..., `limit`, then wraps
//> back to 0.
pub mod Counter {
    //> Primary clock.
    incoming clock : Clock

    //> Count at which the counter wraps back to 0.
    incoming limit : Word[4]

    //> Current count.
    outgoing count : Word[4]

    reg value : Word[4] {
        initial it <= 0
        it <= mux(it == limit, 0, it + 1)
    }

    count := value
}
