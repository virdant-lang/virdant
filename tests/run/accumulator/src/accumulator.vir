//! Self-checking `kind = "run"` test for an accumulator.
//!
//! An `Accumulator` maintains a running `Word[8]` sum of the value
//! presented each cycle, with a `clear` input that resets the sum to
//! zero on the next clock edge; the sum wraps modulo 256.  A harness
//! top walks a table of 16 stimulus steps -- ordinary adds, adds of
//! zero, a wrap past 255, exact-wrap boundary cases, and explicit
//! clears (including one that overrides a nonzero addend) -- and
//! checks the sum against a golden value one cycle after every step.
//! Each verdict is folded into a running `all_ok`; the simulator
//! exits with code 0 only if all 16 checks passed, and 1 otherwise.

import virt

//> Running sum of the values presented on `value`, cleared to zero
//> whenever `clear` is high.  The sum wraps modulo 256.
mod Accumulator {
    //> Primary clock.
    incoming clock : Clock

    //> When high, the sum becomes 0 on the next clock edge instead
    //> of accumulating `value`.
    incoming clear : Bit

    //> Addend sampled every cycle.
    incoming value : Word[8]

    //> Running sum, wrapping modulo 256.
    outgoing sum : Word[8]

    reg total : Word[8] on clock {
        initial it <= 0
        it <= when {
            case clear => 0
            else => it + value
        }
    }

    sum := total
}

pub mod AccumulatorTest for virt::Virt {
    //> Primary clock.
    incoming clock : Clock

    //> `@Valid(0)` after the last step checked out; `@Valid(1)` if
    //> any check failed.  While `@Invalid()`, the simulator keeps
    //> running.
    outgoing exit : Valid[Word[8]] {
        it := when {
            case finished => @Valid(mux(all_ok, 0, 1))
            else => @Invalid()
        }
    }

    mod acc of Accumulator {
        it.clock := clock
        it.clear := clear
        it.value := value
    }

    //> Index of the stimulus step currently being applied; free-runs
    //> through 0..15 and wraps.
    reg index : Word[4] on clock {
        initial it <= 0
        it <= it + 1
    }

    //> Lags `index` by one cycle: at any cycle after the first it
    //> holds the step applied the cycle before, selecting the golden
    //> sum to check against.
    reg check_index : Word[4] on clock {
        initial it <= 0
        it <= index
    }

    //> False only during cycle 0, before any stimulus has been
    //> applied and hence before any sum is meaningful.
    reg started : Bit on clock {
        initial it <= false
        it <= true
    }

    //> Rises at the end of the final check (step 15), freezing the
    //> fold and validating `exit` on the next cycle.
    reg finished : Bit on clock {
        initial it <= false
        when {
            case checking && check_index == 15 {
                it <= true
            }
        }
    }

    //> Running AND of every check so far.  Power-on true; each check
    //> folds its verdict in on the cycle after its step is applied.
    reg all_ok : Bit on clock {
        initial it <= true
        when {
            case checking {
                it <= it && acc.sum == expected
            }
        }
    }

    //> High on every cycle where a check is due: every cycle after
    //> the first, up to and including the final check of step 15.
    wire checking : Bit {
        it := started && !finished
    }

    wire clear : Bit
    wire value : Word[8]

    // Stimulus table: the addend `value` and the `clear` pulse for
    // each of the 16 steps, selected by `index`.  The 16 cases
    // exactly cover `Word[4]`, so the match is exhaustive.
    match index {
        // Ordinary running adds.
        case 0 {
            value := 100
            clear := false
        }
        case 1 {
            value := 55
            clear := false
        }
        // 155 + 200 = 355 wraps to 99.
        case 2 {
            value := 200
            clear := false
        }
        case 3 {
            value := 1
            clear := false
        }
        // Adding zero holds the sum.
        case 4 {
            value := 0
            clear := false
        }
        // 100 + 156 = 256 wraps exactly to 0.
        case 5 {
            value := 156
            clear := false
        }
        case 6 {
            value := 7
            clear := false
        }
        // Explicit clear back to zero.
        case 7 {
            value := 42
            clear := true
        }
        // 128 + 128 = 256 wraps exactly to 0.
        case 8 {
            value := 128
            clear := false
        }
        case 9 {
            value := 128
            clear := false
        }
        // 0 + 255 = 255, then 255 + 1 wraps to 0.
        case 10 {
            value := 255
            clear := false
        }
        case 11 {
            value := 1
            clear := false
        }
        case 12 {
            value := 3
            clear := false
        }
        // Clear overrides a nonzero addend.
        case 13 {
            value := 10
            clear := true
        }
        // 250 + 6 = 256 wraps exactly to 0.
        case 14 {
            value := 250
            clear := false
        }
        case 15 {
            value := 6
            clear := false
        }
    }

    wire expected : Word[8]

    // Golden sums: `expected[i]` is the accumulator's sum on the
    // cycle after step `i` is applied.  Exhaustive over `Word[4]`.
    match check_index {
        case 0 {
            expected := 100
        }
        case 1 {
            expected := 155
        }
        case 2 {
            expected := 99
        }
        case 3 {
            expected := 100
        }
        case 4 {
            expected := 100
        }
        case 5 {
            expected := 0
        }
        case 6 {
            expected := 7
        }
        case 7 {
            expected := 0
        }
        case 8 {
            expected := 128
        }
        case 9 {
            expected := 0
        }
        case 10 {
            expected := 255
        }
        case 11 {
            expected := 0
        }
        case 12 {
            expected := 3
        }
        case 13 {
            expected := 0
        }
        case 14 {
            expected := 250
        }
        case 15 {
            expected := 0
        }
    }
}
