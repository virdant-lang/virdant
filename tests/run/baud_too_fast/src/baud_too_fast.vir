//! Error test for `vir run`'s baud validation: `[virt].baud`
//! exceeds half the platform's 1 MHz clock, so `vir run` must exit 1
//! with the baud-too-fast error before the simulator starts.  The
//! design itself is an ordinary 10-cycles-per-bit transmitter.
//!
//! The bit period is 10 clock cycles: exactly 100000 baud at the
//! platform's 1 MHz clock.

import virt

//> State machine of the transmitter, one state per UART bit.
//>
//> `Idle` - the line idles high, waiting to send.
//> `Start(pulse)` - sending the start bit, `pulse` cycles to go.
//> `Data(bit, pulse)` - sending data bit `bit` (LSB first), `pulse`
//> cycles to go.
//> `Stop(pulse)` - sending the stop bit, `pulse` cycles to go.
union type TxState {
    Idle()
    Start(pulse : Word[4])
    Data(bit : Word[3], pulse : Word[4])
    Stop(pulse : Word[4])
}

pub mod BaudTooFast for virt::Virt {
    //> Primary clock.
    incoming clock : Clock

    //> UART transmit data to the host (stdout).
    outgoing tx : Bit {
        it := tx_level
    }

    //> `@Valid(0)` once the whole message has been sent.
    outgoing exit : Valid[Word[8]] {
        it := if {
            when sent_all => @Valid(0)
            else => @Invalid()
        }
    }

    //> Serializes the message onto the `tx` line, one byte at a time,
    //> back-to-back: the next start bit begins as soon as the stop
    //> bit ends.  The first start bit falls within a few cycles of
    //> power-up -- there is deliberately no boot quiet period.
    reg state : TxState {
        initial it <= @Idle()
        it <= match it : TxState {
            with @Idle() if {
                when !sent_all => @Start(9)
                else => @Idle()
            }
            with @Start(pulse) if {
                when pulse == 0 => @Data(0, 9)
                else => @Start(pulse - 1)
            }
            with @Data(bit, pulse) if {
                when pulse > 0 => @Data(bit, pulse - 1)
                when bit == 7 => @Stop(9)
                else => @Data(bit + 1, 9)
            }
            with @Stop(pulse) if {
                when pulse == 0 && char_index == 0 => @Start(9)
                when pulse == 0 => @Idle()
                else => @Stop(pulse - 1)
            }
        }
    }

    //> Index of the byte being sent: 0 = 'H', 1 = 'i'.  Advances on
    //> the last cycle of each byte's stop bit.
    reg char_index : Word[1] {
        initial it <= 0
        if {
            when byte_end && it == 0 {
                it <= 1
            }
        }
    }

    //> True on the final cycle of a byte's stop bit.
    wire byte_end : Bit {
        it := match state : TxState {
            with @Stop(pulse) => pulse == 0
            else => false
        }
    }

    //> Message bytes: "Hi".
    wire char : Word[8] {
        it := match char_index : Word[1] {
            with 0 => 0x48 // 'H'
            with 1 => 0x69 // 'i'
        }
    }

    //> True once both bytes have been sent.
    wire sent_all : Bit {
        it := match state : TxState {
            with @Idle() => char_index == 1
            else => false
        }
    }

    //> The line level for the current state: low start bit, eight
    //> data bits LSB first (from the current message byte, which is
    //> stable for the whole byte), high stop bit, and high while
    //> idle.
    wire tx_level : Bit {
        it := match state : TxState {
            with @Idle() => true
            with @Start(pulse) => false
            with @Data(bit, pulse) => char[dyn bit]
            with @Stop(pulse) => true
        }
    }
}
