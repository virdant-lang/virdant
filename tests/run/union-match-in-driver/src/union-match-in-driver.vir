//! Self-checking `kind = "run"` test for `it <= match state { ... }` on
//! a union-typed register: the FSM transition idiom with direct
//! chaining.
//!
//! The FSM register's driver is an expression-level `match` whose arms
//! chain directly into nested `when` blocks (`case @Idle() when { ... }`)
//! instead of writing an `=>` before the nested block.  The machine
//! walks `@Idle()` -> `@Load()` -> `@Run(0)` -> `@Run(1)` -> `@Run(2)`
//! -> `@Run(3)` -> `@Done()` and holds there.  After a power-on warm-up
//! (cycles 0 through 2 are unchecked, so any first-edge garbage has
//! settled), the harness asserts the exact state at every cycle of the
//! walk via an independently computed expected code, and the simulator
//! exits with code 0 only if every step of the walk checked out, and 1
//! otherwise.

import virt

//> States of the walk.
//>
//> `Idle` - power-on state, held until the warm-up ends.
//> `Load` - one-cycle handoff into the run phase.
//> `Run(n)` - counting `n` from 0 through 3.
//> `Done` - terminal state reached after `Run(3)`.
union type FsmState {
    Idle()
    Load()
    Run(n : Word[2])
    Done()
}

pub mod UnionMatchInDriverTest for virt::Virt {
    //> Primary clock.
    incoming clock : Clock

    //> `@Valid(0)` after the whole walk checked out; `@Valid(1)` if
    //> any step diverged from the expected walk.  While `@Invalid()`,
    //> the simulator keeps running.
    outgoing exit : Valid[Word[8]] {
        it := if {
            when finished => @Valid(mux(all_ok, 0, 1))
            else => @Invalid()
        }
    }

    //> Union-typed FSM register whose next value is computed by
    //> `it <= match state { ... }` with direct chaining: the arms
    //> whose bodies are nested `when` blocks attach the block straight
    //> onto the arm, with no `=>` in between.
    reg state : FsmState on clock {
        initial it <= @Idle()
        it <= match state {
            with @Idle() if {
                when step == 3 => @Load()
                else => @Idle()
            }
            with @Load() => @Run(0w2)
            with @Run(n) if {
                when n == 3w2 => @Done()
                else => @Run(n + 1)
            }
            with @Done() => @Done()
        }
    }

    //> Cycle index of the walk, 0 through 12.  Cycles 0 through 2 are
    //> idle warm-up: the FSM holds `@Idle()` and no checks run.
    reg step : Word[4] on clock {
        initial it <= 0w4
        if {
            when step < 12 {
                it <= it + 1
            }
        }
    }

    //> Running AND of every check so far.  Power-on true; each checked
    //> cycle folds its verdict in on the clock edge.
    reg all_ok : Bit on clock {
        initial it <= true
        it <= it && walk_ok
    }

    //> Rises on the clock edge after the last checked cycle, so that
    //> the exit code sees the final `all_ok`.
    reg finished : Bit on clock {
        initial it <= false
        if {
            when step == 11 {
                it <= true
            }
        }
    }

    //> Checks run only after the power-on warm-up (cycles 0 through 2)
    //> and stop once `finished` rises.
    wire checking : Bit {
        it := step >= 3 && !finished
    }

    //> Compact code for the current state, so the harness can compare
    //> against a golden schedule with `==`.  The `@Run(n)` arm itself
    //> chains directly into a nested `when` block, exercising the same
    //> no-`=>` idiom in a second position.
    wire state_code : Word[4] {
        it := match state {
            with @Idle() => 0w4
            with @Load() => 1w4
            with @Run(n) if {
                when n == 0w2 => 2w4
                when n == 1w2 => 3w4
                when n == 2w2 => 4w4
                else => 5w4
            }
            with @Done() => 6w4
        }
    }

    //> Golden schedule of the walk, computed independently from
    //> `step`: `@Idle` at cycle 3, `@Load` at cycle 4, `@Run(0..3)` at
    //> cycles 5 through 8, and `@Done` from cycle 9 onward.
    wire expected_code : Word[4] {
        it := match step : Word[4] {
            with 3 => 0w4
            with 4 => 1w4
            with 5 => 2w4
            with 6 => 3w4
            with 7 => 4w4
            with 8 => 5w4
            else => 6w4
        }
    }

    //> The full state walk: on every checked cycle the FSM must show
    //> exactly the scheduled state, which forces it through every
    //> variant and every transition of the walk in order.
    wire walk_ok : Bit {
        it := !checking || state_code == expected_code
    }
}
