//! Self-checking `kind = "run"` test for inline `match` expressions as
//! `word()` arguments: `word(match a { ... }, match b { ... })`.
//!
//! Two scrutinees (`a : Word[2]`, `b : Word[2]`) are matched directly
//! inside a `word()` call, with no intermediate wire: the first match
//! yields a `Word[3]`, the second a `Word[2]`, so the concatenation
//! pins both the most-significant-first argument order and the mixed
//! result widths.  The same two matches are also concatenated in
//! reverse order to distinguish the two layouts, and each match result
//! is asserted individually so a failure localizes to the match or to
//! the assembly.  Verdicts are ANDed into a `fail_bits` bitmask; the
//! simulator exits with code 0 only if every check passed, and with
//! the bitmask (nonzero) otherwise.

import virt

pub mod WordOfMatchesTest for virt::Virt {
    //> Primary clock.
    incoming clock : Clock

    //> Scrutinees for the inline matches below.
    wire a : Word[2] {
        it := 2w2
    }
    wire b : Word[2] {
        it := 1w2
    }

    //> Match results asserted on their own, for diagnostics: `a = 2`
    //> selects `0b110` and `b = 1` selects `0b10`.
    wire sel_a : Word[3] {
        it := match a : Word[2] {
            with 0 => 0b000
            with 1 => 0b001
            with 2 => 0b110
            with 3 => 0b111
        }
    }
    wire sel_b : Word[2] {
        it := match b : Word[2] {
            with 0 => 0b00
            with 1 => 0b10
            with 2 => 0b11
            with 3 => 0b01
        }
    }

    //> Faithful form, exactly as in the feature bullet: inline
    //> `match` expressions as `word()` arguments, most-significant
    //> first: `word(match a { ... }, match b { ... })`.  With `a = 2`
    //> and `b = 1` the arguments are `0b110` and `0b10`, so the
    //> assembled `Word[5]` is `0b11010` (= 26).
    wire assembled : Word[5] {
        it := word(match a : Word[2] {
                with 0 => 0b000
                with 1 => 0b001
                with 2 => 0b110
                with 3 => 0b111
            },
            match b : Word[2] {
                with 0 => 0b00
                with 1 => 0b10
                with 2 => 0b11
                with 3 => 0b01
            })
    }

    //> The same two matches concatenated in reverse order: `0b10`,
    //> `0b110` assemble to `0b10110` (= 22), a value that would be
    //> impossible under the wrong argument order.
    wire assembled_reversed : Word[5] {
        it := word(match b : Word[2] {
                with 0 => 0b00
                with 1 => 0b10
                with 2 => 0b11
                with 3 => 0b01
            },
            match a : Word[2] {
                with 0 => 0b000
                with 1 => 0b001
                with 2 => 0b110
                with 3 => 0b111
            })
    }

    //> Diagnostic bitmask: bit0 = individual `match` on `a` wrong;
    //> bit1 = individual `match` on `b` wrong; bit2 = forward
    //> assembly wrong; bit3 = reverse assembly wrong.
    wire fail_bits : Word[8] {
        it := word(0w4,
            sel_a != 0b110,
            sel_b != 0b10,
            assembled != 0b11010,
            assembled_reversed != 0b10110)
    }

    //> `@Valid(0)` when every check passed; `@Valid(fail_bits)`
    //> otherwise.  While `@Invalid()`, the simulator keeps running.
    outgoing exit : Valid[Word[8]] {
        it := if {
            when fail_bits == 0 => @Valid(0)
            else => @Valid(fail_bits)
        }
    }
}
