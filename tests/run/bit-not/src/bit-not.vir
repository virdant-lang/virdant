//! Self-checking `kind = "run"` test for bitwise not on `Bit`.
//!
//! `!x` applied to wires carrying both constant vectors (`true` and
//! `false`, exhausting the `Bit` domain) must produce the opposite
//! value, and the two negations must be mutual inverses of each other.
//! Each check is folded into a running `all_ok`; the simulator exits
//! with code 0 only if every check passed, and 1 otherwise.

import virt

pub mod BitNot for virt::Virt {
    //> Primary clock.
    incoming clock : Clock

    //> `@Valid(0)` when every negation check passed; `@Valid(1)` if
    //> any check failed.  While `@Invalid()`, the simulator keeps
    //> running.
    outgoing exit : Valid[Word[8]] {
        it := when {
            case finished => @Valid(mux(all_ok, 0, 1))
            else => @Invalid()
        }
    }

    //> Wire vector under test: the constant `true`.
    wire x_true : Bit {
        it := true
    }

    //> Wire vector under test: the constant `false`.
    wire x_false : Bit {
        it := false
    }

    //> `!true` must be `false`.
    wire ok_not_true : Bit {
        it := !x_true == false
    }

    //> `!false` must be `true`.
    wire ok_not_false : Bit {
        it := !x_false == true
    }

    //> Cross-check: the two vectors must negate to each other, so a
    //> broken `!` that collapsed both vectors to one value would fail.
    wire ok_cross : Bit {
        it := !x_true == x_false && !x_false == x_true
    }

    //> Running AND of every check so far.  Power-on true; the check
    //> verdicts fold in on the first clock edge.
    reg all_ok : Bit on clock {
        initial it <= true
        it <= it && ok_not_true && ok_not_false && ok_cross
    }

    //> Rises on the first clock edge, so that `exit` never observes
    //> the vacuous power-on `all_ok`.
    reg finished : Bit on clock {
        initial it <= false
        it <= true
    }
}
