// Tests that binary operators are inferrable from either operand:
// if both operands are inferrable they must be compatible, and if
// only one is, the other is checked against it.

// CHECK: Check OK

pub mod AddInferFromRhs {
    incoming a : Word[4]
    outgoing out : Word[4] {
        // Only the RHS is inferrable; the LHS literal is checked
        // against Word[4].
        it := 4w4 + a
    }
}

pub mod AddInferFromLhs {
    incoming a : Word[4]
    outgoing out : Word[4] {
        // Only the LHS is inferrable; the RHS literal is checked
        // against Word[4].
        it := a + 4w4
    }
}

pub mod AddInferBoth {
    incoming a : Word[4]
    incoming b : Word[4]
    outgoing out : Word[4] {
        // Both operands are inferrable and compatible.
        it := a + b
    }
}

pub mod SubInferFromRhs {
    incoming a : Word[4]
    outgoing out : Word[4] {
        // Only the RHS is inferrable; the LHS literal is checked
        // against Word[4].
        it := 12 - a
    }
}

pub mod CmpInferFromRhs {
    incoming a : Word[4]
    outgoing out : Bit {
        // Only the RHS is inferrable; the LHS literal is checked
        // against Word[4].  The result is always Bit.
        it := 0 < a
    }
}

pub mod CmpInferFromLhs {
    incoming a : Word[4]
    outgoing out : Bit {
        it := a > 0
    }
}

pub mod CmpInferBoth {
    incoming a : Word[4]
    incoming b : Word[4]
    outgoing out : Bit {
        it := a == b
    }
}

// `Bit` and `Reset` are mutually compatible operands.
pub mod BitResetOperands {
    incoming r : Reset
    outgoing out : Bit {
        it := r | true
    }
}
