// Regression test: an expression-position `let` as a `match`/`if`
// arm body used to abort `vir check` with a native stack overflow.
// Typing the untyped binding's RHS queried the expected type at the
// binding's first use; when that use is a ctor payload, the query
// re-entered the `Typing` result of the very expression being built,
// recursing forever.  The ctor's expected type is now derived from
// syntax alone.
//
// CHECK: Check OK

pub union type St {
    Idle()
    Step(value : Word[8])
    Done(result : Word[8])
}

//> An untyped `let` in a `match` arm body, whose first use is a ctor
//> payload, in a match driving a reg.
pub mod LetInMatchArm {
    incoming clock : Clock

    reg value : Word[8] {
        initial it <= 0
        it <= it + 1
    }

    reg state : St {
        initial it <= @Idle()
        it <= match it : St {
            with @Idle() =>
                let result = value + 1 if {
                    when value == 255 => @Done(result)
                    else => @Step(result)
                }
            with @Step(result) =>
                let done = result == value if {
                    when done => @Done(result)
                    else => @Step(result)
                }
            with @Done(result) => @Done(result)
        }
    }

    outgoing out : St {
        it := state
    }
}

//> A width-less literal binding whose only use is a ctor payload: the
//> binding's width must flow from the ctor signature's parameter type.
pub mod LetWidthlessLiteral {
    incoming clock : Clock

    reg state : St {
        initial it <= @Idle()
        it <= match it : St {
            with @Idle() =>
                let seeded = 0 if {
                    when true => @Step(seeded)
                    else => @Idle()
                }
            with @Step(seeded) => @Step(seeded)
            with @Done(result) => @Done(result)
        }
    }

    outgoing out : Word[8] {
        it := 0
    }
}

//> The same chained form with an `if` arm body instead of `match`.
pub mod LetInWhenArm {
    incoming clock : Clock

    reg flag : Bit {
        initial it <= false
        it <= if {
            when true =>
                let all = true if {
                    when it => true
                    else => false
                }
            else => false
        }
    }

    outgoing out : Bit {
        it := flag
    }
}
