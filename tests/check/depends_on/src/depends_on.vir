// Test: `dependson` lists on external and internal modules.
//
// `dependson` declares the combinational dependencies a port *may*
// have on the module's `incoming` ports.

// CHECK: Check OK

// External PLL: the internal verilog routes clk_in to clk_out.
// The `dependson` list declares that clk_out may depend on clk_in.
ext mod PLL {
    incoming clk_in  : Clock
    outgoing clk_out : Clock dependson clk_in
}

// External mux with several declared dependencies.
pub ext mod ExternalMux {
    incoming sel     : Bit
    incoming a       : Bit
    incoming b       : Bit
    outgoing result  : Bit dependson sel, a, b
}

// Internal module: `dependson` on an outgoing wire documents the
// dependency chain without needing the full expression.
mod Internal {
    incoming clk : Clock
    incoming inp  : Word[8] on clk

    // reg stores the input value.
    reg stored : Word[8]
    stored <= inp

    // outgoing wire reads only the register (a clock edge in
    // between), so it needs no `dependson` list.
    outgoing out_val : Word[8] on clk {
        it := stored
    }
}

// Top module instantiates everything and wires it up.
pub mod Top {
    incoming clk      : Clock
    incoming inp      : Word[8] on clk
    outgoing final_out : Word[8] on clk

    // Instantiate the PLL
    mod pll of PLL
    pll.clk_in := clk
    unused pll.clk_out

    // Instantiate and wire the internal module.
    mod internal of Internal
    internal.clk := clk
    internal.inp := inp

    final_out := internal.out_val
}
