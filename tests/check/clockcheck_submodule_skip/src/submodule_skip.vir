// Modules containing submodule instances are clock-checked: the
// submodule clock binding maps the child's internal clock domains onto
// the parent's driven clock, so the parent's drivers across the
// boundary are checked normally.
pub mod Top {
    incoming clock : Clock
    outgoing out : Bit

    mod inner of Inner {
        it.clock := clock
    }

    out := inner.out
}

mod Inner {
    incoming clock : Clock
    reg counter : Word[4] {
        initial it <= 0
        it <= it + 1w4
    }
    outgoing out : Bit {
        it := counter[0]
    }
}

// CHECK-NOT: ERROR
// CHECK-NOT: WARNING
// CHECK: Check OK
