// CHECK: Check OK
pub mod When {
    incoming clock : Clock
    incoming inp1 : Bit

    outgoing out1 : Bit dependson inp1 {
        when {
            case inp1 {
                it := true
            }
            else {
                it := false
            }
        }
    }

    reg r : Bit {
        when {
            case inp1 {
                it <= true
            }
        }

        unused it
    }

    incoming inp2 : Bit

    outgoing out2 : Bit dependson inp2 {
        it := when {
            case inp2 => false
            else => true
        }
    }
}

pub mod Fine {
    incoming clock : Clock
    incoming reset : Reset
    outgoing out : Word[3]

    reg start : Word[3] {
        it <= when {
            case reset => 0
            else => it
        }
    }
    out := start
}
