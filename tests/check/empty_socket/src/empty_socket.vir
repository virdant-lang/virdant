// A socket def with no channels is legal.  Connecting two empty socket
// instances with `:=:` must not report "Unknown component" — there are
// simply no channels to route (and none can go missing, since the
// socketdefs agree).

socket Empty {
}

mod Left {
    forward socket peer of Empty
}

mod Right {
    reverse socket peer of Empty
}

pub mod Top {
    mod left of Left
    mod right of Right

    left.peer :=: right.peer
}

// CHECK: PASSED with
// CHECK-NOT: ERROR
// CHECK-NOT: WARNING
// CHECK: Check OK
