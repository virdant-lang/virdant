// CHECK: Check OK
// Ensure that references in if/match guard expressions are
// properly tracked as "used", so no false "Unused signal" warnings.
//
// Test 1: submodule port reference in a when guard inside a match arm
mod SubMod {
    outgoing flag : Bit {
        it := true
    }
}

pub mod TestSubmoduleWhen {
    incoming clock : Clock
    incoming sel : Word[2]

    mod sub of SubMod

    outgoing r_out : Word[2]
    reg r : Word[2] {
        match sel {
            with 0w2 {
                it <= 0w2
            }
            with 1w2 if {
                when sub.flag {
                    it <= 2w2
                }
                else {
                    it <= 3w2
                }
            }
        }
    }
    r_out := r
}

// Test 2: direct signal reference in a when guard inside a match arm
pub mod TestMatchWhen {
    incoming clock : Clock
    incoming stage : Word[2]
    incoming flag : Bit

    reg r : Word[2] {
        match stage {
            with 0w2 {
                it <= 0w2
            }
            with 1w2 if {
                when flag {
                    it <= 2w2
                }
                else {
                    it <= 3w2
                }
            }
        }
        unused it
    }
}
