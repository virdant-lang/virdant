pub mod Top {
    incoming clock : Clock
    incoming reset : Bit
    incoming go : Bit

    reg pulse : Word[4] on clock {
        let expire = it == 0w4 {
            it <= if {
                when reset => 0w4
                when go && expire => 417w4
                when !go && expire => 417w4
                when go => it - 1
                else => it
            }
        }
    }

    outgoing out : Bit {
        it := pulse != 0w4
    }
}
