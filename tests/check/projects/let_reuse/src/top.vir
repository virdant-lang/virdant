pub mod Top {
    incoming clock : Clock
    incoming reset : Bit
    incoming go : Bit

    reg pulse : Word[4] on clock {
        let expire = it == 0w4 {
            it <= when {
                case reset => 0w4
                case go && expire => 417w4
                case !go && expire => 417w4
                case go => it - 1
                else => it
            }
        }
    }

    outgoing out : Bit {
        it := pulse != 0w4
    }
}
