// CHECK: Check OK

//> Test that annotations can be parsed on various items and slots.
//> Only names Virdant knows may be used here — unknown annotation
//> names are errors (see tests/errors/annotations/unknown).  Exotic
//> arg syntax (multi-arg with trailing commas, empty parens, bare
//> flags, boolean literals) is exercised on known names.
@parameter("fpga", "ice40")
@parameter("part", "up5k-sg48")
pub mod Top {
    @pin(35)
    @period_ns("83.33")
    incoming clock : Clock {
        unused it
    }

    @pin("E3")
    incoming data : Bit

    @parameter("keep")
    outgoing result : Bit dependson data

    result := data
}

//> Struct with annotations
@parameter("author", "Alice")
pub struct type Point {
    @parameter("range", 0)
    x : Word[16]

    @parameter("range", 1)
    y : Word[16]
}

@parameter("deprecated")
pub union type Result {
    @parameter("success")
    Ok(value : Word[32])

    @parameter("error")
    Err(code : Word[8])
}

@parameter("experimental")
pub enum type State {
    @parameter("init")
    Idle = 0w2

    // Multi-arg with boolean literal arguments
    @parameter("active", true, false)
    Running = 1w2

    @parameter("done")
    Complete = 2w2
}

@parameter("chip", "ice40")
pub socket SpiSocket {
    @parameter("master")
    cosi data_out : Bit

    @parameter("slave")
    soci data_in : Bit
}

// Multi-arg annotation with trailing comma

//> Module exercising annotation arg syntax
@parameter("multi_arg", 1, 2, 3,)
// Empty parens
@parameter()
// Bare annotation (no parens)
@parameter
pub mod AnnotationsTest {
    // Multi-arg on a port
    @parameter("attr", "a", "b", 42,)
    // Empty parens on a port
    @parameter()
    // Bare on a port
    @parameter
    // Boolean literals as annotation arguments
    @parameter("active", true)
    @parameter("active", false)
    incoming test_port : Bit

    unused test_port
}
