// A module with zero incoming clock ports — no `incoming ... : Clock`,
// no inward socket channel typed `Clock` — has no clock any component
// could be `Sync` on.  The full coloring is skipped, but every
// component must then be explicitly `async` (the one exception: a
// Clock-typed component, which is always `Async` anyway).

socket ClkBus {
    cosi clk : Clock
}

pub mod ZeroClock {
    incoming inp : Bit async

    wire tapped : Bit async {
        it := inp
    }

    outgoing out : Bit async dependson inp {
        it := tapped
    }
}

// `link.clk` is an *outward* clock channel (the client drives `cosi`):
// `ClockOut` hands a clock along but receives none, so it still has
// zero incoming clock ports.
pub mod ClockOut {
    client socket link of ClkBus {
        it.clk := asclock(true)
    }
}

