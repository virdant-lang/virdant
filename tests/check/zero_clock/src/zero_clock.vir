// A module with zero incoming clock ports — no `incoming ... : Clock`,
// no inward socket channel typed `Clock` — has no clocks to provide to
// any `on` clause, and checks with no clock bookkeeping at all.
//
// TODO(clock-coloring): once the clock checker lands (item 4), the
// inputs here must be declared `async`; the `async` modifier is
// currently behind the not-yet-implemented gate.

// CHECK: Check OK

socket ClkBus {
    cosi clk : Clock
}

pub mod ZeroClock {
    incoming inp : Bit

    wire tapped : Bit {
        it := inp
    }

    outgoing out : Bit dependson inp {
        it := tapped
    }
}

// `link.clk` is an *outward* clock channel (the client drives `cosi`):
// `ClockOut` hands a clock along but receives none, so it still has
// zero incoming clock ports.
pub mod ClockOut {
    client socket link of ClkBus {
        it.clk := asclock(true)
    }
}
