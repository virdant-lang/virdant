// Positive tests for `let` terminator style: statement-form lets and
// chained let-if/let-match bodies in statement position must pass
// the terminator-style pass.  (Expression-position lets are blocked on
// the typing and driver-analysis passes gaining `let` support, so only
// statement forms are exercised here.)
//
// Note: references inside a `let` are not yet wired into the typing
// pass (let bodies produce no expr roots), so every component
// referenced inside a `let` is also referenced by a driver below, and
// let bodies are empty to avoid missing-driver diagnostics.
// CHECK: Check OK

pub mod StmtLet {
    incoming a : Word[8]
    outgoing out : Word[8] dependson a

    let x = a {
    }

    out := a
}

pub mod StmtLetWhen {
    incoming a : Bit
    incoming b : Word[8]
    outgoing out : Word[8] dependson b
    outgoing flag : Bit dependson a

    let x = b if {
        when a {
        }
        else {
        }
    }

    out := b
    flag := a
}

pub mod StmtLetMatch {
    incoming a : Word[8]
    incoming t : StyleE
    outgoing out : Word[8] dependson a
    outgoing echo : StyleE dependson t

    let x = a match t {
        with #A {
        }
        else {
        }
    }

    out := a
    echo := t
}

pub mod StmtWhenArmLet {
    incoming a : Bit
    incoming b : Word[8]
    outgoing out : Word[8] dependson b

    if {
        when a let x = b {
        }

        else {
        }
    }

    out := b
}

pub enum type StyleE {
    A
    B
}
