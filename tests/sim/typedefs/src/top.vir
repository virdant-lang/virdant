enum type Opcode {
    Add = 1w4
    Sub = 2
    And = 4
    Or  = 8
}

struct type Color {
    red : Word[8]
    green : Word[8]
    blue : Word[8]
}

pub mod Top {
    incoming opcode_bits : Word[4] async
    incoming x : Word[8] async
    incoming y : Word[8] async

    outgoing out : Word[8] async dependson opcode_bits, x, y
    outgoing red : Word[8] async dependson x

    wire color : Color async

    wire opcode : Opcode async
    opcode := cast(opcode_bits)

    out := match opcode {
        with #Add => x + y
        with #Sub => x - y
        with #And => x & y
        with #Or  => x | y
    }

    color := ${
        red=x,
        green=128,
        blue=255,
    }

    red := color->green

    // Field projections in infer-only positions (binop operands):
    // `->` must be inferable, not just checkable.
    outgoing inferred : Word[8] async dependson x
    inferred := color->red + color->green
}
