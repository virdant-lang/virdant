mod Fifo {
    incoming clock : Clock
    incoming reset : Reset

    server socket inp of Pipe[Word[8]] {
        it.ready := match out_data {
            with @Valid(dontcare) => true
            with @Invalid() => !is_full
        }

        if {
            when inp_fires {
                match it.data {
                    with @Valid(in_data) match write[2..0] {
                        with 0 {
                            slot0 <= in_data
                        }
                        with 1 {
                            slot1 <= in_data
                        }
                        with 2 {
                            slot2 <= in_data
                        }
                        with 3 {
                            slot3 <= in_data
                        }
                    }
                }
            }
        }
    }

    client socket out of Pipe[Word[8]] {
        it.data := out_data
    }

    wire out_data : Valid[Word[8]] {
        it := if {
            when is_empty match inp.data {
                with @Valid(data) => @Valid(data)
                with @Invalid() => @Invalid()
            }
            else match read[2..0] {
                with 0 => @Valid(slot0)
                with 1 => @Valid(slot1)
                with 2 => @Valid(slot2)
                with 3 => @Valid(slot3)
            }
        }
    }

    reg slot0 : Word[8]
    reg slot1 : Word[8]
    reg slot2 : Word[8]
    reg slot3 : Word[8]

    wire is_full : Bit {
        it := read_is_write && different_lap
    }

    wire is_empty : Bit {
        it := read_is_write && !different_lap
    }

    wire different_lap : Bit {
        it := read[2] ^^ write[2]
    }

    wire read_is_write : Bit {
        it := read[2..0] == write[2..0]
    }

    wire out_fires : Bit {
        it := match out_data {
            with @Valid(dontcare) => out.ready
            with @Invalid() => false
        }
    }

    wire inp_fires : Bit {
        it := match inp.data {
            with @Valid(dontcare) => !is_full || out_fires
            with @Invalid() => false
        }
    }

    reg read : Word[3] {
        if {
            when reset {
                it <= 0
            }
            when out_fires {
                it <= it + 1
            }
        }
    }

    reg write : Word[3] {
        if {
            when reset {
                it <= 0
            }
            when inp_fires {
                it <= it + 1
            }
        }
    }
}
