union type State {
    Idle()
    Running(x : Word[8], y : Word[8])
    Done(result : Word[8])
}

pub mod Top {
    incoming clock : Clock
    incoming reset : Bit

    incoming x : Word[8]
    incoming y : Word[8]
    incoming fire : Bit

    outgoing result : Word[8]
    outgoing valid  : Bit

    mod gcd of Gcd {
        it.reset := reset
        it.clock := clock
        it.x := x
        it.y := y
        it.fire := fire
        result := it.result
        valid := it.valid
    }
}

mod Gcd {
    incoming clock : Clock
    incoming reset : Bit
    incoming x : Word[8]
    incoming y : Word[8]
    incoming fire : Bit
    outgoing result : Word[8]
    outgoing valid: Bit

    reg state : State {
        if {
            when reset {
                it <= @Idle()
            }
            else {
                it <= match it : State {
                    with @Idle() => mux(fire, @Running(x, y), @Idle())
                    with @Running(x, y) =>
                        mux(y == 0, @Done(x),
                        mux(x < y, @Running(y - x, x),
                        @Running(x - y, y)))
                    with @Done(result) => @Idle()
                }
            }
        }
    }

    match state {
        with @Done(r) {
            result := r
            valid := true
        }
        else {
            result := 0
            valid := false
        }
    }
}
