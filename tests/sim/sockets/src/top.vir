mod Top {
    mod core of Core
    mod memsrv of Memory

    memsrv.mem :=: core.mem
}

mod Core {
    forward socket mem of Mem {
        it.addr := 8
        unused it.data
    }
}

mod Memory {
    reverse socket mem of Mem {
        it.data := 10
    }
    unused mem.addr
}

socket Mem {
    outgoing addr : Word[16]
    incoming data : Word[8]
}
