enum type State {
    On  = 1w2
    Off = 2w2
}

pub mod Top {
    incoming clock : Clock
    incoming reset : Bit

    outgoing out : Bit

    reg state : State
    if {
        when reset {
            state <= #Off
        }
        when state == #Off {
            state <= #On
        }
        else {
            state <= #Off
        }
    }

    match state {
        with #On {
            out := true
        }
        with #Off {
            out := false
        }
    }

    reg r : Bit
    unused r

    if {
        when reset {
            r <= true
        }
        else {
            match #Off : State {
                with #On {
                    r <= false
                }
            }
        }
    }
}
