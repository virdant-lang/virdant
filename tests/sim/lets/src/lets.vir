// Icarus simulation test for the `let` statement feature, covering the
// same corner cases as `tests/run/lets`: untyped and typed bindings,
// multi-binding lists where later bindings see earlier ones, nested
// lets, `let` as the body of `if`/`match` arms, shadowing in
// sibling arms, and the expression-position `let` form
// (`let x = e => body` as an expression).  Each case drives a wire
// the testbench asserts on.

pub mod Top {
    incoming clock : Clock
    incoming reset : Reset

    unused clock
    unused reset

    // Untyped binding, inferred from its use.
    wire a : Bit
    let x = 0w1 {
        a := x == 0
    }

    // Multi-binding list: later bindings see earlier ones.
    wire b : Bit
    let x = 1w2,
        y = 2w2 {
            b := x + y == 3
    }

    // Typed binding mixed with an untyped one.
    wire c : Bit
    let x = 1 : Word[2],
        y = 2w2 {
            c := x + y == 3
    }

    // `let` as a match-arm body: binding scoped to the arm.
    wire d : Bit {
        match @Valid(0) : Valid[Word[8]] {
            with @Invalid() {
                it := false
            }
            with @Valid(value) let x = 10w8 {
                it := x == 10
            }
        }
    }

    // A let binding shadowing the pattern-bound variable.
    wire e : Bit {
        match @Valid(2) : Valid[Word[8]] {
            with @Invalid() {
                it := false
            }
            with @Valid(value) let value = 3w8 {
                // The let shadows the pattern's `value`; this checks
                // the shadowed (let-bound) value, not the pattern one.
                it := value == 3
            }
        }
    }

    // Nested lets: an inner let inside an outer let's body.
    wire f : Bit
    let p = 1w2 {
        let q = 2w2 {
            f := p + q == 3
        }
    }

    // Expression-position `let`: the `let x = e => body` form used as
    // an expression, here the RHS of a driver.  Regression test for a
    // `vir build` panic ("unsupported expr in conversion: Let"): the
    // Verilog converter must reduce the let to its body and
    // beta-reduce references to the binding.
    wire g : Word[8] {
        it := let y = 1w8 => y + y
    }

    outgoing done : Bit {
        it := a && b && c && d && e && f && (g == 2w8)
    }
}
