// Minimal repro of the riscv SoC socket-wiring bug.
// Two submodules connected with `:=:` inside an instantiation block.
socket Bus {
    cosi req : Word[8]
    soci rsp : Word[8]
}

mod Master {
    client socket busif of Bus {
        it.req := 7w8
        unused it.rsp
    }
}

mod Slave {
    server socket busif of Bus {
        it.rsp := it.req + 1w8
    }
}

pub mod Top {
    mod m of Master
    mod s of Slave {
        m.busif :=: it.busif
    }
    outgoing out : Word[8] {
        it := s.busif.rsp
    }
}
