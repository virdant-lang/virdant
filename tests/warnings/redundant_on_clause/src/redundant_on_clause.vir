// RedundantOnClause: when a module declares exactly one Clock-typed
// component, an explicit `on` clause naming that clock is redundant
// (it is equivalent to omitting it) and warns.

mod RedundantOn {
    incoming clock : Clock
    incoming inp : Word[8]
    outgoing out : Word[8]

    // Explicit `on` clause naming the module's unique clock.
    reg r : Word[8] on clock
    // CHECK: Redundant `on` clause: `r`
    r <= inp

    // Outgoing regs are covered by the same rule.
    outgoing reg oreg : Bit on clock {
        // CHECK: Redundant `on` clause: `oreg`
        it <= inp[0]
    }

    out := r
    unused oreg
}

// Every other component kind may carry an `on` clause in the grammar,
// but only `reg`/`outgoing reg` are clocked by it: on any other kind
// the clause is inert, so naming the module's unique clock there is
// redundant too.
mod RedundantOnOtherKinds {
    incoming clock : Clock
    incoming inp : Word[8] on clock
    // CHECK: Redundant `on` clause: `inp`

    wire internal : Word[8] on clock
    // CHECK: Redundant `on` clause: `internal`
    outgoing out : Word[8] dependson inp on clock
    // CHECK: Redundant `on` clause: `out`
    outgoing wire out_wire : Word[8] dependson inp on clock
    // CHECK: Redundant `on` clause: `out_wire`

    internal := inp
    out_wire := internal
    out := out_wire
}

// An `on` clause referencing a submodule's clock output is not
// redundant: the module's unique clock cannot clock it implicitly.
mod ClockDiv {
    incoming clock_inp : Clock
    outgoing clock_out : Clock dependson clock_inp {
        it := clock_inp
    }
}

mod OtherClock {
    incoming clock : Clock

    mod divider of ClockDiv {
        it.clock_inp := clock
    }

    // Names a different clock: no warning.
    reg r : Bit on divider.clock_out {
        it <= !it
    }
}

// Two Clock-typed components: no implicit clock, so explicit `on`
// clauses are required and never warn.
mod TwoClocks {
    incoming clock_a : Clock
    incoming clock_b : Clock

    reg ra : Bit on clock_a {
        it <= !it
    }

    reg rb : Bit on clock_b {
        it <= !it
    }
}

// CHECK: Check OK
