// Tests for the NotIt warning: using the component name instead of
// 'it' inside a driver block.
// All cases here are warnings only, so the run ends with "Check OK".

mod HalfAdder {
    incoming a : Bit
    incoming b : Bit

    outgoing sum : Bit dependson a, b
    outgoing carry_out : Bit dependson a, b

    sum := a ^^ b
    carry_out := a && b
}

// Using the submodule's own name as a driver target (LHS) inside its
// it block should warn.
mod SubmoduleLhs {
    incoming a : Bit
    incoming b : Bit
    outgoing sum : Bit dependson a, b
    outgoing carry_out : Bit dependson a, b

    mod ha of HalfAdder {
        // CHECK: 'ha' should be written as 'it' inside of this driver block
        ha.a := a
        // CHECK: 'ha' should be written as 'it' inside of this driver block
        ha.b := b
    }
    sum := ha.sum
    carry_out := ha.carry_out
}

// Using a reg's own name as a driver target (LHS) inside its it block
// should warn.
mod RegLhs {
    incoming clk : Clock
    outgoing out : Word[8]

    reg counter : Word[8] on clk {
        // CHECK: 'counter' should be written as 'it' inside of this driver block
        counter <= 0w8
    }
    out := counter
}

// Using a reg's own name in an expression (RHS) inside its it block
// should warn.
mod RegRhs {
    incoming clk : Clock
    outgoing out : Word[8]

    reg counter : Word[8] on clk {
        // CHECK: 'counter' should be written as 'it' inside of this driver block
        it <= counter + 1
    }
    out := counter
}

// Both LHS and RHS in the same statement each produce a warning.
mod RegBothSides {
    incoming clk : Clock
    outgoing out : Word[8]

    reg counter : Word[8] on clk {
        // CHECK: 'counter' should be written as 'it' inside of this driver block
        // CHECK: 'counter' should be written as 'it' inside of this driver block
        counter <= counter + 1
    }
    out := counter
}

// Correct use of 'it' in both target and expression produces no warning.
mod CorrectReg {
    incoming clk : Clock
    outgoing out : Word[8]

    reg counter : Word[8] on clk {
        // CHECK-NOT: 'counter' should be written as 'it'
        it <= 0
    }
    out := counter
}

// Correct use of 'it.' in a submodule it block produces no warning.
mod CorrectSubmodule {
    incoming a : Bit
    incoming b : Bit
    outgoing sum : Bit dependson a, b
    outgoing carry_out : Bit dependson a, b

    mod ha of HalfAdder {
        // CHECK-NOT: 'ha' should be written as 'it'
        it.a := a
        it.b := b
    }
    sum := ha.sum
    carry_out := ha.carry_out
}

// Correct use of 'it.' in a submodule it block produces no warning.
mod IncorrectSimpleComponentLhs {
    outgoing out : Bit {
        // CHECK: 'out' should be written as 'it'
        out := true
    }
}

// Using a submodule's own name in an 'unused' statement inside its
// it block should warn.
mod UnusedStmt {
    incoming a : Bit
    incoming b : Bit
    outgoing sum : Bit dependson a, b

    mod ha of HalfAdder {
        it.a := a
        it.b := b
        // CHECK: 'ha' should be written as 'it' inside of this driver block
        unused ha.carry_out
    }
    sum := ha.sum
}

// Correct 'unused it.foo' inside an it block should produce no warning.
mod CorrectUnused {
    incoming a : Bit
    incoming b : Bit
    outgoing sum : Bit dependson a, b

    mod ha of HalfAdder {
        it.a := a
        it.b := b
        // CHECK-NOT: 'ha' should be written as 'it'
        unused it.carry_out
    }
    sum := ha.sum
}

// Using a reg's own name in a `when` guard inside its own it block
// should warn.  The guard is an expression context just like a driver
// RHS.
mod RegWhenGuard {
    incoming clk : Clock
    outgoing out : Word[8]

    reg counter : Word[8] {
        initial it <= 0
        if {
            // CHECK: 'counter' should be written as 'it' inside of this driver block
            when counter == 5 {
                it <= 0
            }
            // CHECK-NOT: 'counter' should be written as 'it'
            else {
                it <= it + 1
            }
        }
    }
    out := counter
}

// Using a reg's own name as a `match` subject inside its own it block
// should warn.
mod RegMatchSubject {
    incoming clk : Clock
    outgoing out : Word[8]

    reg counter : Word[8] {
        initial it <= 0
        // CHECK: 'counter' should be written as 'it' inside of this driver block
        match counter {
            with 0w8 {
                it <= 0
            }
            // CHECK-NOT: 'counter' should be written as 'it'
            else {
                it <= it + 1
            }
        }
    }
    out := counter
}

// Using a reg's own name in the RHS of a `let` binding inside its own
// it block should warn.  The binding's RHS is evaluated in the
// enclosing it context (and the binding name does not shadow the
// component there).
mod RegLetRhs {
    incoming clk : Clock
    outgoing out : Word[8]

    reg counter : Word[8] {
        initial it <= 0
        // CHECK: 'counter' should be written as 'it' inside of this driver block
        let x = counter + 1 {
            it <= x
        }
    }
    out := counter
}

// A `let` RHS that reads the component through `it` produces no
// warning, and neither does a let inside a `when` arm.
mod CorrectLet {
    incoming clk : Clock
    outgoing out : Word[8]

    reg counter : Word[8] {
        initial it <= 0
        if {
            // CHECK-NOT: 'counter' should be written as 'it'
            when it == 5 {
                let x = it + 1 {
                    it <= x
                }
            }
            else {
                it <= it + 1
            }
        }
    }
    out := counter
}

// CHECK: Check OK
