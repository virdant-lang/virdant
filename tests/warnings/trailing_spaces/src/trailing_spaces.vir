// CHECK-NOT: Check failed

mod HalfAdder {
    incoming a : Bit   
    incoming b : Bit

    outgoing sum : Bit dependson a, b   
    outgoing carry : Bit dependson a, b

    sum := a ^^ b
    carry := a && b   
}