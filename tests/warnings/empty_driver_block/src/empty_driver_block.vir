// Tests for empty driver blocks: components whose it-blocks contain
// no drivers.
// Each empty driver block should produce a warning.
// (Submodule and socket cases are planned new tests; see TESTING_REPORT.)

pub mod ComponentModule {
    incoming a : Bit {
        b := it
    }

    // CHECK: Empty driver block
    outgoing b : Bit dependson a {
    }
}

// CHECK: PASSED with
// CHECK-NOT: ERROR
// CHECK: 1 WARNING
// CHECK: Check OK
