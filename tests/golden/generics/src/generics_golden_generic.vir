pub struct type Pair[A : Type, B : Type] {
    fst : A
    snd : B
}

pub enum type Opt[T : Type] {
    None
    Some(value : T)
}

pub union type Either[L : Type, R : Type] {
    Left(l : L)
    Right(r : R)
}

pub mod Top {
    incoming clock : Clock
    incoming a : Word[4]
    incoming b : Bit

    reg pair : Pair[Word[4], Bit] on clock {
        it <= ${
            fst = a,
            snd = b,
        }
    }

    wire opt : Opt[Word[4]]
    opt := match b {
        with true => @Some(a)
        with false => #None
    }

    wire either : Either[Word[4], Bit]
    either := @Left(a)

    outgoing o_fst : Word[4]
    outgoing o_opt : Word[5] dependson a, b
    outgoing o_either : Word[5] dependson a
    o_fst := pair->fst
    o_opt := match opt {
        with @Some(w) => zext(w)
        with #None => 0
    }
    o_either := match either {
        with @Left(w) => zext(w)
        with @Right(x) => zext(word(false, x))
    }
}
