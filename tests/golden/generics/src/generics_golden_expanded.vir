pub struct type Pair {
    fst : Word[4]
    snd : Bit
}

pub enum type Opt {
    None
    Some(value : Word[4])
}

pub union type Either {
    Left(l : Word[4])
    Right(r : Bit)
}

pub mod Top {
    incoming clock : Clock
    incoming a : Word[4]
    incoming b : Bit

    reg pair : Pair on clock {
        it <= ${
            fst = a,
            snd = b,
        }
    }

    wire opt : Opt
    opt := match b {
        with true => @Some(a)
        with false => #None
    }

    wire either : Either
    either := @Left(a)

    outgoing o_fst : Word[4]
    outgoing o_opt : Word[5] dependson a, b
    outgoing o_either : Word[5] dependson a
    o_fst := pair->fst
    o_opt := match opt {
        with @Some(w) => zext(w)
        with #None => 0
    }
    o_either := match either {
        with @Left(w) => zext(w)
        with @Right(x) => zext(word(false, x))
    }
}
