//> Test that annotations can be parsed on various items and slots

// CHECK: Check OK

@fpga("ice40")
@part("up5k-sg48")
mod Top {
    @pin(35)
    @period_ns("83.33")
    incoming clock : Clock {
        unused it
    }

    @pin("E3")
    incoming data : Bit

    @keep
    outgoing result : Bit

    result := data
}

//> Struct with annotations
@author("Alice")
struct type Point {
    @range(0)
    x : Word[16]

    @range(1)
    y : Word[16]
}

@deprecated
union type Result {
    @success
    Ok(value : Word[32])

    @error
    Err(code : Word[8])
}

@experimental
enum type State {
    @initial
    Idle = 0w2

    @active(true, false)
    Running = 1w2

    @done
    Complete = 2w2
}

@chip("ice40")
socket SpiSocket {
    @master
    cosi data_out : Bit

    @slave
    soci data_in : Bit
}

//> Module exercising new annotation arg syntax

// Multi-arg annotation with trailing comma
@multi_arg(1, 2, 3,)
// Empty parens
@empty()
// Bare annotation (no parens)
@bare
mod AnnotationsTest {
    // Multi-arg on a port
    @attr("a", "b", 42,)
    // Empty parens on a port
    @flag()
    // Bare on a port
    @simple
    // Boolean literals as annotation arguments
    @active(true)
    @active(false)
    incoming test_port : Bit

    unused test_port
}
