enum type Opcode {
    Add = 1w4
    Sub = 2
    And = 4
    Or  = 8
}

struct type Color {
    red : Word[8]
    green : Word[8]
    blue : Word[8]
}

pub mod Top {
    incoming opcode_bits : Word[4]
    incoming x : Word[8]
    incoming y : Word[8]

    outgoing out : Word[8]
    outgoing red : Word[8]

    wire color : Color

    wire opcode : Opcode
    opcode := cast(opcode_bits)

    out := match opcode {
        case #Add => x + y
        case #Sub => x - y
        case #And => x & y
        case #Or  => x | y
    }

    color := ${
        red = x,
        green = 128,
        blue = 255,
    }

    red := color->green

    // Field projections in infer-only positions (binop operands):
    // `->` must be inferable, not just checkable.
    outgoing inferred : Word[8]
    inferred := color->red + color->green
}
