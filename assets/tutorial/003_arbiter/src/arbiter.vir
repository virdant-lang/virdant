pub mod Arbiter {
    incoming clock   : Clock
    incoming reset   : Reset

    incoming req0   : Bit
    incoming req1   : Bit

    outgoing grant0 : Bit dependson reset, req0, req1
    outgoing grant1 : Bit dependson reset, req0, req1

    reg client0_priority : Bit {
        it <= if {
            when reset => true
            else => !it
        }
    }

    if {
        when reset {
            grant0 := false
            grant1 := false
        }
        when client0_priority {
            grant0 := req0
            grant1 := req1 && !req0
        }
        else {
            grant0 := req0 && !req1
            grant1 := req1
        }
    }
}
