mod Mux2 {
    incoming a : Word[8]
    incoming b : Word[8]

    incoming select : Bit

    outgoing out : Word[8] dependson a, b, select {
        it := mux(select, a, b)
    }
}

mod Mux3 {
    incoming a : Word[8]
    incoming b : Word[8]
    incoming c : Word[8]

    incoming select_a : Bit
    incoming select_b : Bit
    incoming select_c : Bit

    outgoing out : Word[8] dependson a, b, c, select_a, select_b, select_c {
        it := when {
            case select_a => a
            case select_b => b
            case select_c => c
            else => 0
        }
    }
}

mod Mux4 {
    incoming a : Word[8]
    incoming b : Word[8]
    incoming c : Word[8]
    incoming d : Word[8]

    incoming select : Word[2]

    outgoing out : Word[8] dependson a, b, c, d, select {
        it := match select {
            case 0 => a
            case 1 => b
            case 2 => c
            case 3 => d
        }
    }
}
