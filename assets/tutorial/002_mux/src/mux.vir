pub mod Mux2 {
    incoming a : Word[8]
    incoming b : Word[8]

    incoming select : Bit

    outgoing out : Word[8] dependson a, b, select {
        it := mux(select, a, b)
    }
}

pub mod Mux3 {
    incoming a : Word[8]
    incoming b : Word[8]
    incoming c : Word[8]

    incoming select_a : Bit
    incoming select_b : Bit
    incoming select_c : Bit

    outgoing out : Word[8] dependson a, b, c, select_a, select_b, select_c {
        it := if {
            when select_a => a
            when select_b => b
            when select_c => c
            else => 0
        }
    }
}

pub mod Mux4 {
    incoming a : Word[8]
    incoming b : Word[8]
    incoming c : Word[8]
    incoming d : Word[8]

    incoming select : Word[2]

    outgoing out : Word[8] dependson a, b, c, d, select {
        it := match select {
            with 0 => a
            with 1 => b
            with 2 => c
            with 3 => d
        }
    }
}
